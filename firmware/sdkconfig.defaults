# ---- Board flash / PSRAM ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# ---- CPU ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# ---- Console / logs ----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- Partitions ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Networking ----
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_ESP_WIFI_ENABLED=y
# Spotify/clima passam pelo dc-os-core em HTTP local; o backend e que fala com
# APIs externas por TLS. Evita depender de CA bundle no firmware.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_ESP_TLS_USE_DS_PERIPHERAL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_DATA=y
# Bluetooth no ESP32-S3 e BLE-only; Bluedroid fica desligado porque
# esp-idf-svc 0.52.1 referencia simbolos GATT que nao existem nos
# bindings gerados pelo ESP-IDF 5.2.3 usado neste projeto.
CONFIG_BT_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096

# ---- Task stacks ----
# main: aumentado do valor por omissão do ESP-IDF (3584 bytes — insuficiente
# de longe) para 32 KB. A task `main` (esp-idf-svc binstart) corre toda a
# inicialização (Wi-Fi, NVS) e o loop de eventos/renderer de software do
# Slint na mesma stack, o que excede em muito o orçamento pensado para um
# app_main() "fino" que só spawna outras tasks. Nota: este valor só tem
# efeito com [package.metadata.esp-idf-sys] definido no Cargo.toml a
# apontar para este ficheiro — caso contrário o esp-idf-sys ignora-o
# silenciosamente e usa os defaults do Kconfig (foi o que aconteceu antes
# desta correção, causando "stack overflow in task main").
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_ESP_TIMER_TASK_STACK_SIZE=8192
