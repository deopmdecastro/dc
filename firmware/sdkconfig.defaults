# ---- Board flash / PSRAM ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# ---- CPU ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# ---- Console / logs ----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- Partitions ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Networking ----
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y

# ---- Task stacks ----
# main: aumentado do valor por omissão do ESP-IDF (3584 bytes — insuficiente
# de longe) para 32 KB. A task `main` (esp-idf-svc binstart) corre toda a
# inicialização (Wi-Fi, NVS) e o loop de eventos/renderer de software do
# Slint na mesma stack, o que excede em muito o orçamento pensado para um
# app_main() "fino" que só spawna outras tasks. Nota: este valor só tem
# efeito com [package.metadata.esp-idf-sys] definido no Cargo.toml a
# apontar para este ficheiro — caso contrário o esp-idf-sys ignora-o
# silenciosamente e usa os defaults do Kconfig (foi o que aconteceu antes
# desta correção, causando "stack overflow in task main").
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_ESP_TIMER_TASK_STACK_SIZE=8192
