import { Theme } from "theme.slint";
import { StatusBar } from "status_bar.slint";
import { ControlCenter } from "control_center.slint";
import { SplashScreen } from "splash.slint";
import { PasscodeSetup, RegionLanguage } from "first_boot.slint";
import { ChatView } from "chat_view.slint";
import { AppLauncher } from "app_launcher.slint";
import { MusicPlayer } from "music_player.slint";
import { SettingsPanel, ChangePasscode } from "settings.slint";
import { StorePanel } from "store.slint";

export enum Screen {
    Splash,
    FirstBootPasscode,
    FirstBootRegion,
    Home,
    Launcher,
    Music,
    Settings,
    SettingsPassword,
    Store,
}

export component AppWindow inherits Window {
    width: 320px;
    height: 240px;
    background: Theme.bg-0;
    title: "DC OS";

    in-out property <Screen> current-screen: Screen.Splash;
    in-out property <bool> control-center-open: false;
    in-out property <string> current-time: "09:42";
    in-out property <bool> wifi-on: true;
    in-out property <bool> bluetooth-on: true;
    in-out property <bool> autorotate: true;
    in-out property <float> audio-level: 0.0;
    in-out property <bool> listening: false;

    property <bool> show-status: root.current-screen != Screen.Splash
        && root.current-screen != Screen.FirstBootPasscode
        && root.current-screen != Screen.FirstBootRegion;

    callback set-brightness(float);
    callback set-volume(float);
    callback wake-word-triggered();
    callback launch-app(int);
    callback passcode-created(string);
    callback passcode-updated(string);
    callback wifi-enabled-changed(bool);
    callback wifi-network-selected(string);
    callback bluetooth-enabled-changed(bool);
    // Emitido pelo Control Center quando o utilizador liga/desliga a
    // rotacao automatica. O Rust ajusta MADCTL no ILI9341V.
    callback set-rotation(bool);

    // Container do conteudo: preenche toda a tela quando a status bar
    // esta oculta (splash / first boot) e desce 24px caso contrario.
    Rectangle {
        x: 0px;
        y: root.show-status ? 24px : 0px;
        width: 320px;
        height: root.show-status ? 216px : 240px;

        if root.current-screen == Screen.Splash:
            SplashScreen { width: 100%; height: 100%; }

        if root.current-screen == Screen.FirstBootPasscode:
            PasscodeSetup {
                width: 100%; height: 100%;
                confirm(pass) => {
                    root.passcode-created(pass);
                    root.current-screen = Screen.FirstBootRegion;
                }
            }

        if root.current-screen == Screen.FirstBootRegion:
            RegionLanguage {
                width: 100%; height: 100%;
                continue-clicked => { root.current-screen = Screen.Home; }
            }

        if root.current-screen == Screen.Home:
            ChatView {
                width: 100%; height: 100%;
                audio-level: root.audio-level;
                listening: root.listening;
                mic-tapped => { root.wake-word-triggered(); }
                menu-tapped => { root.current-screen = Screen.Launcher; }
            }

        if root.current-screen == Screen.Launcher:
            AppLauncher {
                width: 100%; height: 100%;
                app-clicked(idx) => {
                    root.launch-app(idx);
                    if (idx == 1) { root.current-screen = Screen.Music; }
                    else if (idx == 5) { root.current-screen = Screen.Store; }
                    else if (idx == 6) { root.current-screen = Screen.Settings; }
                    else { root.current-screen = Screen.Home; }
                }
                rail-clicked(idx) => {
                    if (idx == 0) { root.current-screen = Screen.Home; }
                    else if (idx == 1) { root.current-screen = Screen.Music; }
                    else if (idx == 2) { root.current-screen = Screen.Store; }
                    else if (idx == 3) { root.current-screen = Screen.Settings; }
                }
            }

        if root.current-screen == Screen.Music:
            MusicPlayer {
                width: 100%; height: 100%;
                back => { root.current-screen = Screen.Launcher; }
            }

        if root.current-screen == Screen.Settings:
            SettingsPanel {
                width: 100%; height: 100%;
                wifi-on <=> root.wifi-on;
                bluetooth-on <=> root.bluetooth-on;
                change-passcode => { root.current-screen = Screen.SettingsPassword; }
                wifi-changed(on) => { root.wifi-enabled-changed(on); }
                bluetooth-changed(on) => { root.bluetooth-enabled-changed(on); }
                network-selected(ssid) => {
                    root.wifi-on = true;
                    root.wifi-network-selected(ssid);
                    root.wifi-enabled-changed(true);
                }
                back => { root.current-screen = Screen.Launcher; }
            }

        if root.current-screen == Screen.SettingsPassword:
            ChangePasscode {
                width: 100%; height: 100%;
                back => { root.current-screen = Screen.Settings; }
                save(pass) => {
                    root.passcode-updated(pass);
                    root.current-screen = Screen.Settings;
                }
            }

        if root.current-screen == Screen.Store:
            StorePanel {
                width: 100%; height: 100%;
                back => { root.current-screen = Screen.Launcher; }
            }
    }

    // Status bar SEMPRE fixa no topo (0,0) com 320x24 explicitos. Quando
    // nao deve aparecer, fica oculta pelo `if`. Isto resolve o bug em que
    // o relogio aparecia no meio do ecra por a StatusBar herdar tamanhos
    // "colapsados" ao ser adicionada sem posicao/tamanho explicitos.
    if root.show-status:
        StatusBar {
            x: 0px; y: 0px; width: 320px; height: 24px;
            current-time: root.current-time;
            wifi-on: root.wifi-on;
            bluetooth-on: root.bluetooth-on;
            TouchArea { clicked => { root.control-center-open = true; } }
        }

    if root.control-center-open:
        Rectangle {
            x: 0px; y: 24px; width: 320px; height: 216px;
            background: #00000000;

            Rectangle {
                width: 100%; height: 100%;
                background: #03050ECC;
                TouchArea { clicked => { root.control-center-open = false; } }
            }

            ControlCenter {
                visible: true;
                width: 100%; height: 100%;
                wifi-on <=> root.wifi-on;
                bluetooth-on <=> root.bluetooth-on;
                autorotate <=> root.autorotate;
                brightness-changed(v) => { root.set-brightness(v); }
                volume-changed(v) => { root.set-volume(v); }
                wifi-changed(on) => { root.wifi-enabled-changed(on); }
                bluetooth-changed(on) => { root.bluetooth-enabled-changed(on); }
                rotation-changed(on) => { root.set-rotation(on); }
            }
        }
}
