import { Theme } from "theme.slint";
import { StatusBar } from "status_bar.slint";
import { ControlCenter } from "control_center.slint";
import { SplashScreen } from "splash.slint";
import { PasscodeSetup, RegionLanguage } from "first_boot.slint";
import { ChatView } from "chat_view.slint";
import { AppLauncher } from "app_launcher.slint";
import { MusicPlayer } from "music_player.slint";
import { SettingsPanel, ChangePasscode, WifiNetwork, BluetoothDevice } from "settings.slint";
import { AlarmPanel } from "alarm.slint";

export enum Screen {
    Splash,
    FirstBootPasscode,
    FirstBootRegion,
    Home,
    Launcher,
    Music,
    Alarm,
    Settings,
    SettingsPassword,
}

export component AppWindow inherits Window {
    width: 320px;
    height: 240px;
    background: Theme.bg-0;
    title: "DC OS";

    in-out property <Screen> current-screen: Screen.Splash;
    in-out property <bool> control-center-open: false;
    in-out property <string> current-time: "09:42";
    in-out property <bool> wifi-on: true;
    in-out property <bool> bluetooth-on: true;
    in-out property <bool> api-online: false;
    in-out property <bool> autorotate: true;
    in-out property <float> volume: 0.75;
    in-out property <float> brightness: 0.60;
    in-out property <int> region-index: 0;
    in-out property <int> language-index: 0;
    in-out property <bool> alarm-enabled: false;
    in-out property <int> alarm-hour: 7;
    in-out property <int> alarm-minute: 0;
    in-out property <bool> music-playing: false;
    in-out property <float> audio-level: 0.0;
    in-out property <bool> listening: false;
    in-out property <float> screen-opacity: 1.0;

    // Spotify track data (preenchido pelo Rust)
    in-out property <[string]> spotify-titles: ["A carregar..."];
    in-out property <[string]> spotify-artists: [""];
    in-out property <[string]> spotify-albums: [""];
    in-out property <[WifiNetwork]> wifi-networks: [];
    in-out property <[BluetoothDevice]> bluetooth-devices: [];

    property <bool> show-status: root.current-screen != Screen.Splash
        && root.current-screen != Screen.FirstBootPasscode
        && root.current-screen != Screen.FirstBootRegion;

    callback set-brightness(float);
    callback set-volume(float);
    callback wake-word-triggered();
    callback launch-app(int);
    callback passcode-created(string);
    callback passcode-updated(string);
    callback wifi-enabled-changed(bool);
    callback wifi-network-selected(string, string);
    callback scan-wifi-networks();
    callback bluetooth-enabled-changed(bool);
    callback locale-changed(int, int);
    callback alarm-changed(bool, int, int);
    callback music-command(string);
    // Emitido pelo Control Center quando o utilizador liga/desliga a
    // rotacao automatica. O Rust ajusta MADCTL no ILI9341V.
    callback set-rotation(bool);

    function show-screen(screen: Screen) {
        root.screen-opacity = 0.35;
        root.current-screen = screen;
        fade-timer.running = true;
    }

    animate screen-opacity { duration: 160ms; easing: ease-out; }

    fade-timer := Timer {
        interval: 24ms;
        running: false;
        triggered() => {
            root.screen-opacity = 1.0;
            self.running = false;
        }
    }

    // Container do conteudo: preenche toda a tela quando a status bar
    // esta oculta (splash / first boot) e desce 24px caso contrario.
    Rectangle {
        x: 0px;
        y: root.show-status ? 24px : 0px;
        width: 320px;
        height: root.show-status ? 216px : 240px;
        opacity: root.screen-opacity;

        if root.current-screen == Screen.Splash:
            SplashScreen { width: 100%; height: 100%; }

        if root.current-screen == Screen.FirstBootPasscode:
            PasscodeSetup {
                width: 100%; height: 100%;
                confirm(pass) => {
                    root.passcode-created(pass);
                    root.show-screen(Screen.FirstBootRegion);
                }
            }

        if root.current-screen == Screen.FirstBootRegion:
            RegionLanguage {
                width: 100%; height: 100%;
                region-index <=> root.region-index;
                language-index <=> root.language-index;
                continue-clicked(region, language) => {
                    root.locale-changed(region, language);
                    root.show-screen(Screen.Home);
                }
            }

        if root.current-screen == Screen.Home:
            ChatView {
                width: 100%; height: 100%;
                audio-level: root.audio-level;
                listening: root.listening;
                mic-tapped => { root.wake-word-triggered(); }
                menu-tapped => { root.show-screen(Screen.Launcher); }
            }

        if root.current-screen == Screen.Launcher:
            AppLauncher {
                width: 100%; height: 100%;
                app-clicked(idx) => {
                    root.launch-app(idx);
                    if (idx == 1) { root.show-screen(Screen.Music); }
                    else if (idx == 5) { root.show-screen(Screen.Alarm); }
                    else if (idx == 6) { root.show-screen(Screen.Settings); }
                    else { root.show-screen(Screen.Home); }
                }
            }

        if root.current-screen == Screen.Music:
            MusicPlayer {
                width: 100%; height: 100%;
                playing <=> root.music-playing;
                track-titles: root.spotify-titles;
                track-artists: root.spotify-artists;
                track-albums: root.spotify-albums;
                playback-changed(playing) => {
                    root.music-command(playing ? "play" : "pause");
                }
                next => { root.music-command("next"); }
                prev => { root.music-command("prev"); }
                back => { root.show-screen(Screen.Launcher); }
            }

        if root.current-screen == Screen.Alarm:
            AlarmPanel {
                width: 100%; height: 100%;
                enabled <=> root.alarm-enabled;
                hour <=> root.alarm-hour;
                minute <=> root.alarm-minute;
                alarm-changed(on, hour, minute) => { root.alarm-changed(on, hour, minute); }
                back => { root.show-screen(Screen.Launcher); }
            }

        if root.current-screen == Screen.Settings:
            SettingsPanel {
                width: 100%; height: 100%;
                wifi-on <=> root.wifi-on;
                bluetooth-on <=> root.bluetooth-on;
                volume <=> root.volume;
                brightness <=> root.brightness;
                region-index <=> root.region-index;
                language-index <=> root.language-index;
                networks: root.wifi-networks;
                bluetooth-devices: root.bluetooth-devices;
                change-passcode => { root.show-screen(Screen.SettingsPassword); }
                scan-wifi-networks => { root.scan-wifi-networks(); }
                wifi-changed(on) => { root.wifi-enabled-changed(on); }
                bluetooth-changed(on) => { root.bluetooth-enabled-changed(on); }
                locale-changed(region, language) => { root.locale-changed(region, language); }
                volume-changed(v) => { root.set-volume(v); }
                brightness-changed(v) => { root.set-brightness(v); }
                network-selected(ssid, password) => {
                    root.wifi-on = true;
                    root.wifi-network-selected(ssid, password);
                    root.wifi-enabled-changed(true);
                }
                back => { root.show-screen(Screen.Launcher); }
            }

        if root.current-screen == Screen.SettingsPassword:
            ChangePasscode {
                width: 100%; height: 100%;
                back => { root.show-screen(Screen.Settings); }
                save(pass) => {
                    root.passcode-updated(pass);
                    root.show-screen(Screen.Settings);
                }
            }

    }

    // Status bar SEMPRE fixa no topo (0,0) com 320x24 explicitos. Quando
    // nao deve aparecer, fica oculta pelo `if`. Isto resolve o bug em que
    // o relogio aparecia no meio do ecra por a StatusBar herdar tamanhos
    // "colapsados" ao ser adicionada sem posicao/tamanho explicitos.
    if root.show-status:
        StatusBar {
            x: 0px; y: 0px; width: 320px; height: 24px;
            current-time: root.current-time;
            wifi-on: root.wifi-on;
            bluetooth-on: root.bluetooth-on;
            api-online: root.api-online;
            TouchArea { clicked => { root.control-center-open = true; } }
        }

    if root.control-center-open:
        Rectangle {
            x: 0px; y: 24px; width: 320px; height: 216px;
            background: #00000000;

            Rectangle {
                width: 100%; height: 100%;
                background: #03050ECC;
                TouchArea { clicked => { root.control-center-open = false; } }
            }

            ControlCenter {
                visible: true;
                width: 100%; height: 100%;
                volume <=> root.volume;
                brightness <=> root.brightness;
                wifi-on <=> root.wifi-on;
                bluetooth-on <=> root.bluetooth-on;
                autorotate <=> root.autorotate;
                brightness-changed(v) => {
                    root.brightness = v;
                    root.set-brightness(v);
                }
                volume-changed(v) => {
                    root.volume = v;
                    root.set-volume(v);
                }
                wifi-changed(on) => { root.wifi-enabled-changed(on); }
                bluetooth-changed(on) => { root.bluetooth-enabled-changed(on); }
                rotation-changed(on) => { root.set-rotation(on); }
            }
        }
}
