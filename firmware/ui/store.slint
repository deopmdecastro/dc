import { Theme } from "theme.slint";

export component StorePanel inherits Rectangle {
    callback back();

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    Text {
        x: 0px; y: 8px; width: 100%; height: 20px;
        text: "Loja DC OS";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: 10px; y: 7px; width: 24px; height: 24px;
        border-radius: 12px;
        background: #00000000;
        TouchArea { clicked => { root.back(); } }
        Text { text: "\u{2039}"; color: Theme.text-primary; font-size: 28px; horizontal-alignment: center; vertical-alignment: center; }
    }

    Rectangle {
        x: 20px; y: 42px; width: 280px; height: 60px;
        border-radius: Theme.radius-m;
        background: Theme.accent;
        clip: true;
        Text {
            x: 14px; y: 9px; width: 155px; height: 42px;
            text: "Novos apps\ne integrações\npara você!";
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle { x: 210px; y: 13px; width: 36px; height: 34px; border-radius: 6px; background: Theme.accent-pink; }
        Rectangle { x: 218px; y: 7px; width: 20px; height: 18px; border-radius: 9px; background: #00000000; border-width: 2px; border-color: #FFB7F3; }
    }

    Text { x: 20px; y: 112px; width: 120px; height: 16px; text: "Apps populares"; color: Theme.text-primary; font-size: Theme.font-sm; font-weight: 700; }
    Text { x: 236px; y: 112px; width: 64px; height: 16px; text: "Ver todos"; color: Theme.accent-blue; font-size: Theme.font-xs; horizontal-alignment: right; }

    for app[index] in [
        { name: "Spotify", kind: "Música", mark: "S", color: #1ED760 },
        { name: "YouTube", kind: "Vídeo", mark: "Y", color: #FF1F1F },
        { name: "TuneIn Radio", kind: "Rádio", mark: "T", color: #00D5FF },
    ] : Rectangle {
        x: 20px; y: 135px + index * 24px; width: 280px; height: 22px;
        border-radius: Theme.radius-s;
        background: Theme.tile;
        Rectangle {
            x: 8px; y: 3px; width: 16px; height: 16px;
            border-radius: 8px;
            background: app.color;
            Text { text: app.mark; color: #051018; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { x: 32px; y: 1px; width: 115px; height: 11px; text: app.name; color: Theme.text-primary; font-size: Theme.font-xs; font-weight: 700; }
        Text { x: 32px; y: 11px; width: 115px; height: 10px; text: app.kind; color: Theme.text-secondary; font-size: 8px; }
        Rectangle {
            x: 218px; y: 3px; width: 52px; height: 16px;
            border-radius: 5px;
            background: Theme.accent;
            Text { text: "Instalar"; color: Theme.text-primary; font-size: 8px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}
