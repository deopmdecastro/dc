import { Theme } from "theme.slint";

export component StorePanel inherits Rectangle {
    callback back();

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    Rectangle {
        x: 0px; y: 0px; width: 44px; height: 34px;
        border-radius: 12px;
        background: #00000000;
        TouchArea { clicked => { root.back(); } }
        Image { x: 14px; y: 9px; width: 16px; height: 16px; source: @image-url("assets/icons/chevron-left.svg"); image-fit: contain; }
    }
    Text {
        x: 0px; y: 6px; width: 100%; height: 22px;
        text: "Loja DC OS";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Image {
        x: 292px; y: 8px; width: 16px; height: 16px;
        source: @image-url("assets/icons/more-horizontal.svg");
        image-fit: contain;
    }

    Rectangle {
        x: 18px; y: 38px; width: 284px; height: 60px;
        border-radius: Theme.radius-m;
        background: Theme.accent;
        clip: true;
        Rectangle { x: 188px; y: -10px; width: 110px; height: 80px; border-radius: 40px; background: Theme.accent-hi; }
        Rectangle { x: -20px; y: 34px; width: 90px; height: 56px; border-radius: 28px; background: Theme.accent-violet; }
        Text {
            x: 14px; y: 9px; width: 160px; height: 42px;
            text: "Novos apps\ne integrações\npara você!";
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            font-weight: 700;
            vertical-alignment: center;
        }
        Image {
            x: 232px; y: 12px; width: 34px; height: 34px;
            source: @image-url("assets/icons/shopping-bag.svg");
            image-fit: contain;
        }
    }

    Text {
        x: 18px; y: 108px; width: 120px; height: 16px;
        text: "Apps populares";
        color: Theme.text-primary;
        font-size: Theme.font-sm;
        font-weight: 700;
    }
    Text {
        x: 228px; y: 108px; width: 70px; height: 16px;
        text: "Ver todos";
        color: Theme.accent-cyan;
        font-size: Theme.font-xs;
        font-weight: 700;
        horizontal-alignment: right;
    }

    for app[index] in [
        { name: "Spotify", kind: "Música", color: #1ED760 },
        { name: "YouTube", kind: "Vídeo",  color: #FF2B2B },
        { name: "TuneIn Radio", kind: "Rádio", color: #19C9FF },
    ] : Rectangle {
        x: 18px; y: 130px + index * 28px; width: 284px; height: 26px;
        border-radius: Theme.radius-s;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        Rectangle {
            x: 8px; y: 5px; width: 16px; height: 16px;
            border-radius: 8px;
            background: app.color;
        }
        Text {
            x: 30px; y: 4px; width: 120px; height: 10px;
            text: app.name;
            color: Theme.text-primary;
            font-size: Theme.font-xs;
            font-weight: 700;
        }
        Text {
            x: 30px; y: 15px; width: 80px; height: 8px;
            text: app.kind;
            color: Theme.text-secondary;
            font-size: 8px;
        }
        Rectangle {
            x: 214px; y: 2px; width: 64px; height: 22px;
            border-radius: 5px;
            background: Theme.accent;
            Text {
                text: "Instalar";
                color: Theme.text-primary;
                font-size: 8px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
