import { Theme } from "theme.slint";

// Loja DC OS — banner promocional + lista de apps populares.
export component StorePanel inherits Rectangle {
    callback back();

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // ===== Top bar =====
    Rectangle {
        x: 8px; y: 6px; width: 26px; height: 26px;
        border-radius: 13px;
        background: #00000000;
        TouchArea { clicked => { root.back(); } }
        Text {
            text: "\u{2039}";
            color: Theme.text-primary;
            font-size: 26px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 0px; y: 6px; width: 100%; height: 22px;
        text: "Loja DC OS";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        x: 286px; y: 6px; width: 26px; height: 26px;
        border-radius: 13px;
        background: #00000000;
        Text {
            text: "\u{2630}";
            color: Theme.text-primary;
            font-size: Theme.font-lg;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== Banner promocional (gradiente roxo→magenta com sacola) =====
    Rectangle {
        x: 18px; y: 38px; width: 284px; height: 60px;
        border-radius: Theme.radius-m;
        background: Theme.accent;
        clip: true;
        // Manchas de glow para imitar o gradiente vitoriano do mockup
        Rectangle {
            x: 200px; y: -10px; width: 100px; height: 80px;
            border-radius: 40px;
            background: Theme.accent-hi;
            opacity: 0.7;
        }
        Rectangle {
            x: -20px; y: 30px; width: 80px; height: 60px;
            border-radius: 30px;
            background: Theme.accent-pink;
            opacity: 0.5;
        }

        Text {
            x: 14px; y: 8px; width: 200px; height: 44px;
            text: "Novos apps\ne integrações\npara você!";
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            font-weight: 700;
            vertical-alignment: center;
        }
        // Sacola de compras estilizada
        Rectangle {
            x: 232px; y: 12px; width: 38px; height: 38px;
            border-radius: 6px;
            background: #00000000;
            // Alça
            Rectangle {
                x: 8px; y: -2px; width: 22px; height: 12px;
                border-radius: 6px;
                background: #00000000;
                border-width: 2px;
                border-color: #FFB7F3;
            }
            // Corpo
            Rectangle {
                x: 2px; y: 8px; width: 34px; height: 28px;
                border-radius: 4px;
                background: #FFB7F3;
                opacity: 0.85;
            }
            Rectangle {
                x: 12px; y: 16px; width: 14px; height: 2px;
                border-radius: 1px;
                background: Theme.accent;
            }
        }
    }

    // ===== "Apps populares" + "Ver todos" =====
    Text {
        x: 18px; y: 108px; width: 200px; height: 16px;
        text: "Apps populares";
        color: Theme.text-primary;
        font-size: Theme.font-sm;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        x: 218px; y: 108px; width: 84px; height: 16px;
        text: "Ver todos";
        color: Theme.accent-blue;
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // Lista de apps
    for app[index] in [
        { name: "Spotify",     kind: "Música", mark: "S", color: #1ED760 },
        { name: "YouTube",     kind: "Vídeo",  mark: "Y", color: #FF1F1F },
        { name: "TuneIn Radio", kind: "Rádio", mark: "T", color: #00D5FF },
    ] : Rectangle {
        x: 18px; y: 130px + index * 26px; width: 284px; height: 24px;
        border-radius: Theme.radius-s;
        background: Theme.tile;

        // Logo circular colorido
        Rectangle {
            x: 6px; y: 4px; width: 16px; height: 16px;
            border-radius: 8px;
            background: app.color;
            Text {
                text: app.mark;
                color: #051018;
                font-size: 9px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 28px; y: 2px; width: 160px; height: 11px;
            text: app.name;
            color: Theme.text-primary;
            font-size: 9px;
            font-weight: 700;
        }
        Text {
            x: 28px; y: 13px; width: 160px; height: 10px;
            text: app.kind;
            color: Theme.text-secondary;
            font-size: 8px;
        }

        Rectangle {
            x: 222px; y: 4px; width: 54px; height: 16px;
            border-radius: 5px;
            background: Theme.accent;
            Text {
                text: "Instalar";
                color: Theme.text-primary;
                font-size: 8px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
