import { Theme } from "theme.slint";

// Player de música — capa + metadados + barra de progresso + controles.
export component MusicPlayer inherits Rectangle {
    in property <string> track-title:  "Blinding Lights";
    in property <string> artist:       "The Weeknd";
    in property <string> album:        "After Hours";
    in property <image>  cover;
    in property <float>  progress:     0.4;
    in property <string> pos-label:    "1:24";
    in property <string> dur-label:    "3:20";
    in-out property <bool> playing:    true;

    callback toggle-play();
    callback next();
    callback prev();
    callback back();

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // ===== Top bar: back + título + menu =====
    Rectangle {
        x: 8px; y: 6px; width: 26px; height: 26px;
        border-radius: 13px;
        background: #00000000;
        TouchArea { clicked => { root.back(); } }
        Text {
            text: "\u{2039}";
            color: Theme.text-primary;
            font-size: 26px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 0px; y: 6px; width: 100%; height: 22px;
        text: "Player de Música";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: 286px; y: 6px; width: 26px; height: 26px;
        border-radius: 13px;
        background: #00000000;
        Text {
            text: "\u{2630}";
            color: Theme.text-primary;
            font-size: Theme.font-lg;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== Capa do álbum =====
    Rectangle {
        x: 18px; y: 42px; width: 92px; height: 92px;
        border-radius: Theme.radius-m;
        background: #2D0D55;
        clip: true;
        // Gradiente pink/purple sintetizando a capa real
        Rectangle {
            x: 0px; y: 0px; width: 100%; height: 100%;
            background: Theme.accent-pink;
            opacity: 0.4;
        }
        Rectangle {
            x: 0px; y: 30%; width: 100%; height: 30%;
            background: #51187A;
            opacity: 0.7;
        }
        // "CD" brilhante ao centro
        Rectangle {
            x: 32px; y: 32px; width: 28px; height: 28px;
            border-radius: 14px;
            background: Theme.accent-blue;
            opacity: 0.5;
            border-width: 2px;
            border-color: Theme.accent-2;
        }
        Text {
            x: 0px; y: 0px; width: 100%; height: 100%;
            text: "\u{266B}";
            color: Theme.text-primary;
            font-size: 36px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== Metadados =====
    Text {
        x: 124px; y: 60px; width: 160px; height: 22px;
        text: root.track-title;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
    }
    Text {
        x: 124px; y: 82px; width: 160px; height: 16px;
        text: root.artist;
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
    }
    Text {
        x: 124px; y: 98px; width: 160px; height: 14px;
        text: root.album;
        color: Theme.text-muted;
        font-size: 9px;
    }

    // Ícone de favoritar (coração)
    Rectangle {
        x: 286px; y: 64px; width: 22px; height: 22px;
        border-radius: 11px;
        background: #00000000;
        Text {
            text: "\u{2665}";
            color: Theme.accent-pink;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== Barra de progresso =====
    Rectangle {
        x: 18px; y: 144px; width: 284px; height: 4px;
        border-radius: 2px;
        background: Theme.tile-hi;
        Rectangle {
            width: parent.width * root.progress; height: 100%;
            border-radius: 2px;
            background: Theme.accent-hi;
        }
        Rectangle {
            x: parent.width * root.progress - 4px; y: -3px;
            width: 10px; height: 10px;
            border-radius: 5px;
            background: Theme.text-primary;
        }
    }

    Text {
        x: 18px; y: 152px; width: 40px; height: 12px;
        text: root.pos-label;
        color: Theme.text-secondary;
        font-size: 8px;
    }
    Text {
        x: 262px; y: 152px; width: 40px; height: 12px;
        text: root.dur-label;
        color: Theme.text-secondary;
        font-size: 8px;
        horizontal-alignment: right;
    }

    // ===== Controles =====
    HorizontalLayout {
        x: 18px; y: 176px; width: 284px; height: 36px;
        alignment: space-between;

        // Shuffle
        Text {
            text: "\u{2928}";
            color: Theme.text-secondary;
            font-size: Theme.font-lg;
            vertical-alignment: center;
        }

        // Prev
        Rectangle {
            width: 32px; height: 32px;
            border-radius: 16px;
            TouchArea { clicked => { root.prev(); } }
            Text {
                text: "\u{23EE}";
                color: Theme.text-primary;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Play (botão grande roxo)
        Rectangle {
            width: 48px; height: 48px;
            y: -6px;
            border-radius: 24px;
            background: Theme.accent;
            TouchArea { clicked => { root.toggle-play(); root.playing = !root.playing; } }
            Text {
                text: root.playing ? "\u{23F8}" : "\u{25B6}";
                color: Theme.text-primary;
                font-size: 22px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Next
        Rectangle {
            width: 32px; height: 32px;
            border-radius: 16px;
            TouchArea { clicked => { root.next(); } }
            Text {
                text: "\u{23ED}";
                color: Theme.text-primary;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Repeat
        Text {
            text: "\u{21BB}";
            color: Theme.text-secondary;
            font-size: Theme.font-lg;
            vertical-alignment: center;
        }
    }
}
