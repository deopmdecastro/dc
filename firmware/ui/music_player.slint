import { Theme } from "theme.slint";

export component MusicPlayer inherits Rectangle {
    in property <string> track-title:  "Blinding Lights";
    in property <string> artist:       "The Weeknd";
    in property <string> album:        "After Hours";
    in property <image>  cover;
    in property <float>  progress:     0.4;
    in property <string> pos-label:    "1:24";
    in property <string> dur-label:    "3:20";
    in-out property <bool> playing:    true;

    callback toggle-play();
    callback next();
    callback prev();
    callback back();

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    Text { x: 0px; y: 8px; width: 100%; height: 20px; text: "Player de Música"; color: Theme.text-primary; font-size: Theme.font-md; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    Rectangle { x: 10px; y: 7px; width: 24px; height: 24px; border-radius: 12px; background: #00000000;
        TouchArea { clicked => { root.back(); } }
        Text { text: "\u{2039}"; color: Theme.text-primary; font-size: 28px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 288px; y: 9px; width: 20px; height: 20px; text: "\u{2637}"; color: Theme.text-primary; font-size: Theme.font-lg; horizontal-alignment: center; vertical-alignment: center; }

    Rectangle {
        x: 18px; y: 48px; width: 104px; height: 86px;
        border-radius: Theme.radius-m;
        background: #241445;
        clip: true;
        Rectangle { x: 0px; y: 0px; width: 100%; height: 100%; background: Theme.accent-pink; opacity: 0.28; }
        Rectangle { x: 18px; y: 18px; width: 52px; height: 52px; border-radius: 26px; background: Theme.accent-blue; opacity: 0.55; }
        Text { text: "\u{266B}"; color: Theme.text-primary; font-size: 38px; horizontal-alignment: center; vertical-alignment: center; }
    }

    Text { x: 138px; y: 70px; width: 140px; height: 20px; text: root.track-title; color: Theme.text-primary; font-size: Theme.font-md; font-weight: 700; }
    Text { x: 138px; y: 94px; width: 140px; height: 16px; text: root.artist; color: Theme.text-secondary; font-size: Theme.font-sm; }
    Text { x: 138px; y: 116px; width: 140px; height: 14px; text: root.album; color: Theme.text-secondary; font-size: Theme.font-xs; }
    Text { x: 286px; y: 102px; width: 22px; height: 22px; text: "\u{2661}"; color: Theme.text-primary; font-size: Theme.font-xl; horizontal-alignment: center; vertical-alignment: center; }

    Rectangle {
        x: 18px; y: 148px; width: 284px; height: 4px;
        border-radius: 2px;
        background: Theme.tile-hi;
        Rectangle { width: parent.width * root.progress; height: 100%; border-radius: 2px; background: Theme.accent-hi; }
        Rectangle { x: parent.width * root.progress - 3px; y: -3px; width: 9px; height: 9px; border-radius: 5px; background: Theme.text-primary; }
    }
    Text { x: 18px; y: 157px; width: 40px; height: 12px; text: root.pos-label; color: Theme.text-secondary; font-size: 8px; }
    Text { x: 262px; y: 157px; width: 40px; height: 12px; text: root.dur-label; color: Theme.text-secondary; font-size: 8px; horizontal-alignment: right; }

    HorizontalLayout {
        x: 30px; y: 176px; width: 260px; height: 38px;
        alignment: space-between;
        Text { text: "\u{2928}"; color: Theme.text-secondary; font-size: Theme.font-xl; vertical-alignment: center; }
        Text { text: "\u{23EE}"; color: Theme.text-primary; font-size: Theme.font-xl; vertical-alignment: center; TouchArea { clicked => { root.prev(); } } }
        Rectangle {
            width: 44px; height: 44px;
            y: -3px;
            border-radius: 22px;
            background: Theme.accent;
            TouchArea { clicked => { root.toggle-play(); root.playing = !root.playing; } }
            Text { text: root.playing ? "\u{23F8}" : "\u{25B6}"; color: Theme.text-primary; font-size: Theme.font-xl; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { text: "\u{23ED}"; color: Theme.text-primary; font-size: Theme.font-xl; vertical-alignment: center; TouchArea { clicked => { root.next(); } } }
        Text { text: "\u{21C4}"; color: Theme.text-secondary; font-size: Theme.font-xl; vertical-alignment: center; }
    }
}
