import { Theme } from "theme.slint";

// Player de música — capa retrato (gradient pink/purple) + controles ghost.
export component MusicPlayer inherits Rectangle {
    in property <string> track-title:  "Blinding Lights";
    in property <string> artist:       "The Weeknd";
    in property <string> album:        "After Hours";
    in property <image>  cover;
    in property <float>  progress:     0.4;
    in property <string> pos-label:    "1:24";
    in property <string> dur-label:    "3:20";
    in-out property <bool> playing:    true;

    callback toggle-play();
    callback next();
    callback prev();
    callback back();

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // ===== Top bar =====
    Rectangle {
        x: 8px; y: 6px; width: 22px; height: 22px;
        border-radius: 11px;
        background: #00000000;
        TouchArea { clicked => { root.back(); } }
        Text {
            text: "\u{2039}";
            color: Theme.text-primary;
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 0px; y: 6px; width: 100%; height: 22px;
        text: "Player de Música";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        x: 290px; y: 6px; width: 22px; height: 22px;
        border-radius: 11px;
        background: #00000000;
        Text {
            text: "\u{2637}";
            color: Theme.text-primary;
            font-size: Theme.font-lg;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== Capa do álbum 95×95 (centralizada em y=50) =====
    Rectangle {
        x: 18px; y: 50px; width: 95px; height: 95px;
        border-radius: Theme.radius-m;
        background: Theme.accent-deep;
        clip: true;

        // Glow roxo/magenta
        Rectangle {
            x: 0px; y: 0px; width: 100%; height: 100%;
            background: Theme.accent-pink;
            opacity: 0.35;
        }
        Rectangle {
            x: -10px; y: 30px; width: 130px; height: 50px;
            background: Theme.accent-blue;
            opacity: 0.5;
        }
        // Sotaque cyan
        Rectangle {
            x: 30px; y: 8px; width: 35px; height: 35px;
            border-radius: 18px;
            background: Theme.accent-2;
            opacity: 0.55;
        }
        // Glifo ♫ centrado
        Text {
            x: 0px; y: 0px; width: 100%; height: 100%;
            text: "\u{266B}";
            color: Theme.text-primary;
            font-size: 30px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== Metadados =====
    Text {
        x: 124px; y: 60px; width: 160px; height: 20px;
        text: root.track-title;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
    }
    Text {
        x: 124px; y: 86px; width: 160px; height: 16px;
        text: root.artist;
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
    }
    Text {
        x: 124px; y: 102px; width: 160px; height: 14px;
        text: root.album;
        color: Theme.text-secondary;
        font-size: 9px;
    }

    // Coração (favorito) — pink
    Rectangle {
        x: 288px; y: 60px; width: 22px; height: 22px;
        border-radius: 11px;
        background: #00000000;
        Text {
            text: "\u{2665}";
            color: Theme.accent-pink;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== Barra de progresso mais espessa (h=5) =====
    Rectangle {
        x: 18px; y: 152px; width: 284px; height: 5px;
        border-radius: 3px;
        background: Theme.tile-hi;
        Rectangle {
            width: parent.width * root.progress; height: 100%;
            border-radius: 3px;
            background: Theme.text-primary;
        }
    }

    Text {
        x: 18px; y: 161px; width: 40px; height: 12px;
        text: root.pos-label;
        color: Theme.text-secondary;
        font-size: 8px;
    }
    Text {
        x: 262px; y: 161px; width: 40px; height: 12px;
        text: root.dur-label;
        color: Theme.text-secondary;
        font-size: 8px;
        horizontal-alignment: right;
    }

    // ===== Controles =====
    HorizontalLayout {
        x: 24px; y: 184px; width: 272px; height: 32px;
        alignment: space-between;

        Text { text: "\u{2928}"; color: Theme.text-secondary; font-size: Theme.font-md; vertical-alignment: center; }

        Rectangle {
            width: 28px; height: 28px;
            border-radius: 14px;
            background: #00000000;
            TouchArea { clicked => { root.prev(); } }
            Text {
                text: "\u{23EE}";
                color: Theme.text-primary;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 40px; height: 40px;
            y: -4px;
            border-radius: 20px;
            background: Theme.accent;
            TouchArea { clicked => { root.toggle-play(); root.playing = !root.playing; } }
            Text {
                text: root.playing ? "\u{23F8}" : "\u{25B6}";
                color: Theme.text-primary;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 28px; height: 28px;
            border-radius: 14px;
            background: #00000000;
            TouchArea { clicked => { root.next(); } }
            Text {
                text: "\u{23ED}";
                color: Theme.text-primary;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text { text: "\u{21BB}"; color: Theme.text-secondary; font-size: Theme.font-md; vertical-alignment: center; }
    }
}
