import { Theme } from "theme.slint";

// MusicPlayer — mostra as top tracks do Spotify. As faixas sao passadas
// como arrays de strings a partir do Rust (SystemEvent::SpotifyTracksLoaded).
export component MusicPlayer inherits Rectangle {
    in-out property <int> track-index: 0;
    in-out property <float> progress: 0.0;
    in-out property <bool> playing: false;

    in property <[string]> track-titles: ["Loading..."];
    in property <[string]> track-artists: [""];
    in property <[string]> track-albums: [""];
    in property <int> language-index: 0;
    property <length> bottom-safe: 6px;

    property <int> track-count: max(1, root.track-titles.length);
    property <string> track-title:
        root.track-index < root.track-count ? root.track-titles[root.track-index] :
        (root.language-index == 2 ? "No tracks" : root.language-index == 3 ? "Aucune piste" : root.language-index == 4 ? "Sin pistas" : "Sem faixas");
    property <string> artist:
        root.track-index < root.track-count ? root.track-artists[root.track-index] : "";
    property <string> album:
        root.track-index < root.track-count ? root.track-albums[root.track-index] : "";

    property <string> pos-label:
        root.progress < 0.34 ? "0:42" :
        root.progress < 0.67 ? "1:24" : "2:18";
    property <string> dur-label: "3:20";

    callback playback-changed(bool);
    callback next();
    callback prev();
    callback back();

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // Header
    Rectangle {
        x: 0px; y: 0px; width: 40px; height: 34px;
        border-radius: Theme.radius-s;
        background: bk.pressed ? Theme.panel-elevated : #00000000;
        bk := TouchArea { clicked => { root.back(); } }
        Image { x: 13px; y: 10px; width: 14px; height: 14px; source: @image-url("assets/icons/chevron-left.svg"); image-fit: contain; colorize: Theme.accent; }
    }
    Text {
        x: 0px; y: 4px; width: 320px; height: 26px;
        text: root.language-index == 2 ? "Playing" :
              root.language-index == 3 ? "En lecture" :
              root.language-index == 4 ? "Reproduciendo" : "A tocar";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Capa do album
    Rectangle {
        x: 16px; y: 40px; width: 96px; height: 96px;
        border-radius: Theme.radius-m;
        background: Theme.panel-elevated;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        clip: true;
        Rectangle { x: 0px; y: 0px; width: 96px; height: 96px; background: @linear-gradient(135deg, Theme.accent-deep 0%, Theme.panel 80%); }
        Rectangle {
            x: 31px; y: 27px; width: 42px; height: 42px;
            border-radius: 21px;
            background: Theme.success;
            Image { x: 10px; y: 10px; width: 22px; height: 22px; source: @image-url("assets/icons/spotify.svg"); image-fit: contain; colorize: Theme.bg-0; }
        }
    }

    // Info da faixa
    Text {
        x: 124px; y: 48px; width: 172px; height: 20px;
        text: root.track-title;
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        overflow: elide;
    }
    Text {
        x: 124px; y: 70px; width: 172px; height: 16px;
        text: root.artist;
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        overflow: elide;
    }
    Text {
        x: 124px; y: 88px; width: 172px; height: 14px;
        text: root.album;
        color: Theme.text-muted;
        font-size: 9px;
        overflow: elide;
    }
    // Badge de contador
    Rectangle {
        x: 124px; y: 108px; width: 54px; height: 18px;
        border-radius: 9px;
        background: Theme.accent-tint;
        border-width: 1px;
        border-color: Theme.accent-deep;
        Text {
            text: (root.track-index + 1) + " / " + root.track-count;
            color: Theme.accent;
            font-size: 8px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Image { x: 284px; y: 60px; width: 18px; height: 18px; source: @image-url("assets/icons/heart.svg"); image-fit: contain; colorize: Theme.accent-pink; }

    // Barra de progresso
    Rectangle {
        x: 16px; y: 150px; width: 288px; height: 5px;
        border-radius: 2.5px;
        background: Theme.bg-2;
        Rectangle {
            width: parent.width * root.progress; height: 100%;
            border-radius: 2.5px;
            background: Theme.success;
        }
    }
    Text { x: 16px; y: 158px; width: 40px; height: 11px; text: root.pos-label; color: Theme.text-muted; font-size: 8px; }
    Text {
        x: 264px; y: 158px; width: 40px; height: 11px;
        text: root.dur-label;
        color: Theme.text-muted;
        font-size: 8px;
        horizontal-alignment: right;
    }

    // Controlos
    HorizontalLayout {
        x: 18px; y: 216px - root.bottom-safe - 42px; width: 284px; height: 42px;
        alignment: space-between;
        Image { width: 15px; height: 15px; source: @image-url("assets/icons/shuffle.svg"); image-fit: contain; colorize: Theme.text-muted; }
        Rectangle {
            width: 42px; height: 42px; border-radius: 21px; background: tb.pressed ? Theme.panel-elevated : #00000000;
            tb := TouchArea {
                clicked => {
                    if (root.track-count > 1) {
                        root.track-index = root.track-index == 0 ? root.track-count - 1 : root.track-index - 1;
                        root.progress = 0.0;
                        root.prev();
                    }
                }
            }
            Image { x: 13px; y: 13px; width: 16px; height: 16px; source: @image-url("assets/icons/skip-back.svg"); image-fit: contain; colorize: Theme.text-primary; }
        }
        Rectangle {
            width: 52px; height: 42px;
            border-radius: 21px;
            background: tpl.pressed ? Theme.accent-hi : Theme.success;
            tpl := TouchArea {
                clicked => {
                    root.playing = !root.playing;
                    root.playback-changed(root.playing);
                }
            }
            Image {
                visible: root.playing;
                x: 17px; y: 11px; width: 20px; height: 20px;
                source: @image-url("assets/icons/pause.svg"); image-fit: contain; colorize: Theme.bg-0;
            }
            Image {
                visible: !root.playing;
                x: 18px; y: 11px; width: 20px; height: 20px;
                source: @image-url("assets/icons/play.svg"); image-fit: contain; colorize: Theme.bg-0;
            }
        }
        Rectangle {
            width: 42px; height: 42px; border-radius: 21px; background: tf.pressed ? Theme.panel-elevated : #00000000;
            tf := TouchArea {
                clicked => {
                    if (root.track-count > 1) {
                        root.track-index = root.track-index == root.track-count - 1 ? 0 : root.track-index + 1;
                        root.progress = 0.0;
                        root.next();
                    }
                }
            }
            Image { x: 13px; y: 13px; width: 16px; height: 16px; source: @image-url("assets/icons/skip-forward.svg"); image-fit: contain; colorize: Theme.text-primary; }
        }
        Image { width: 15px; height: 15px; source: @image-url("assets/icons/repeat.svg"); image-fit: contain; colorize: Theme.text-muted; }
    }
}
