import { Theme } from "theme.slint";

// Player de música — dialoga com o container Mopidy no backend.
export component MusicPlayer inherits Rectangle {
    in property <string> track-title:  "Blinding Lights";
    in property <string> artist:       "The Weeknd";
    in property <string> album:        "After Hours";
    in property <image>  cover:        @image-url("../assets/cover_placeholder.png");
    in property <float>  progress:     0.4;
    in property <string> pos-label:    "1:24";
    in property <string> dur-label:    "3:20";
    in-out property <bool> playing:    true;

    callback toggle-play();
    callback next();
    callback prev();
    callback back();

    width: 100%; height: 100%;
    background: Theme.bg-1;

    VerticalLayout {
        padding: 8px; spacing: 6px;
        // Top bar
        HorizontalLayout {
            spacing: 8px; alignment: space-between;
            Rectangle {
                width: 24px; height: 24px; border-radius: 6px; background: Theme.surface;
                TouchArea { clicked => { root.back(); } }
                Text { text: "\u{2190}"; color: Theme.text-primary;
                       horizontal-alignment: center; vertical-alignment: center; }
            }
            Text { text: "Player de Música"; color: Theme.text-primary;
                   font-size: Theme.font-md; vertical-alignment: center; }
            Rectangle { width: 24px; }
        }

        HorizontalLayout {
            spacing: 10px;
            // Cover
            Rectangle {
                width: 96px; height: 96px; border-radius: Theme.radius-m;
                background: Theme.surface; clip: true;
                Image { source: root.cover; width: 100%; height: 100%; image-fit: cover; }
            }
            // Info
            VerticalLayout {
                alignment: center; spacing: 2px;
                Text { text: root.track-title; color: Theme.text-primary; font-size: Theme.font-md; }
                Text { text: root.artist; color: Theme.text-secondary; font-size: Theme.font-sm; }
                Text { text: root.album;  color: Theme.text-muted;     font-size: Theme.font-xs; }
            }
        }

        // Progress
        HorizontalLayout {
            spacing: 6px;
            Text { text: root.pos-label; color: Theme.text-muted; font-size: 9px;
                   vertical-alignment: center; }
            Rectangle {
                horizontal-stretch: 1; height: 4px; y: (parent.height - self.height)/2;
                background: Theme.bg-2; border-radius: 2px;
                Rectangle {
                    width: parent.width * root.progress; height: 100%;
                    background: Theme.accent; border-radius: 2px;
                }
            }
            Text { text: root.dur-label; color: Theme.text-muted; font-size: 9px;
                   vertical-alignment: center; }
        }

        // Controls
        HorizontalLayout {
            alignment: center; spacing: 14px; padding-top: 4px;
            Rectangle { width: 28px; height: 28px; border-radius: 14px; background: Theme.surface;
                TouchArea { clicked => { } }
                Text { text: "\u{1F500}"; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle { width: 28px; height: 28px; border-radius: 14px; background: Theme.surface;
                TouchArea { clicked => { root.prev(); } }
                Text { text: "\u{23EE}"; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle { width: 40px; height: 40px; border-radius: 20px; background: Theme.accent;
                TouchArea { clicked => { root.toggle-play(); root.playing = !root.playing; } }
                Text { text: root.playing ? "\u{23F8}" : "\u{25B6}";
                       color: Theme.text-primary;
                       horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle { width: 28px; height: 28px; border-radius: 14px; background: Theme.surface;
                TouchArea { clicked => { root.next(); } }
                Text { text: "\u{23ED}"; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle { width: 28px; height: 28px; border-radius: 14px; background: Theme.surface;
                Text { text: "\u{1F501}"; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
}
