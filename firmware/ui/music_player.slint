import { Theme } from "theme.slint";

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <color> tab-color: Theme.success;
    callback clicked();
    width: 73px;
    height: 22px;
    border-radius: Theme.radius-s;
    border-width: 1px;
    border-color: root.selected ? root.tab-color : Theme.stroke-soft;
    background: root.selected ? root.tab-color : Theme.panel-soft;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: root.selected ? Theme.bg-0 : Theme.text-secondary;
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TrackRow inherits Rectangle {
    in property <int> index: 0;
    in property <bool> selected: false;
    in property <bool> is-playlist: false;
    in property <string> title: "";
    in property <string> subtitle: "";
    callback clicked();
    width: 296px;
    height: 14px;
    background: root.selected ? Theme.accent-tint : #00000000;
    border-radius: 3px;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        x: 4px; y: 0px; width: 200px; height: 14px;
        text: root.title;
        color: root.selected ? Theme.accent : Theme.text-primary;
        font-size: 8px;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        x: 208px; y: 0px; width: 84px; height: 14px;
        text: root.subtitle;
        color: Theme.text-muted;
        font-size: 7px;
        horizontal-alignment: right;
        overflow: elide;
    }
}

export component MusicPlayer inherits Rectangle {
    in-out property <int> track-index: 0;
    in-out property <float> progress: 0.0;
    in-out property <bool> playing: false;
    in-out property <int> active-tab: 0; // 0=top, 1=recent, 2=saved, 3=playlists

    in property <[string]> track-titles: ["Loading..."];
    in property <[string]> track-artists: [""];
    in property <[string]> track-albums: [""];
    in property <[string]> recent-titles: [""];
    in property <[string]> recent-artists: [""];
    in property <[string]> recent-albums: [""];
    in property <[string]> saved-titles: [""];
    in property <[string]> saved-artists: [""];
    in property <[string]> saved-albums: [""];
    in property <[string]> playlist-names: [""];
    in property <[int]> playlist-tracks: [0];
    in property <int> language-index: 0;
    in property <string> provider-title: "";
    in property <image> provider-icon: @image-url("assets/icons/spotify.svg");
    in property <color> provider-color: Theme.success;

    property <string> title-label:
        root.provider-title != "" ? root.provider-title :
        (root.language-index == 2 ? "Playing" :
         root.language-index == 3 ? "En lecture" :
         root.language-index == 4 ? "Reproduciendo" : "A tocar");

    // Computed properties based on active tab
    property <[string]> current-titles:
        root.active-tab == 1 ? root.recent-titles :
        root.active-tab == 2 ? root.saved-titles :
        root.active-tab == 3 ? root.playlist-names :
        root.track-titles;
    property <[string]> current-artists:
        root.active-tab == 1 ? root.recent-artists :
        root.active-tab == 2 ? root.saved-artists :
        root.active-tab == 3 ? root.track-artists :
        root.track-artists;
    property <bool> is-playlist-tab: root.active-tab == 3;

    property <int> track-count: max(1, root.current-titles.length);
    property <string> track-title:
        root.track-index < root.track-count ? root.current-titles[root.track-index] :
        (root.language-index == 2 ? "No tracks" : root.language-index == 3 ? "Aucune piste" : root.language-index == 4 ? "Sin pistas" : "Sem faixas");
    property <string> artist:
        root.track-index < root.current-artists.length ? root.current-artists[root.track-index] : "";

    callback playback-changed(bool);
    callback next();
    callback prev();
    callback back();
    callback select-tab(int);
    callback select-track(int);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // Header
    Rectangle {
        x: 0px; y: 0px; width: 40px; height: 34px;
        border-radius: Theme.radius-s;
        background: bk.pressed ? Theme.panel-elevated : #00000000;
        bk := TouchArea { clicked => { root.back(); } }
        Image { x: 13px; y: 10px; width: 14px; height: 14px; source: @image-url("assets/icons/chevron-left.svg"); image-fit: contain; colorize: Theme.accent; }
    }
    Text {
        x: 40px; y: 4px; width: 240px; height: 26px;
        text: root.title-label;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Tab bar
    HorizontalLayout {
        x: 8px; y: 38px; width: 304px; height: 22px;
        spacing: 4px;
        TabButton { text: "Top"; selected: root.active-tab == 0; tab-color: root.provider-color; clicked => { root.select-tab(0); } }
        TabButton { text: "Recent"; selected: root.active-tab == 1; tab-color: root.provider-color; clicked => { root.select-tab(1); } }
        TabButton { text: "Saved"; selected: root.active-tab == 2; tab-color: root.provider-color; clicked => { root.select-tab(2); } }
        TabButton { text: "Lists"; selected: root.active-tab == 3; tab-color: root.provider-color; clicked => { root.select-tab(3); } }
    }

    // Track list area
    Rectangle {
        x: 8px; y: 64px; width: 304px; height: 120px;
        background: Theme.panel;
        border-radius: Theme.radius-s;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        clip: true;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            for index in min(8, root.track-count):
                TrackRow {
                    index: index;
                    selected: root.track-index == index;
                    is-playlist: root.is-playlist-tab;
                    title: root.current-titles[index];
                    subtitle: root.is-playlist-tab ?
                        (root.playlist-tracks[index] + " tracks") :
                        (index < root.current-artists.length ? root.current-artists[index] : "");
                    clicked => { root.select-track(index); }
                }
        }
    }

    // Mini player at bottom
    Rectangle {
        x: 8px; y: 188px; width: 304px; height: 24px;
        background: Theme.panel-soft;
        border-radius: Theme.radius-s;
        border-width: 1px;
        border-color: Theme.stroke-soft;

        Rectangle {
            x: 4px; y: 4px; width: 16px; height: 16px;
            border-radius: 3px;
            background: root.provider-color;
            Image { x: 3px; y: 3px; width: 10px; height: 10px; source: root.provider-icon; image-fit: contain; colorize: Theme.bg-0; }
        }

        Text {
            x: 24px; y: 4px; width: 180px; height: 16px;
            text: root.track-title;
            color: Theme.text-primary;
            font-size: 9px;
            font-weight: 700;
            overflow: elide;
        }

        HorizontalLayout {
            x: 210px; y: 2px; width: 88px; height: 20px;
            alignment: end;
            spacing: 4px;

            Rectangle {
                width: 20px; height: 20px; border-radius: 10px;
                background: pb.pressed ? Theme.panel-elevated : #00000000;
                pb := TouchArea { clicked => { root.prev(); } }
                Image { x: 4px; y: 4px; width: 12px; height: 12px; source: @image-url("assets/icons/skip-back.svg"); image-fit: contain; colorize: Theme.text-primary; }
            }
            Rectangle {
                width: 20px; height: 20px; border-radius: 10px;
                background: root.provider-color;
                TouchArea {
                    clicked => {
                        root.playing = !root.playing;
                        root.playback-changed(root.playing);
                    }
                }
                Image {
                    visible: root.playing;
                    x: 4px; y: 4px; width: 12px; height: 12px;
                    source: @image-url("assets/icons/pause.svg"); image-fit: contain; colorize: Theme.bg-0;
                }
                Image {
                    visible: !root.playing;
                    x: 4px; y: 4px; width: 12px; height: 12px;
                    source: @image-url("assets/icons/play.svg"); image-fit: contain; colorize: Theme.bg-0;
                }
            }
            Rectangle {
                width: 20px; height: 20px; border-radius: 10px;
                background: nb.pressed ? Theme.panel-elevated : #00000000;
                nb := TouchArea { clicked => { root.next(); } }
                Image { x: 4px; y: 4px; width: 12px; height: 12px; source: @image-url("assets/icons/skip-forward.svg"); image-fit: contain; colorize: Theme.text-primary; }
            }
        }
    }
}
