import { Theme } from "theme.slint";

export struct WifiNetwork { ssid: string, secured: bool, connected: bool }

export component SettingsPanel inherits Rectangle {
    in-out property <bool> wifi-on: true;
    in property <[WifiNetwork]> networks: [
        { ssid: "Casa_Deo", secured: true, connected: true },
        { ssid: "DC_Network", secured: true, connected: false },
        { ssid: "Visitantes", secured: false, connected: false },
    ];
    callback back();
    callback change-passcode();
    callback network-selected(string);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    Rectangle {
        x: 0px; y: 0px; width: 46px; height: 100%;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.stroke;

        for item[index] in [
            @image-url("assets/icons/home.svg"),
            @image-url("assets/icons/music.svg"),
            @image-url("assets/icons/shopping-bag.svg"),
            @image-url("assets/icons/settings.svg")
        ] : Rectangle {
            x: 8px; y: 28px + index * 42px; width: 30px; height: 30px;
            border-radius: Theme.radius-s;
            background: index == 3 ? Theme.accent : #00000000;
            Image {
                x: 7px; y: 7px; width: 16px; height: 16px;
                source: item;
                image-fit: contain;
            }
        }
    }

    Rectangle {
        x: 54px; y: 10px; width: 18px; height: 18px;
        background: #00000000;
        TouchArea { clicked => { root.back(); } }
        Image { x: 1px; y: 1px; width: 16px; height: 16px; source: @image-url("assets/icons/chevron-left.svg"); image-fit: contain; }
    }
    Text {
        x: 0px; y: 10px; width: 100%; height: 18px;
        text: "Definições";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 56px; y: 42px; width: 80px; height: 18px;
        text: "Wi‑Fi";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
    }
    Rectangle {
        x: 264px; y: 42px; width: 42px; height: 22px;
        border-radius: 11px;
        background: root.wifi-on ? Theme.accent : Theme.panel-elevated;
        TouchArea { clicked => { root.wifi-on = !root.wifi-on; } }
        Rectangle {
            x: root.wifi-on ? 22px : 2px; y: 2px; width: 18px; height: 18px;
            border-radius: 9px;
            background: Theme.text-primary;
            animate x { duration: 150ms; easing: ease-in-out; }
        }
    }

    Rectangle { x: 56px; y: 76px; width: 250px; height: 1px; background: Theme.stroke; }
    Text {
        x: 56px; y: 82px; width: 120px; height: 12px;
        text: "Redes disponíveis";
        color: Theme.text-secondary;
        font-size: Theme.font-xs;
    }

    for n[index] in root.networks : Rectangle {
        x: 56px; y: 100px + index * 30px; width: 250px; height: 26px;
        border-radius: Theme.radius-s;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        TouchArea { clicked => { root.network-selected(n.ssid); } }
        Image { x: 8px; y: 5px; width: 15px; height: 15px; source: @image-url("assets/icons/wifi.svg"); image-fit: contain; }
        Text {
            x: 30px; y: 4px; width: 142px; height: 11px;
            text: n.ssid;
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            font-weight: 600;
        }
        Text {
            x: 30px; y: 14px; width: 80px; height: 10px;
            text: n.connected ? "Conectado" : "";
            color: Theme.accent-cyan;
            font-size: 8px;
            font-weight: 700;
        }
        if n.secured: Image {
            x: 224px; y: 5px; width: 14px; height: 14px;
            source: @image-url("assets/icons/lock.svg");
            image-fit: contain;
            opacity: 0.75;
        }
    }

    Rectangle {
        x: 56px; y: 192px; width: 250px; height: 22px;
        border-radius: Theme.radius-s;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        TouchArea { clicked => { root.change-passcode(); } }
        Image { x: 8px; y: 4px; width: 14px; height: 14px; source: @image-url("assets/icons/plus.svg"); image-fit: contain; opacity: 0.75; }
        Text {
            x: 30px; y: 0px; width: 150px; height: 100%;
            text: "Outra rede...";
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
    }
}

export component ChangePasscode inherits Rectangle {
    in-out property <string> current: "";
    in-out property <string> next: "";
    in-out property <string> confirm: "";
    callback back();
    callback save(string, string);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    Rectangle {
        x: 0px; y: 0px; width: 46px; height: 100%;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.stroke;
        for item[index] in [
            @image-url("assets/icons/home.svg"),
            @image-url("assets/icons/music.svg"),
            @image-url("assets/icons/shopping-bag.svg"),
            @image-url("assets/icons/settings.svg")
        ] : Rectangle {
            x: 8px; y: 28px + index * 42px; width: 30px; height: 30px;
            border-radius: Theme.radius-s;
            background: index == 3 ? Theme.accent : #00000000;
            Image { x: 7px; y: 7px; width: 16px; height: 16px; source: item; image-fit: contain; }
        }
    }

    Rectangle {
        x: 54px; y: 10px; width: 18px; height: 18px;
        background: #00000000;
        TouchArea { clicked => { root.back(); } }
        Image { x: 1px; y: 1px; width: 16px; height: 16px; source: @image-url("assets/icons/chevron-left.svg"); image-fit: contain; }
    }
    Text {
        x: 0px; y: 10px; width: 100%; height: 18px;
        text: "Alterar Senha";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    for field[index] in ["Senha atual", "Nova senha", "Confirmar nova senha"] : Text {
        x: 58px; y: 42px + index * 52px; width: 160px; height: 12px;
        text: field;
        color: Theme.text-primary;
        font-size: Theme.font-xs;
        font-weight: 700;
    }

    for mask[index] in ["••••••••", "••••••••", "••••••••"] : Rectangle {
        x: 58px; y: 54px + index * 52px; width: 234px; height: 30px;
        border-radius: Theme.radius-s;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke;
        Text {
            x: 12px; y: 0px; width: 150px; height: 100%;
            text: mask;
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
        if index == 0: Image {
            x: 208px; y: 8px; width: 14px; height: 14px;
            source: @image-url("assets/icons/eye.svg");
            image-fit: contain;
            opacity: 0.75;
        }
    }

    Rectangle {
        x: 58px; y: 182px; width: 234px; height: 26px;
        border-radius: Theme.radius-s;
        background: Theme.accent;
        TouchArea { clicked => { root.save(root.current, root.next); } }
        Text {
            text: "Salvar Alterações";
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
