import { Theme } from "theme.slint";

// Settings — sidebar 45 px + painel Wi-Fi + nova tela Alterar Senha.
export struct WifiNetwork { ssid: string, secured: bool, connected: bool }

export component SettingsPanel inherits Rectangle {
    in-out property <bool> wifi-on: true;
    in property <[WifiNetwork]> networks: [
        { ssid: "Casa_Deo",   secured: true,  connected: true  },
        { ssid: "DC_Network", secured: true,  connected: false },
        { ssid: "Visitantes", secured: false, connected: false },
    ];
    callback back();
    callback change-passcode();
    callback network-selected(string);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // ===== Sidebar =====
    Rectangle {
        x: 0px; y: 0px; width: 45px; height: 100%;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;

        // Item "Definições" ativo (último)
        Rectangle {
            x: 7px; y: 156px; width: 30px; height: 30px;
            border-radius: 6px;
            background: Theme.accent;
            Text {
                text: "\u{2699}";
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // ===== Top bar =====
    Text {
        x: 56px; y: 10px; width: 22px; height: 22px;
        text: "\u{2039}";
        color: Theme.text-primary;
        font-size: 22px;
        font-weight: 700;
        TouchArea { clicked => { root.back(); } }
    }
    Text {
        x: 0px; y: 10px; width: 100%; height: 22px;
        text: "Definições";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // ===== Wi-Fi toggle row =====
    Text {
        x: 56px; y: 42px; width: 80px; height: 20px;
        text: "Wi-Fi";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        vertical-alignment: center;
    }
    Rectangle {
        x: 264px; y: 44px; width: 42px; height: 22px;
        border-radius: 11px;
        background: root.wifi-on ? Theme.accent-hi : Theme.tile-hi;
        TouchArea { clicked => { root.wifi-on = !root.wifi-on; } }
        Rectangle {
            width: 18px; height: 18px;
            x: root.wifi-on ? 22px : 2px; y: 2px;
            border-radius: 9px;
            background: Theme.text-primary;
            animate x { duration: 150ms; easing: ease-in-out; }
        }
    }

    Rectangle { x: 54px; y: 76px; width: 252px; height: 1px; background: Theme.stroke; }
    Text {
        x: 56px; y: 82px; width: 200px; height: 14px;
        text: "Redes disponíveis";
        color: Theme.text-secondary;
        font-size: Theme.font-xs;
    }

    // ===== Lista de redes =====
    for n[index] in root.networks : Rectangle {
        x: 54px; y: 102px + index * 30px; width: 252px; height: 28px;
        border-radius: Theme.radius-s;
        background: Theme.tile;
        TouchArea { clicked => { root.network-selected(n.ssid); } }

        Text { x: 10px; y: 0px; width: 18px; height: 100%;
            text: "\u{25E0}"; color: Theme.accent-2;
            font-size: 14px; font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 32px; y: 4px; width: 160px; height: 13px;
            text: n.ssid; color: Theme.text-primary;
            font-size: Theme.font-sm; font-weight: 600; }
        Text { x: 32px; y: 17px; width: 140px; height: 10px;
            text: n.connected ? "Conectado" : "";
            color: Theme.accent-hi;
            font-size: 8px; font-weight: 700; }
        Text { x: 222px; y: 0px; width: 22px; height: 100%;
            text: n.secured ? "\u{25A1}" : "";
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            horizontal-alignment: center; vertical-alignment: center; }
    }

    Rectangle {
        x: 54px; y: 192px; width: 252px; height: 22px;
        border-radius: Theme.radius-s;
        background: Theme.tile;
        TouchArea { clicked => { root.change-passcode(); } }
        Text { x: 12px; y: 0px; width: 18px; height: 100%;
            text: "+"; color: Theme.text-secondary;
            font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 32px; y: 0px; width: 200px; height: 100%;
            text: "Outra rede..."; color: Theme.text-primary;
            font-size: Theme.font-sm;
            vertical-alignment: center; }
    }
}

// Tela 9 — Alterar Senha (sem sidebar; campos diretos + CTA).
export component ChangePasscode inherits Rectangle {
    in-out property <string> current: "";
    in-out property <string> next:    "";
    in-out property <string> confirm: "";
    callback back();
    callback save(string, string);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // Top bar
    Text {
        x: 12px; y: 10px; width: 22px; height: 22px;
        text: "\u{2039}";
        color: Theme.text-primary;
        font-size: 22px;
        font-weight: 700;
        TouchArea { clicked => { root.back(); } }
    }
    Text {
        x: 0px; y: 10px; width: 100%; height: 22px;
        text: "Alterar Senha";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Campo "Senha atual" + olho
    Text { x: 18px; y: 42px; width: 200px; height: 12px;
        text: "Senha atual"; color: Theme.text-primary;
        font-size: Theme.font-xs; font-weight: 700; }
    Rectangle {
        x: 18px; y: 54px; width: 248px; height: 30px;
        border-radius: 6px;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;
        Text { x: 12px; y: 0px; width: 200px; height: 100%;
            text: "\u{2022}\u{2022}\u{2022}\u{2022}\u{2022}\u{2022}";
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            vertical-alignment: center; }
        Text { x: 218px; y: 0px; width: 22px; height: 100%;
            text: "\u{25CE}"; color: Theme.text-secondary;
            font-size: 14px;
            horizontal-alignment: center; vertical-alignment: center; }
    }

    // "Nova senha"
    Text { x: 18px; y: 96px; width: 200px; height: 12px;
        text: "Nova senha"; color: Theme.text-primary;
        font-size: Theme.font-xs; font-weight: 700; }
    Rectangle {
        x: 18px; y: 108px; width: 248px; height: 30px;
        border-radius: 6px;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;
        Text { x: 12px; y: 0px; width: 220px; height: 100%;
            text: "\u{2022}\u{2022}\u{2022}\u{2022}\u{2022}";
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            vertical-alignment: center; }
    }

    // "Confirmar nova senha"
    Text { x: 18px; y: 150px; width: 200px; height: 12px;
        text: "Confirmar nova senha"; color: Theme.text-primary;
        font-size: Theme.font-xs; font-weight: 700; }
    Rectangle {
        x: 18px; y: 162px; width: 248px; height: 30px;
        border-radius: 6px;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;
        Text { x: 12px; y: 0px; width: 220px; height: 100%;
            text: "\u{2022}\u{2022}\u{2022}\u{2022}\u{2022}";
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            vertical-alignment: center; }
    }

    // CTA "Salvar Alterações"
    Rectangle {
        x: 30px; y: 198px; width: 260px; height: 18px;
        // CTA não cabe em 216 px quando positioned + 30h; ajustar para h=18
    }
}
