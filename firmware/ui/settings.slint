import { Theme } from "theme.slint";

export struct WifiNetwork { ssid: string, secured: bool, connected: bool, signal: int }
export struct BluetoothDevice { address: string, rssi: int }

component SettingsToggle inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in-out property <bool> checked;
    callback changed(bool);

    border-radius: Theme.radius-s;
    background: Theme.panel-soft;
    border-width: 1px;
    border-color: Theme.stroke-soft;
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.changed(root.checked);
        }
    }
    Image { x: 12px; y: 9px; width: 16px; height: 16px; source: root.icon; image-fit: contain; }
    Text {
        x: 40px; y: 0px; width: 150px; height: 100%;
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        vertical-alignment: center;
    }
    Rectangle {
        x: 230px; y: 5px; width: 48px; height: 24px;
        border-radius: 12px;
        background: root.checked ? Theme.accent : Theme.panel-elevated;
        Rectangle {
            x: root.checked ? 25px : 3px; y: 3px; width: 18px; height: 18px;
            border-radius: 9px;
            background: Theme.text-primary;
        }
    }
}

component LocaleRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked();

    border-radius: Theme.radius-s;
    background: Theme.panel-soft;
    border-width: 1px;
    border-color: Theme.stroke-soft;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        x: 12px; y: 6px; width: 120px; height: 12px;
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.font-xs;
    }
    Text {
        x: 12px; y: 20px; width: 220px; height: 16px;
        text: root.value;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
    }
    Image { x: 264px; y: 14px; width: 14px; height: 14px; source: @image-url("assets/icons/chevron-right.svg"); image-fit: contain; }
}

component StepperRow inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in-out property <float> value;
    callback changed(float);

    border-radius: Theme.radius-s;
    background: Theme.panel-soft;
    border-width: 1px;
    border-color: Theme.stroke-soft;
    Image { x: 12px; y: 14px; width: 16px; height: 16px; source: root.icon; image-fit: contain; }
    Text {
        x: 38px; y: 6px; width: 90px; height: 12px;
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.font-sm;
        font-weight: 700;
    }
    Text {
        x: 232px; y: 6px; width: 44px; height: 12px;
        text: Math.round(root.value * 100) + "%";
        color: Theme.text-secondary;
        font-size: Theme.font-xs;
        horizontal-alignment: right;
    }
    Rectangle {
        x: 38px; y: 26px; width: 148px; height: 4px;
        border-radius: 2px;
        background: Theme.bg-2;
        Rectangle {
            width: parent.width * root.value; height: 100%;
            border-radius: 2px;
            background: Theme.accent-blue;
        }
        Rectangle {
            x: parent.width * root.value - 5px; y: -3px;
            width: 10px; height: 10px;
            border-radius: 5px;
            background: Theme.text-primary;
        }
        TouchArea {
            clicked => {
                root.value = max(0.0, min(1.0, self.mouse-x / parent.width));
                root.changed(root.value);
            }
            moved => {
                if (self.pressed) {
                    root.value = max(0.0, min(1.0, self.mouse-x / parent.width));
                    root.changed(root.value);
                }
            }
        }
    }
    Rectangle {
        x: 200px; y: 15px; width: 34px; height: 24px;
        border-radius: Theme.radius-s;
        background: Theme.panel-elevated;
        TouchArea {
            clicked => {
                root.value = max(0.0, root.value - 0.10);
                root.changed(root.value);
            }
        }
        Text { text: "-"; color: Theme.text-primary; font-size: Theme.font-lg; horizontal-alignment: center; vertical-alignment: center; }
    }
    Rectangle {
        x: 242px; y: 15px; width: 34px; height: 24px;
        border-radius: Theme.radius-s;
        background: Theme.accent;
        TouchArea {
            clicked => {
                root.value = min(1.0, root.value + 0.10);
                root.changed(root.value);
            }
        }
        Text { text: "+"; color: Theme.text-primary; font-size: Theme.font-lg; horizontal-alignment: center; vertical-alignment: center; }
    }
}

component PasswordKey inherits Rectangle {
    in property <string> label;
    in-out property <string> password;

    border-radius: Theme.radius-s;
    background: Theme.panel-soft;
    border-width: 1px;
    border-color: Theme.stroke-soft;
    TouchArea { clicked => { root.password = root.password + root.label; } }
    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.font-xs;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component PasswordKeyRow inherits HorizontalLayout {
    in property <[string]> keys;
    in-out property <string> password;

    spacing: 4px;
    for key in root.keys : PasswordKey {
        width: 32px;
        height: 24px;
        label: key;
        password <=> root.password;
    }
}

component PasswordAction inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();

    border-radius: Theme.radius-s;
    background: root.primary ? Theme.accent : Theme.panel-elevated;
    border-width: 1px;
    border-color: root.primary ? Theme.accent-hi : Theme.stroke-soft;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component WifiPasswordDialog inherits Rectangle {
    in-out property <string> ssid;
    in-out property <string> password;
    in-out property <int> keyboard-mode: 0;
    callback connect(string, string);
    callback cancel();

    background: #03050EDD;

    Rectangle {
        x: 8px; y: 8px; width: 304px; height: 200px;
        border-radius: Theme.radius-m;
        background: Theme.bg-1;
        border-width: 1px;
        border-color: Theme.stroke;

        Text {
            x: 14px; y: 10px; width: 276px; height: 16px;
            text: "Senha Wi-Fi";
            color: Theme.text-primary;
            font-size: Theme.font-md;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            x: 14px; y: 28px; width: 276px; height: 12px;
            text: root.ssid;
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            horizontal-alignment: center;
            overflow: elide;
        }
        Rectangle {
            x: 14px; y: 45px; width: 276px; height: 24px;
            border-radius: Theme.radius-s;
            background: Theme.panel-soft;
            border-width: 1px;
            border-color: Theme.stroke-soft;
            Text {
                x: 10px; y: 0px; width: 256px; height: 100%;
                text: root.password == "" ? "Inserir senha" : root.password;
                color: root.password == "" ? Theme.text-muted : Theme.text-primary;
                font-size: Theme.font-xs;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.keyboard-mode == 0: Rectangle {
            x: 10px; y: 76px; width: 284px; height: 100px; background: #00000000;
            PasswordKeyRow { x: 0px; y: 0px; width: 284px; height: 24px; keys: ["a","b","c","d","e","f","g","h"]; password <=> root.password; }
            PasswordKeyRow { x: 0px; y: 26px; width: 284px; height: 24px; keys: ["i","j","k","l","m","n","o","p"]; password <=> root.password; }
            PasswordKeyRow { x: 0px; y: 52px; width: 284px; height: 24px; keys: ["q","r","s","t","u","v","w","x"]; password <=> root.password; }
            PasswordKeyRow { x: 0px; y: 78px; width: 284px; height: 24px; keys: ["y","z","0","1","2","3","4","5"]; password <=> root.password; }
        }
        if root.keyboard-mode == 1: Rectangle {
            x: 10px; y: 76px; width: 284px; height: 100px; background: #00000000;
            PasswordKeyRow { x: 0px; y: 0px; width: 284px; height: 24px; keys: ["A","B","C","D","E","F","G","H"]; password <=> root.password; }
            PasswordKeyRow { x: 0px; y: 26px; width: 284px; height: 24px; keys: ["I","J","K","L","M","N","O","P"]; password <=> root.password; }
            PasswordKeyRow { x: 0px; y: 52px; width: 284px; height: 24px; keys: ["Q","R","S","T","U","V","W","X"]; password <=> root.password; }
            PasswordKeyRow { x: 0px; y: 78px; width: 284px; height: 24px; keys: ["Y","Z","6","7","8","9","-","_"]; password <=> root.password; }
        }
        if root.keyboard-mode == 2: Rectangle {
            x: 10px; y: 76px; width: 284px; height: 100px; background: #00000000;
            PasswordKeyRow { x: 0px; y: 0px; width: 284px; height: 24px; keys: ["0","1","2","3","4","5","6","7"]; password <=> root.password; }
            PasswordKeyRow { x: 0px; y: 26px; width: 284px; height: 24px; keys: ["8","9","@","#","$","%","&","!"]; password <=> root.password; }
            PasswordKeyRow { x: 0px; y: 52px; width: 284px; height: 24px; keys: ["?","-","_","+",".","/","*","="]; password <=> root.password; }
            PasswordKeyRow { x: 0px; y: 78px; width: 284px; height: 24px; keys: [":",";","(",")","[","]","{","}"]; password <=> root.password; }
        }

        PasswordAction { x: 14px; y: 176px; width: 50px; height: 18px; label: root.keyboard-mode == 0 ? "ABC" : root.keyboard-mode == 1 ? "123" : "abc"; clicked => { root.keyboard-mode = root.keyboard-mode == 2 ? 0 : root.keyboard-mode + 1; } }
        PasswordAction { x: 70px; y: 176px; width: 54px; height: 18px; label: "Limpar"; clicked => { root.password = ""; } }
        PasswordAction { x: 130px; y: 176px; width: 70px; height: 18px; label: "Cancelar"; clicked => { root.cancel(); } }
        PasswordAction { x: 206px; y: 176px; width: 84px; height: 18px; label: "Ligar"; primary: root.password != ""; clicked => { if (root.password != "") { root.connect(root.ssid, root.password); } } }
    }
}

export component SettingsPanel inherits Rectangle {
    in-out property <int> page: 0;
    in-out property <bool> wifi-on: true;
    in-out property <bool> bluetooth-on: false;
    in-out property <float> volume: 0.75;
    in-out property <float> brightness: 0.60;
    in-out property <int> region-index: 0;
    in-out property <int> language-index: 0;
    in-out property <bool> wifi-password-open: false;
    in-out property <string> selected-ssid: "";
    in-out property <string> wifi-password: "";
    in-out property <int> wifi-keyboard-mode: 0;
    in-out property <bool> swipe-locked: false;

    property <string> region-label:
        root.region-index == 0 ? "Brasil" :
        root.region-index == 1 ? "Portugal" :
        root.region-index == 2 ? "Angola" :
        root.region-index == 3 ? "Mocambique" : "Estados Unidos";
    property <string> language-label:
        root.language-index == 0 ? "Portugues (Brasil)" :
        root.language-index == 1 ? "Portugues (Portugal)" :
        root.language-index == 2 ? "English" :
        root.language-index == 3 ? "Francais" : "Espanol";

    in property <[WifiNetwork]> networks: [];
    in property <[BluetoothDevice]> bluetooth-devices: [];

    callback back();
    callback scan-wifi-networks();
    callback change-passcode();
    callback network-selected(string, string);
    callback wifi-changed(bool);
    callback bluetooth-changed(bool);
    callback locale-changed(int, int);
    callback volume-changed(float);
    callback brightness-changed(float);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;
    clip: true;

    function open-page(next-page: int) {
        root.page = max(0, min(5, next-page));
        if (root.page == 1) { root.scan-wifi-networks(); }
    }

    swipe-lock-timer := Timer {
        interval: 260ms;
        running: false;
        triggered() => {
            root.swipe-locked = false;
            self.running = false;
        }
    }

    TouchArea {
        x: 0px; y: 36px; width: 320px; height: 180px;
        moved => {
            if (!root.wifi-password-open && !root.swipe-locked) {
                if (self.mouse-x - self.pressed-x > 64px) {
                    if (root.page > 0) { root.open-page(root.page - 1); }
                    root.swipe-locked = true;
                    swipe-lock-timer.running = true;
                } else if (self.pressed-x - self.mouse-x > 64px) {
                    if (root.page < 5) { root.open-page(root.page + 1); }
                    root.swipe-locked = true;
                    swipe-lock-timer.running = true;
                }
            }
        }
    }

    Rectangle {
        x: 0px; y: 0px; width: 46px; height: 36px;
        background: #00000000;
        TouchArea {
            clicked => {
                if (root.page == 0) { root.back(); }
                else { root.page = 0; }
            }
        }
        Image { x: 14px; y: 10px; width: 16px; height: 16px; source: @image-url("assets/icons/chevron-left.svg"); image-fit: contain; }
    }

    Text {
        x: 0px; y: 10px; width: 100%; height: 18px;
        text: root.page == 0 ? "Definicoes" :
              root.page == 1 ? "Conexoes" :
              root.page == 2 ? "Seguranca" :
              root.page == 3 ? "Idioma e Regiao" :
              root.page == 4 ? "Som e Ecra" : "Sistema";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.page == 0: Rectangle {
        x: 14px; y: 42px; width: 292px; height: 162px;
        background: #00000000;
        for item[index] in [
            { title: "Conexoes", detail: root.wifi-on ? "Wi-Fi ligado" : "Wi-Fi desligado", icon: @image-url("assets/icons/wifi.svg") },
            { title: "Seguranca", detail: "PIN e protecao", icon: @image-url("assets/icons/lock.svg") },
            { title: "Idioma e Regiao", detail: root.region-label, icon: @image-url("assets/icons/message-circle.svg") },
            { title: "Som e Ecra", detail: "Volume e brilho", icon: @image-url("assets/icons/sun.svg") },
            { title: "Sistema", detail: "Estado do DC OS", icon: @image-url("assets/icons/settings.svg") },
        ] : Rectangle {
            x: 0px; y: index * 32px; width: 292px; height: 28px;
            border-radius: Theme.radius-s;
            background: Theme.panel-soft;
            border-width: 1px;
            border-color: Theme.stroke-soft;
            TouchArea {
                clicked => {
                    root.open-page(index + 1);
                }
            }
            Image { x: 10px; y: 7px; width: 14px; height: 14px; source: item.icon; image-fit: contain; }
            Text { x: 34px; y: 3px; width: 150px; height: 11px; text: item.title; color: Theme.text-primary; font-size: Theme.font-sm; font-weight: 700; }
            Text { x: 34px; y: 15px; width: 170px; height: 10px; text: item.detail; color: Theme.text-secondary; font-size: 8px; }
            Image { x: 268px; y: 7px; width: 14px; height: 14px; source: @image-url("assets/icons/chevron-right.svg"); image-fit: contain; }
        }
    }

    if root.page == 1: Rectangle {
        x: 14px; y: 42px; width: 292px; height: 162px;
        background: #00000000;
        SettingsToggle {
            x: 0px; y: 0px; width: 292px; height: 32px;
            label: "Wi-Fi"; icon: @image-url("assets/icons/wifi.svg"); checked <=> root.wifi-on;
            changed(on) => {
                root.wifi-changed(on);
                if (on) { root.scan-wifi-networks(); }
            }
        }
        SettingsToggle { x: 0px; y: 36px; width: 292px; height: 32px; label: "Bluetooth"; icon: @image-url("assets/icons/bluetooth.svg"); checked <=> root.bluetooth-on; changed(on) => { root.bluetooth-changed(on); } }
        Text { x: 0px; y: 76px; width: 130px; height: 12px; text: "Redes disponiveis"; color: Theme.text-secondary; font-size: Theme.font-xs; }
        Text {
            x: 138px; y: 76px; width: 104px; height: 12px;
            text: root.bluetooth-on ? "BLE ligado" : "BLE desligado";
            color: root.bluetooth-on ? Theme.accent-cyan : Theme.text-muted;
            font-size: Theme.font-xs;
            horizontal-alignment: right;
        }
        Rectangle {
            x: 252px; y: 72px; width: 40px; height: 22px;
            border-radius: Theme.radius-s;
            background: Theme.panel-soft;
            border-width: 1px;
            border-color: Theme.stroke-soft;
            TouchArea { clicked => { root.scan-wifi-networks(); } }
            Image { x: 12px; y: 3px; width: 16px; height: 16px; source: @image-url("assets/icons/rotate-cw.svg"); image-fit: contain; }
        }
        if !root.wifi-on: Text {
            x: 0px; y: 108px; width: 292px; height: 28px;
            text: "Wi-Fi desligado";
            color: Theme.text-muted;
            font-size: Theme.font-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.wifi-on && root.networks.length == 0: Text {
            x: 0px; y: 108px; width: 292px; height: 28px;
            text: "A procurar redes...";
            color: Theme.text-muted;
            font-size: Theme.font-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        for n[index] in root.networks : Rectangle {
            x: 0px; y: 98px + index * 26px; width: 292px; height: 24px;
            border-radius: Theme.radius-s;
            background: Theme.panel-soft;
            border-width: 1px;
            border-color: Theme.stroke-soft;
            TouchArea {
                clicked => {
                    root.wifi-on = true;
                    if (n.secured) {
                        root.selected-ssid = n.ssid;
                        root.wifi-password = "";
                        root.wifi-keyboard-mode = 0;
                        root.wifi-password-open = true;
                    } else {
                        root.network-selected(n.ssid, "");
                    }
                }
            }
            Image { x: 10px; y: 5px; width: 14px; height: 14px; source: @image-url("assets/icons/wifi.svg"); image-fit: contain; }
            Text { x: 34px; y: 3px; width: 158px; height: 11px; text: n.ssid; color: Theme.text-primary; font-size: Theme.font-sm; font-weight: 600; }
            Text { x: 34px; y: 14px; width: 80px; height: 9px; text: n.connected ? "Conectado" : ""; color: Theme.accent-cyan; font-size: 8px; }
            Text { x: 200px; y: 7px; width: 48px; height: 10px; text: n.signal + " dBm"; color: Theme.text-muted; font-size: 8px; horizontal-alignment: right; }
            if n.secured: Image { x: 262px; y: 5px; width: 14px; height: 14px; source: @image-url("assets/icons/lock.svg"); image-fit: contain; }
        }
    }

    if root.page == 2: Rectangle {
        x: 14px; y: 46px; width: 292px; height: 80px;
        border-radius: Theme.radius-s;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        TouchArea { clicked => { root.change-passcode(); } }
        Image { x: 12px; y: 14px; width: 18px; height: 18px; source: @image-url("assets/icons/lock.svg"); image-fit: contain; }
        Text { x: 42px; y: 12px; width: 170px; height: 14px; text: "Alterar PIN"; color: Theme.text-primary; font-size: Theme.font-md; font-weight: 700; }
        Text { x: 42px; y: 32px; width: 210px; height: 28px; text: "Define uma nova senha de 5 digitos para proteger o assistente."; color: Theme.text-secondary; font-size: Theme.font-xs; wrap: word-wrap; }
        Image { x: 264px; y: 32px; width: 14px; height: 14px; source: @image-url("assets/icons/chevron-right.svg"); image-fit: contain; }
    }

    if root.page == 3: Rectangle {
        x: 14px; y: 44px; width: 292px; height: 136px;
        background: #00000000;
        LocaleRow {
            x: 0px; y: 0px; width: 292px; height: 42px;
            label: "Regiao"; value: root.region-label;
            clicked => { root.region-index = root.region-index == 4 ? 0 : root.region-index + 1; root.locale-changed(root.region-index, root.language-index); }
        }
        LocaleRow {
            x: 0px; y: 52px; width: 292px; height: 42px;
            label: "Idioma"; value: root.language-label;
            clicked => { root.language-index = root.language-index == 4 ? 0 : root.language-index + 1; root.locale-changed(root.region-index, root.language-index); }
        }
        Text { x: 4px; y: 108px; width: 284px; height: 24px; text: "Toque em cada linha para percorrer 5 opcoes."; color: Theme.text-muted; font-size: Theme.font-xs; horizontal-alignment: center; vertical-alignment: center; }
    }

    if root.page == 4: Rectangle {
        x: 14px; y: 44px; width: 292px; height: 116px;
        background: #00000000;
        StepperRow { x: 0px; y: 0px; width: 292px; height: 44px; label: "Volume"; icon: @image-url("assets/icons/volume-2.svg"); value <=> root.volume; changed(v) => { root.volume-changed(v); } }
        StepperRow { x: 0px; y: 58px; width: 292px; height: 44px; label: "Brilho"; icon: @image-url("assets/icons/sun.svg"); value <=> root.brightness; changed(v) => { root.brightness-changed(v); } }
    }

    if root.page == 5: Rectangle {
        x: 14px; y: 52px; width: 292px; height: 86px;
        border-radius: Theme.radius-s;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        Text { x: 14px; y: 12px; width: 260px; height: 16px; text: "DC OS"; color: Theme.text-primary; font-size: Theme.font-md; font-weight: 700; }
        Text { x: 14px; y: 34px; width: 260px; height: 38px; text: "Firmware ESP32-S3 com Slint, Wi-Fi, SNTP, NVS e API local."; color: Theme.text-secondary; font-size: Theme.font-xs; wrap: word-wrap; }
    }

    if root.wifi-password-open: WifiPasswordDialog {
        x: 0px; y: 0px; width: 320px; height: 216px;
        ssid <=> root.selected-ssid;
        password <=> root.wifi-password;
        keyboard-mode <=> root.wifi-keyboard-mode;
        cancel => {
            root.wifi-password-open = false;
            root.wifi-password = "";
        }
        connect(ssid, password) => {
            root.wifi-password-open = false;
            root.network-selected(ssid, password);
        }
    }
}

export component ChangePasscode inherits Rectangle {
    in-out property <string> d0: "";
    in-out property <string> d1: "";
    in-out property <string> d2: "";
    in-out property <string> d3: "";
    in-out property <string> d4: "";
    in-out property <int> filled: 0;
    property <int> pin-length: 5;
    property <string> passcode-str: root.d0 + root.d1 + root.d2 + root.d3 + root.d4;
    callback back();
    callback save(string);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    Rectangle { x: 0px; y: 0px; width: 46px; height: 36px; background: #00000000; TouchArea { clicked => { root.back(); } } Image { x: 14px; y: 10px; width: 16px; height: 16px; source: @image-url("assets/icons/chevron-left.svg"); image-fit: contain; } }
    Text { x: 0px; y: 10px; width: 100%; height: 18px; text: "Alterar PIN"; color: Theme.text-primary; font-size: Theme.font-md; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    Text { x: 58px; y: 36px; width: 204px; height: 16px; text: "Novo PIN de 5 digitos"; color: Theme.text-secondary; font-size: Theme.font-xs; horizontal-alignment: center; vertical-alignment: center; }

    HorizontalLayout {
        x: 124px; y: 58px; width: 72px; height: 10px;
        spacing: 7px;
        for i in root.pin-length: Rectangle {
            width: 10px; height: 10px;
            border-radius: 5px;
            background: i < root.filled ? Theme.accent : #00000000;
            border-width: 1px;
            border-color: i < root.filled ? Theme.accent-hi : Theme.text-muted;
        }
    }

    for row[index] in [[ "1","2","3","4","5" ], [ "6","7","8","9","0" ]] : HorizontalLayout {
        x: 58px; y: 80px + index * 42px; width: 234px; height: 34px;
        spacing: 6px;
        for k in row : Rectangle {
            width: 42px; height: 34px;
            border-radius: Theme.radius-s;
            background: Theme.panel-soft;
            border-width: 1px;
            border-color: Theme.stroke;
            TouchArea {
                clicked => {
                    if (root.filled < root.pin-length) {
                        if      (root.filled == 0) { root.d0 = k; }
                        else if (root.filled == 1) { root.d1 = k; }
                        else if (root.filled == 2) { root.d2 = k; }
                        else if (root.filled == 3) { root.d3 = k; }
                        else if (root.filled == 4) { root.d4 = k; }
                        root.filled = root.filled + 1;
                    }
                }
            }
            Text { text: k; color: Theme.text-primary; font-size: Theme.font-md; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        }
    }

    Rectangle {
        x: 58px; y: 166px; width: 58px; height: 34px;
        border-radius: Theme.radius-s;
        background: root.filled > 0 ? Theme.panel-elevated : Theme.panel-soft;
        border-width: 1px;
        border-color: root.filled > 0 ? Theme.stroke : Theme.text-dim;
        TouchArea {
            clicked => {
                if (root.filled > 0) {
                    root.filled = root.filled - 1;
                    if      (root.filled == 0) { root.d0 = ""; }
                    else if (root.filled == 1) { root.d1 = ""; }
                    else if (root.filled == 2) { root.d2 = ""; }
                    else if (root.filled == 3) { root.d3 = ""; }
                    else if (root.filled == 4) { root.d4 = ""; }
                }
            }
        }
        Image { x: 19px; y: 9px; width: 20px; height: 16px; source: @image-url("assets/icons/delete-left.svg"); image-fit: contain; }
    }

    Rectangle {
        x: 126px; y: 166px; width: 166px; height: 34px;
        border-radius: Theme.radius-s;
        background: root.filled == root.pin-length ? Theme.accent : Theme.accent-deep;
        border-width: 1px;
        border-color: root.filled == root.pin-length ? Theme.accent-hi : Theme.stroke;
        TouchArea { clicked => { if (root.filled == root.pin-length) { root.save(root.passcode-str); } } }
        Text { text: "Guardar PIN"; color: Theme.text-primary; font-size: Theme.font-sm; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
}
