import { Theme } from "theme.slint";

export struct WifiNetwork { ssid: string, secured: bool, connected: bool, signal: int }
export struct BluetoothDevice { address: string, rssi: int }

// =====================================================
// TOGGLE de definicoes (linha com icone + label + switch)
// =====================================================
component SettingsToggle inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in-out property <bool> checked;
    callback changed(bool);

    border-radius: Theme.radius-m;
    background: t.pressed ? Theme.panel-elevated : Theme.panel-soft;
    border-width: 1px;
    border-color: root.checked ? Theme.accent-deep : Theme.stroke-soft;
    animate background { duration: 120ms; }

    t := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.changed(root.checked);
        }
    }

    // Chip de icone
    Rectangle {
        x: 8px; y: 7px; width: 26px; height: 26px;
        border-radius: 8px;
        background: root.checked ? Theme.accent-deep : Theme.bg-2;
        Image {
            x: 6px; y: 6px; width: 14px; height: 14px;
            source: root.icon; image-fit: contain;
            colorize: root.checked ? Theme.accent-hi : Theme.text-secondary;
        }
    }
    Text {
        x: 44px; y: 0px; width: 150px; height: 100%;
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        vertical-alignment: center;
    }
    // Switch
    Rectangle {
        x: 246px; y: 8px; width: 46px; height: 24px;
        border-radius: 12px;
        background: root.checked ? Theme.accent : Theme.bg-2;
        border-width: 1px;
        border-color: root.checked ? Theme.accent-hi : Theme.stroke;
        animate background { duration: 150ms; }
        Rectangle {
            x: root.checked ? 24px : 3px; y: 3px; width: 18px; height: 18px;
            border-radius: 9px;
            background: root.checked ? Theme.bg-0 : Theme.text-secondary;
            animate x { duration: 150ms; easing: ease-out; }
        }
    }
}

// =====================================================
// Linha de regiao / idioma (label pequeno + valor + chevron)
// =====================================================
component LocaleRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <image> icon;
    callback clicked();

    border-radius: Theme.radius-m;
    background: t.pressed ? Theme.panel-elevated : Theme.panel-soft;
    border-width: 1px;
    border-color: Theme.stroke-soft;
    animate background { duration: 120ms; }
    t := TouchArea { clicked => { root.clicked(); } }

    Rectangle {
        x: 8px; y: 9px; width: 26px; height: 26px;
        border-radius: 8px;
        background: Theme.bg-2;
        Image {
            x: 6px; y: 6px; width: 14px; height: 14px;
            source: root.icon; image-fit: contain;
            colorize: Theme.accent;
        }
    }
    Text {
        x: 44px; y: 7px; width: 200px; height: 12px;
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.font-xs;
        font-weight: 600;
    }
    Text {
        x: 44px; y: 21px; width: 210px; height: 16px;
        text: root.value;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        overflow: elide;
    }
    Text {
        x: 268px; y: 0px; width: 20px; height: 100%;
        text: ">";
        color: Theme.text-muted;
        font-size: Theme.font-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// =====================================================
// Linha de stepper/slider (Volume, Brilho)
// =====================================================
component StepperRow inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in-out property <float> value;
    callback changed(float);

    border-radius: Theme.radius-m;
    background: Theme.panel-soft;
    border-width: 1px;
    border-color: Theme.stroke-soft;

    Rectangle {
        x: 10px; y: 15px; width: 26px; height: 26px;
        border-radius: 8px;
        background: Theme.bg-2;
        Image {
            x: 6px; y: 6px; width: 14px; height: 14px;
            source: root.icon; image-fit: contain;
            colorize: Theme.accent;
        }
    }
    Text {
        x: 44px; y: 9px; width: 120px; height: 14px;
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
    }
    Text {
        x: 236px; y: 9px; width: 40px; height: 14px;
        text: Math.round(root.value * 100) + "%";
        color: Theme.accent;
        font-size: Theme.font-sm;
        font-weight: 700;
        horizontal-alignment: right;
    }

    // Trilha do slider
    Rectangle {
        x: 44px; y: 32px; width: 136px; height: 6px;
        border-radius: 3px;
        background: Theme.bg-2;
        Rectangle {
            width: max(6px, parent.width * root.value); height: 100%;
            border-radius: 3px;
            background: Theme.accent;
        }
        Rectangle {
            x: max(0px, parent.width * root.value - 6px); y: -3px;
            width: 12px; height: 12px;
            border-radius: 6px;
            background: Theme.text-primary;
            border-width: 2px;
            border-color: Theme.accent;
        }
        TouchArea {
            clicked => {
                root.value = max(0.0, min(1.0, self.mouse-x / parent.width));
                root.changed(root.value);
            }
            moved => {
                if (self.pressed) {
                    root.value = max(0.0, min(1.0, self.mouse-x / parent.width));
                    root.changed(root.value);
                }
            }
        }
    }

    // Botao menos
    Rectangle {
        x: 194px; y: 24px; width: 34px; height: 24px;
        border-radius: Theme.radius-s;
        background: tm.pressed ? Theme.panel-elevated : Theme.bg-2;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        tm := TouchArea {
            clicked => {
                root.value = max(0.0, root.value - 0.10);
                root.changed(root.value);
            }
        }
        Text { text: "-"; color: Theme.text-primary; font-size: Theme.font-lg; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
    // Botao mais
    Rectangle {
        x: 238px; y: 24px; width: 34px; height: 24px;
        border-radius: Theme.radius-s;
        background: tp.pressed ? Theme.accent-deep : Theme.accent;
        tp := TouchArea {
            clicked => {
                root.value = min(1.0, root.value + 0.10);
                root.changed(root.value);
            }
        }
        Text { text: "+"; color: Theme.bg-0; font-size: Theme.font-lg; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// =====================================================
// Teclado Wi-Fi — tecla individual
// =====================================================
component PasswordKey inherits Rectangle {
    in property <string> label;
    callback pressed(string);

    border-radius: Theme.radius-xs;
    background: t.pressed ? Theme.accent : Theme.panel-elevated;
    border-width: 1px;
    border-color: t.pressed ? Theme.accent-hi : Theme.stroke-soft;
    t := TouchArea { clicked => { root.pressed(root.label); } }
    Text {
        text: root.label;
        color: t.pressed ? Theme.bg-0 : Theme.text-primary;
        font-size: Theme.font-sm;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component PasswordKeyRow inherits HorizontalLayout {
    in property <[string]> keys;
    callback pressed(string);
    spacing: 4px;
    for key in root.keys : PasswordKey {
        width: 32px;
        height: 24px;
        label: key;
        pressed(value) => { root.pressed(value); }
    }
}

component PasswordAction inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> primary: false;
    callback clicked();

    border-radius: Theme.radius-s;
    background: t.pressed ? Theme.accent-hi : (root.primary ? Theme.accent : Theme.panel-elevated);
    border-width: 1px;
    border-color: root.primary ? Theme.accent-hi : Theme.stroke-soft;
    t := TouchArea { clicked => { root.clicked(); } }
    if root.icon.width == 0: Text {
        text: root.label;
        color: root.primary ? Theme.bg-0 : Theme.text-primary;
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon.width > 0: Image {
        width: 14px; height: 14px;
        source: root.icon;
        image-fit: contain;
        colorize: root.primary ? Theme.bg-0 : Theme.text-primary;
    }
}

// =====================================================
// Dialog de senha Wi-Fi
// =====================================================
component WifiPasswordDialog inherits Rectangle {
    in-out property <string> ssid;
    in-out property <string> password;
    in-out property <int> keyboard-mode: 0;
    in-out property <bool> keyboard-collapsed: false;
    in-out property <int> filled: 0;
    in-out property <string> p0: "";
    in-out property <string> p1: "";
    in-out property <string> p2: "";
    in-out property <string> p3: "";
    in-out property <string> p4: "";
    in-out property <string> p5: "";
    in-out property <string> p6: "";
    in-out property <string> p7: "";
    in-out property <string> p8: "";
    in-out property <string> p9: "";
    in-out property <string> p10: "";
    in-out property <string> p11: "";
    in-out property <string> p12: "";
    in-out property <string> p13: "";
    in-out property <string> p14: "";
    in-out property <string> p15: "";
    property <string> password-str: root.p0 + root.p1 + root.p2 + root.p3 + root.p4 + root.p5 + root.p6 + root.p7 + root.p8 + root.p9 + root.p10 + root.p11 + root.p12 + root.p13 + root.p14 + root.p15;
    callback connect(string, string);
    callback cancel();
    callback backspace();

    background: #04070EE0;

    TouchArea { x: 0px; y: 0px; width: 100%; height: 100%; clicked => { } }

    function append-key(value: string) {
        if (root.filled < 16) {
            if      (root.filled == 0) { root.p0 = value; }
            else if (root.filled == 1) { root.p1 = value; }
            else if (root.filled == 2) { root.p2 = value; }
            else if (root.filled == 3) { root.p3 = value; }
            else if (root.filled == 4) { root.p4 = value; }
            else if (root.filled == 5) { root.p5 = value; }
            else if (root.filled == 6) { root.p6 = value; }
            else if (root.filled == 7) { root.p7 = value; }
            else if (root.filled == 8) { root.p8 = value; }
            else if (root.filled == 9) { root.p9 = value; }
            else if (root.filled == 10) { root.p10 = value; }
            else if (root.filled == 11) { root.p11 = value; }
            else if (root.filled == 12) { root.p12 = value; }
            else if (root.filled == 13) { root.p13 = value; }
            else if (root.filled == 14) { root.p14 = value; }
            else if (root.filled == 15) { root.p15 = value; }
            root.filled = root.filled + 1;
            root.password = root.password-str;
        }
    }

    function clear-password() {
        root.p0 = ""; root.p1 = ""; root.p2 = ""; root.p3 = "";
        root.p4 = ""; root.p5 = ""; root.p6 = ""; root.p7 = "";
        root.p8 = ""; root.p9 = ""; root.p10 = ""; root.p11 = "";
        root.p12 = ""; root.p13 = ""; root.p14 = ""; root.p15 = "";
        root.filled = 0;
        root.password = "";
    }

    function delete-key() {
        if (root.filled > 0) {
            if      (root.filled == 1) { root.p0 = ""; }
            else if (root.filled == 2) { root.p1 = ""; }
            else if (root.filled == 3) { root.p2 = ""; }
            else if (root.filled == 4) { root.p3 = ""; }
            else if (root.filled == 5) { root.p4 = ""; }
            else if (root.filled == 6) { root.p5 = ""; }
            else if (root.filled == 7) { root.p6 = ""; }
            else if (root.filled == 8) { root.p7 = ""; }
            else if (root.filled == 9) { root.p8 = ""; }
            else if (root.filled == 10) { root.p9 = ""; }
            else if (root.filled == 11) { root.p10 = ""; }
            else if (root.filled == 12) { root.p11 = ""; }
            else if (root.filled == 13) { root.p12 = ""; }
            else if (root.filled == 14) { root.p13 = ""; }
            else if (root.filled == 15) { root.p14 = ""; }
            else if (root.filled == 16) { root.p15 = ""; }
            root.filled = root.filled - 1;
            root.password = root.password-str;
        }
    }

    Rectangle {
        x: 8px; y: 6px; width: 304px; height: 204px;
        border-radius: Theme.radius-m;
        background: Theme.bg-1;
        border-width: 1px;
        border-color: Theme.stroke;

        // Cabecalho
        Rectangle {
            x: 10px; y: 8px; width: 22px; height: 22px;
            border-radius: 7px;
            background: Theme.accent-deep;
            Image {
                x: 4px; y: 4px; width: 14px; height: 14px;
                source: @image-url("assets/icons/wifi.svg"); image-fit: contain;
                colorize: Theme.accent-hi;
            }
        }
        Text {
            x: 40px; y: 8px; width: 254px; height: 12px;
            text: "Senha Wi-Fi";
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            font-weight: 700;
        }
        Text {
            x: 40px; y: 20px; width: 254px; height: 12px;
            text: root.ssid;
            color: Theme.accent;
            font-size: Theme.font-xs;
            overflow: elide;
        }

        // Campo password
        Rectangle {
            x: 10px; y: 36px; width: 284px; height: 26px;
            border-radius: Theme.radius-s;
            background: Theme.bg-0;
            border-width: 1px;
            border-color: root.password-str == "" ? Theme.stroke-soft : Theme.accent-deep;
            Text {
                x: 10px; y: 0px; width: 264px; height: 100%;
                text: root.password-str == "" ? "Digite a senha..." : root.password-str;
                color: root.password-str == "" ? Theme.text-muted : Theme.accent-cyan;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if !root.keyboard-collapsed && root.keyboard-mode == 0: Rectangle {
            x: 10px; y: 68px; width: 284px; height: 104px; background: #00000000;
            PasswordKeyRow { x: 0px; y: 0px; width: 284px; height: 24px; keys: ["a","b","c","d","e","f","g","h"]; pressed(value) => { root.append-key(value); } }
            PasswordKeyRow { x: 0px; y: 27px; width: 284px; height: 24px; keys: ["i","j","k","l","m","n","o","p"]; pressed(value) => { root.append-key(value); } }
            PasswordKeyRow { x: 0px; y: 54px; width: 284px; height: 24px; keys: ["q","r","s","t","u","v","w","x"]; pressed(value) => { root.append-key(value); } }
            PasswordKeyRow { x: 0px; y: 81px; width: 284px; height: 24px; keys: ["y","z","0","1","2","3","4","5"]; pressed(value) => { root.append-key(value); } }
        }
        if !root.keyboard-collapsed && root.keyboard-mode == 1: Rectangle {
            x: 10px; y: 68px; width: 284px; height: 104px; background: #00000000;
            PasswordKeyRow { x: 0px; y: 0px; width: 284px; height: 24px; keys: ["A","B","C","D","E","F","G","H"]; pressed(value) => { root.append-key(value); } }
            PasswordKeyRow { x: 0px; y: 27px; width: 284px; height: 24px; keys: ["I","J","K","L","M","N","O","P"]; pressed(value) => { root.append-key(value); } }
            PasswordKeyRow { x: 0px; y: 54px; width: 284px; height: 24px; keys: ["Q","R","S","T","U","V","W","X"]; pressed(value) => { root.append-key(value); } }
            PasswordKeyRow { x: 0px; y: 81px; width: 284px; height: 24px; keys: ["Y","Z","6","7","8","9","-","_"]; pressed(value) => { root.append-key(value); } }
        }
        if !root.keyboard-collapsed && root.keyboard-mode == 2: Rectangle {
            x: 10px; y: 68px; width: 284px; height: 104px; background: #00000000;
            PasswordKeyRow { x: 0px; y: 0px; width: 284px; height: 24px; keys: ["0","1","2","3","4","5","6","7"]; pressed(value) => { root.append-key(value); } }
            PasswordKeyRow { x: 0px; y: 27px; width: 284px; height: 24px; keys: ["8","9","@","#","$","%","&","!"]; pressed(value) => { root.append-key(value); } }
            PasswordKeyRow { x: 0px; y: 54px; width: 284px; height: 24px; keys: ["?","-","_","+",".","/","*","="]; pressed(value) => { root.append-key(value); } }
            PasswordKeyRow { x: 0px; y: 81px; width: 284px; height: 24px; keys: [":",";","(",")","[","]","{","}"]; pressed(value) => { root.append-key(value); } }
        }

        PasswordAction { x: 10px; y: 178px; width: 46px; height: 22px; label: root.keyboard-collapsed ? "Teclado" : "Ocultar"; clicked => { root.keyboard-collapsed = !root.keyboard-collapsed; } }
        PasswordAction { x: 60px; y: 178px; width: 46px; height: 22px; label: root.keyboard-mode == 0 ? "ABC" : root.keyboard-mode == 1 ? "123" : "abc"; visible: !root.keyboard-collapsed; clicked => { root.keyboard-mode = root.keyboard-mode == 2 ? 0 : root.keyboard-mode + 1; } }
        PasswordAction { x: 60px; y: 178px; width: 42px; height: 22px; label: "Del"; clicked => { root.delete-key(); } }
        PasswordAction { x: 106px; y: 178px; width: 54px; height: 22px; label: "Limpar"; clicked => { root.clear-password(); } }
        PasswordAction { x: 164px; y: 178px; width: 62px; height: 22px; label: "Cancelar"; clicked => { root.cancel(); } }
        PasswordAction { x: 230px; y: 178px; width: 64px; height: 22px; label: "Ligar"; primary: root.password-str != ""; clicked => { if (root.password-str != "") { root.connect(root.ssid, root.password-str); } } }
    }
}

// =====================================================
// PAINEL PRINCIPAL
// =====================================================
export component SettingsPanel inherits Rectangle {
    in-out property <int> page: 0;
    in-out property <bool> wifi-on: true;
    in-out property <bool> bluetooth-on: false;
    in-out property <float> volume: 0.75;
    in-out property <float> brightness: 0.60;
    in-out property <int> region-index: 0;
    in-out property <int> language-index: 0;
    in-out property <bool> wifi-password-open: false;
    in-out property <string> selected-ssid: "";
    in-out property <string> wifi-password: "";
    in-out property <int> wifi-keyboard-mode: 0;
    in-out property <bool> swipe-locked: false;
    in-out property <int> network-scroll: 0;

    property <string> region-label:
        root.region-index == 0 ? "Brasil" :
        root.region-index == 1 ? "Portugal" :
        root.region-index == 2 ? "Angola" :
        root.region-index == 3 ? "Mocambique" : "Estados Unidos";
    property <string> language-label:
        root.language-index == 0 ? "Portugues (Brasil)" :
        root.language-index == 1 ? "Portugues (Portugal)" :
        root.language-index == 2 ? "English" :
        root.language-index == 3 ? "Francais" : "Espanol";

    in property <[WifiNetwork]> networks: [];
    in property <[BluetoothDevice]> bluetooth-devices: [];

    callback back();
    callback scan-wifi-networks();
    callback change-passcode();
    callback network-selected(string, string);
    callback wifi-password-backspace();
    callback wifi-changed(bool);
    callback bluetooth-changed(bool);
    callback locale-changed(int, int);
    callback volume-changed(float);
    callback brightness-changed(float);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;
    clip: true;

    function open-page(next-page: int) {
        root.page = max(0, min(5, next-page));
        if (root.page != 1) { root.network-scroll = 0; }
        if (root.page == 1) {
            root.network-scroll = 0;
            root.scan-wifi-networks();
        }
    }
    // Propriedade derivada para o swipe handler
    property <bool> has-more-networks: root.networks.length > 3;

    swipe-lock-timer := Timer {
        interval: 260ms;
        running: false;
        triggered() => {
            root.swipe-locked = false;
            self.running = false;
        }
    }

    TouchArea {
        x: 0px; y: 36px; width: 320px; height: 180px;
        moved => {
            if (!root.wifi-password-open && !root.swipe-locked) {
                // Scroll vertical da lista de redes (qualquer posicao na pagina 1)
                if (root.page == 1 && root.has-more-networks && self.pressed-y - self.mouse-y > 22px) {
                    if (root.network-scroll < max(0, root.networks.length - 3)) {
                        root.network-scroll = root.network-scroll + 1;
                        root.swipe-locked = true;
                        swipe-lock-timer.running = true;
                    }
                } else if (root.page == 1 && self.mouse-y - self.pressed-y > 22px) {
                    if (root.network-scroll > 0) {
                        root.network-scroll = root.network-scroll - 1;
                        root.swipe-locked = true;
                        swipe-lock-timer.running = true;
                    }
                } else if (self.mouse-x - self.pressed-x > 64px) {
                    if (root.page > 0) { root.open-page(root.page - 1); }
                    root.swipe-locked = true;
                    swipe-lock-timer.running = true;
                } else if (self.pressed-x - self.mouse-x > 64px) {
                    if (root.page < 5) { root.open-page(root.page + 1); }
                    root.swipe-locked = true;
                    swipe-lock-timer.running = true;
                }
            }
        }
    }

    // ---------------- HEADER ----------------
    Rectangle {
        x: 0px; y: 0px; width: 320px; height: 34px;
        background: Theme.bg-1;
        Rectangle { x: 0px; y: 33px; width: 320px; height: 1px; background: Theme.stroke-soft; }
    }
    Rectangle {
        x: 0px; y: 0px; width: 40px; height: 34px;
        border-radius: Theme.radius-s;
        background: bt.pressed ? Theme.panel-elevated : #00000000;
        bt := TouchArea {
            clicked => {
                if (root.page == 0) { root.back(); }
                else { root.page = 0; }
            }
        }
        Image { x: 13px; y: 10px; width: 14px; height: 14px; source: @image-url("assets/icons/chevron-left.svg"); image-fit: contain; colorize: Theme.accent; }
    }
    Text {
        x: 0px; y: 0px; width: 320px; height: 34px;
        text: root.page == 0 ? "Definicoes" :
              root.page == 1 ? "Conexoes" :
              root.page == 2 ? "Seguranca" :
              root.page == 3 ? "Idioma e Regiao" :
              root.page == 4 ? "Som e Ecra" : "Sistema";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // Indicador de paginas (pontos)
    HorizontalLayout {
        x: 130px; y: 40px; width: 60px; height: 6px;
        spacing: 5px;
        alignment: center;
        for i in 6 : Rectangle {
            width: 7px;
            height: 5px;
            border-radius: 2.5px;
            background: i == root.page ? Theme.accent : Theme.stroke;
        }
    }

    // ================= PAGINA 0 — DEFINICOES =================
    if root.page == 0: Rectangle {
        x: 14px; y: 50px; width: 292px; height: 160px;
        background: #00000000;
        for item[index] in [
            { title: "Conexoes", detail: root.wifi-on ? "Wi-Fi ligado" : "Wi-Fi desligado", icon: @image-url("assets/icons/wifi.svg"), tint: Theme.accent-blue },
            { title: "Seguranca", detail: "PIN e protecao", icon: @image-url("assets/icons/shield.svg"), tint: Theme.success },
            { title: "Idioma e Regiao", detail: root.region-label, icon: @image-url("assets/icons/globe.svg"), tint: Theme.accent-cyan },
            { title: "Som e Ecra", detail: "Volume e brilho", icon: @image-url("assets/icons/sliders.svg"), tint: Theme.warning },
            { title: "Sistema", detail: "Estado do DC OS", icon: @image-url("assets/icons/cpu.svg"), tint: Theme.accent-violet },
        ] : Rectangle {
            x: 0px; y: index * 31px; width: 292px; height: 28px;
            border-radius: Theme.radius-s;
            background: ti.pressed ? Theme.panel-elevated : Theme.panel-soft;
            border-width: 1px;
            border-color: ti.pressed ? item.tint : Theme.stroke-soft;
            animate background { duration: 100ms; }
            ti := TouchArea { clicked => { root.open-page(index + 1); } }

            Rectangle {
                x: 6px; y: 4px; width: 20px; height: 20px;
                border-radius: 6px;
                background: Theme.bg-2;
                Image { x: 4px; y: 4px; width: 12px; height: 12px; source: item.icon; image-fit: contain; colorize: item.tint; }
            }
            Text { x: 34px; y: 3px; width: 200px; height: 12px; text: item.title; color: Theme.text-primary; font-size: Theme.font-sm; font-weight: 700; }
            Text { x: 34px; y: 15px; width: 210px; height: 10px; text: item.detail; color: Theme.text-muted; font-size: 8px; }
            Text { x: 272px; y: 0px; width: 16px; height: 28px; text: ">"; color: Theme.text-muted; font-size: Theme.font-sm; horizontal-alignment: center; vertical-alignment: center; }
        }
    }

    // ================= PAGINA 1 — CONEXOES =================
    if root.page == 1: Rectangle {
        x: 14px; y: 50px; width: 292px; height: 160px;
        background: #00000000;
        SettingsToggle {
            x: 0px; y: 0px; width: 292px; height: 38px;
            label: "Wi-Fi"; icon: @image-url("assets/icons/wifi.svg"); checked <=> root.wifi-on;
            changed(on) => {
                root.wifi-changed(on);
                root.network-scroll = 0;
                if (on) { root.scan-wifi-networks(); }
            }
        }
        SettingsToggle { x: 0px; y: 42px; width: 292px; height: 38px; label: "Bluetooth"; icon: @image-url("assets/icons/bluetooth.svg"); checked <=> root.bluetooth-on; changed(on) => { root.bluetooth-changed(on); } }
        Text { x: 2px; y: 84px; width: 150px; height: 12px; text: "Redes disponiveis"; color: Theme.text-secondary; font-size: Theme.font-xs; font-weight: 600; vertical-alignment: center; }
        Text {
            x: 152px; y: 84px; width: 90px; height: 12px;
            text: root.bluetooth-on ? "BLE ligado" : "BLE desligado";
            color: root.bluetooth-on ? Theme.accent-cyan : Theme.text-muted;
            font-size: Theme.font-xs;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle {
            x: 254px; y: 82px; width: 38px; height: 20px;
            border-radius: Theme.radius-s;
            background: tr.pressed ? Theme.panel-elevated : Theme.panel-soft;
            border-width: 1px;
            border-color: Theme.stroke-soft;
            tr := TouchArea { clicked => { root.network-scroll = 0; root.scan-wifi-networks(); } }
            Image { x: 12px; y: 3px; width: 14px; height: 14px; source: @image-url("assets/icons/rotate-cw.svg"); image-fit: contain; colorize: Theme.accent; }
        }
        if !root.wifi-on: Text {
            x: 0px; y: 112px; width: 292px; height: 40px;
            text: "Wi-Fi desligado";
            color: Theme.text-muted;
            font-size: Theme.font-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.wifi-on && root.networks.length == 0: Text {
            x: 0px; y: 112px; width: 292px; height: 40px;
            text: "A procurar redes...";
            color: Theme.text-muted;
            font-size: Theme.font-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.wifi-on && root.networks.length > 0: Rectangle {
            for n[index] in root.networks : Rectangle {
                visible: index >= root.network-scroll && index < root.network-scroll + 3;
                x: 0px; y: (index - root.network-scroll) * 32px; width: 292px; height: 28px;
                border-radius: Theme.radius-s;
                background: tn.pressed ? Theme.panel-elevated : Theme.panel-soft;
                border-width: 1px;
                border-color: n.connected ? Theme.success : Theme.stroke-soft;
                tn := TouchArea {
                    clicked => {
                        root.wifi-on = true;
                        if (n.secured) {
                            root.selected-ssid = n.ssid;
                            root.wifi-password = "";
                            root.wifi-keyboard-mode = 0;
                            root.wifi-password-open = true;
                        } else {
                            root.network-selected(n.ssid, "");
                        }
                    }
                }
                // Chip icone (alinhado verticalmente)
                Rectangle {
                    x: 8px; y: 7px; width: 14px; height: 14px;
                    border-radius: 4px;
                    background: n.connected ? Theme.success-tint : Theme.bg-2;
                    Image { x: 0px; y: 0px; width: 14px; height: 14px; source: @image-url("assets/icons/wifi.svg"); image-fit: contain; colorize: n.connected ? Theme.success : Theme.accent-blue; }
                }
                Text { x: 28px; y: 4px; width: 168px; height: 12px; text: n.ssid; color: Theme.text-primary; font-size: Theme.font-sm; font-weight: 700; overflow: elide; }
                // Linha de sinal com barras proporcionais + dBm discreto
                Text { x: 28px; y: 16px; width: 100px; height: 10px; text: n.connected ? "Conectado" : (n.secured ? "Protegida" : "Aberta"); color: n.connected ? Theme.success : Theme.text-muted; font-size: 8px; }
                // dBm mais a esquerda para nao colidir com o cadeado
                Text { x: 188px; y: 8px; width: 56px; height: 12px; text: n.signal + " dBm"; color: Theme.text-muted; font-size: 8px; horizontal-alignment: right; vertical-alignment: center; }
                // Mini barras de sinal (RSSI -30..-90) para densidade visual
                for bar[k] in [0,1,2,3] : Rectangle {
                    visible: !n.connected;
                    x: 188px + k * 4px; y: 21px; width: 3px;
                    height: k == 0 ? 4px : k == 1 ? 6px : k == 2 ? 8px : 10px;
                    border-radius: 1px;
                    background: n.signal >= -55 + (k * -10) ? Theme.accent : Theme.stroke;
                }
                if n.secured: Image { x: 270px; y: 7px; width: 14px; height: 14px; source: @image-url("assets/icons/lock.svg"); image-fit: contain; colorize: Theme.warning; }
                if n.connected: Image { x: 270px; y: 7px; width: 14px; height: 14px; source: @image-url("assets/icons/check.svg"); image-fit: contain; colorize: Theme.success; }
            }
        }
        // Scroll por gesto mantido; indicador visual removido.
    }

    // ================= PAGINA 2 — SEGURANCA =================
    if root.page == 2: Rectangle {
        x: 14px; y: 54px; width: 292px; height: 84px;
        border-radius: Theme.radius-m;
        background: ts.pressed ? Theme.panel-elevated : Theme.panel-soft;
        border-width: 1px;
        border-color: ts.pressed ? Theme.success : Theme.stroke-soft;
        animate background { duration: 120ms; }
        ts := TouchArea { clicked => { root.change-passcode(); } }
        Rectangle {
            x: 12px; y: 14px; width: 34px; height: 34px;
            border-radius: 10px;
            background: Theme.success-tint;
            Image { x: 8px; y: 8px; width: 18px; height: 18px; source: @image-url("assets/icons/shield.svg"); image-fit: contain; colorize: Theme.success; }
        }
        Text { x: 54px; y: 14px; width: 200px; height: 16px; text: "Alterar PIN"; color: Theme.text-primary; font-size: Theme.font-md; font-weight: 700; }
        Text { x: 54px; y: 33px; width: 210px; height: 34px; text: "Define uma nova senha de 5 digitos para proteger o assistente."; color: Theme.text-secondary; font-size: Theme.font-xs; wrap: word-wrap; }
        Text { x: 268px; y: 24px; width: 20px; height: 34px; text: ">"; color: Theme.text-muted; font-size: Theme.font-md; horizontal-alignment: center; }
    }

    // ================= PAGINA 3 — IDIOMA E REGIAO =================
    if root.page == 3: Rectangle {
        x: 14px; y: 52px; width: 292px; height: 150px;
        background: #00000000;
        LocaleRow {
            x: 0px; y: 0px; width: 292px; height: 46px;
            label: "Regiao"; value: root.region-label; icon: @image-url("assets/icons/globe.svg");
            clicked => { root.region-index = root.region-index == 4 ? 0 : root.region-index + 1; root.locale-changed(root.region-index, root.language-index); }
        }
        LocaleRow {
            x: 0px; y: 54px; width: 292px; height: 46px;
            label: "Idioma"; value: root.language-label; icon: @image-url("assets/icons/message-circle.svg");
            clicked => { root.language-index = root.language-index == 4 ? 0 : root.language-index + 1; root.locale-changed(root.region-index, root.language-index); }
        }
        Text { x: 4px; y: 108px; width: 284px; height: 20px; text: "Toque em cada linha para percorrer 5 opcoes."; color: Theme.text-muted; font-size: Theme.font-xs; horizontal-alignment: center; vertical-alignment: center; }
    }

    // ================= PAGINA 4 — SOM E ECRA =================
    if root.page == 4: Rectangle {
        x: 14px; y: 52px; width: 292px; height: 130px;
        background: #00000000;
        StepperRow { x: 0px; y: 0px; width: 292px; height: 56px; label: "Volume"; icon: @image-url("assets/icons/volume-2.svg"); value <=> root.volume; changed(v) => { root.volume-changed(v); } }
        StepperRow { x: 0px; y: 64px; width: 292px; height: 56px; label: "Brilho"; icon: @image-url("assets/icons/sun.svg"); value <=> root.brightness; changed(v) => { root.brightness-changed(v); } }
    }

    // ================= PAGINA 5 — SISTEMA =================
    if root.page == 5: Rectangle {
        x: 14px; y: 54px; width: 292px; height: 108px;
        border-radius: Theme.radius-m;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        Rectangle {
            x: 14px; y: 14px; width: 34px; height: 34px;
            border-radius: 10px;
            background: Theme.accent-tint;
            Image { x: 8px; y: 8px; width: 18px; height: 18px; source: @image-url("assets/icons/cpu.svg"); image-fit: contain; colorize: Theme.accent; }
        }
        Text { x: 56px; y: 14px; width: 220px; height: 16px; text: "DC OS Embedded"; color: Theme.accent; font-size: Theme.font-md; font-weight: 700; }
        Text { x: 56px; y: 32px; width: 220px; height: 12px; text: "Versao 2.0"; color: Theme.text-muted; font-size: Theme.font-xs; }
        Text { x: 14px; y: 58px; width: 264px; height: 38px; text: "Firmware ESP32-S3 com Slint UI, Wi-Fi, SNTP, NVS e API local."; color: Theme.text-secondary; font-size: Theme.font-xs; wrap: word-wrap; }
    }

    if root.wifi-password-open: WifiPasswordDialog {
        x: 0px; y: 0px; width: 320px; height: 216px;
        ssid <=> root.selected-ssid;
        password <=> root.wifi-password;
        keyboard-mode <=> root.wifi-keyboard-mode;
        backspace => { root.wifi-password-backspace(); }
        cancel => {
            root.wifi-password-open = false;
            root.wifi-password = "";
        }
        connect(ssid, password) => {
            root.wifi-password-open = false;
            root.network-selected(ssid, password);
        }
    }
}

// =====================================================
// ALTERAR PIN
// =====================================================
export component ChangePasscode inherits Rectangle {
    in-out property <string> d0: "";
    in-out property <string> d1: "";
    in-out property <string> d2: "";
    in-out property <string> d3: "";
    in-out property <string> d4: "";
    in-out property <int> filled: 0;
    property <int> pin-length: 5;
    property <string> passcode-str: root.d0 + root.d1 + root.d2 + root.d3 + root.d4;
    callback back();
    callback save(string);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    Rectangle { x: 0px; y: 0px; width: 320px; height: 34px; background: Theme.bg-1; Rectangle { x: 0px; y: 33px; width: 320px; height: 1px; background: Theme.stroke-soft; } }
    Rectangle {
        x: 0px; y: 0px; width: 40px; height: 34px;
        border-radius: Theme.radius-s;
        background: bk.pressed ? Theme.panel-elevated : #00000000;
        bk := TouchArea { clicked => { root.back(); } }
        Image { x: 13px; y: 10px; width: 14px; height: 14px; source: @image-url("assets/icons/chevron-left.svg"); image-fit: contain; colorize: Theme.accent; }
    }
    Text { x: 0px; y: 0px; width: 320px; height: 34px; text: "Alterar PIN"; color: Theme.text-primary; font-size: Theme.font-md; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    Text { x: 0px; y: 40px; width: 320px; height: 14px; text: "Novo PIN de 5 digitos"; color: Theme.text-secondary; font-size: Theme.font-xs; horizontal-alignment: center; vertical-alignment: center; }

    HorizontalLayout {
        x: 120px; y: 60px; width: 80px; height: 12px;
        spacing: 8px;
        for i in root.pin-length: Rectangle {
            width: 11px; height: 11px;
            border-radius: 5.5px;
            background: i < root.filled ? Theme.accent : #00000000;
            border-width: 1.5px;
            border-color: i < root.filled ? Theme.accent-hi : Theme.text-muted;
        }
    }

    for row[index] in [[ "1","2","3","4","5" ], [ "6","7","8","9","0" ]] : HorizontalLayout {
        x: 56px; y: 80px + index * 42px; width: 210px; height: 34px;
        spacing: 6px;
        for k in row : Rectangle {
            width: 38px; height: 34px;
            border-radius: Theme.radius-s;
            background: tk.pressed ? Theme.accent-deep : Theme.panel-soft;
            border-width: 1px;
            border-color: tk.pressed ? Theme.accent : Theme.stroke;
            tk := TouchArea {
                clicked => {
                    if (root.filled < root.pin-length) {
                        if      (root.filled == 0) { root.d0 = k; }
                        else if (root.filled == 1) { root.d1 = k; }
                        else if (root.filled == 2) { root.d2 = k; }
                        else if (root.filled == 3) { root.d3 = k; }
                        else if (root.filled == 4) { root.d4 = k; }
                        root.filled = root.filled + 1;
                    }
                }
            }
            Text { text: k; color: Theme.text-primary; font-size: Theme.font-md; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        }
    }

    Rectangle {
        x: 56px; y: 168px; width: 56px; height: 34px;
        border-radius: Theme.radius-s;
        background: root.filled > 0 ? Theme.panel-elevated : Theme.panel-soft;
        border-width: 1px;
        border-color: root.filled > 0 ? Theme.stroke : Theme.text-dim;
        tdel := TouchArea {
            clicked => {
                if (root.filled > 0) {
                    root.filled = root.filled - 1;
                    if      (root.filled == 0) { root.d0 = ""; }
                    else if (root.filled == 1) { root.d1 = ""; }
                    else if (root.filled == 2) { root.d2 = ""; }
                    else if (root.filled == 3) { root.d3 = ""; }
                    else if (root.filled == 4) { root.d4 = ""; }
                }
            }
        }
        Image { x: 18px; y: 9px; width: 20px; height: 16px; source: @image-url("assets/icons/delete-left.svg"); image-fit: contain; colorize: Theme.text-secondary; }
    }

    Rectangle {
        x: 120px; y: 168px; width: 144px; height: 34px;
        border-radius: Theme.radius-s;
        background: root.filled == root.pin-length ? Theme.accent : Theme.accent-deep;
        border-width: 1px;
        border-color: root.filled == root.pin-length ? Theme.accent-hi : Theme.stroke;
        tsave := TouchArea { clicked => { if (root.filled == root.pin-length) { root.save(root.passcode-str); } } }
        Text { text: "Guardar PIN"; color: root.filled == root.pin-length ? Theme.bg-0 : Theme.text-secondary; font-size: Theme.font-sm; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
}
