import { Theme } from "theme.slint";

export struct AppEntry { name: string, icon: image, color: color }

// AppLauncher — grelha 4x2 de aplicacoes, design moderno e limpo.
export component AppLauncher inherits Rectangle {
    in property <[AppEntry]> apps: [
        { name: "DC Assistant", icon: @image-url("assets/icons/message-circle.svg"), color: Theme.accent-blue },
        { name: "Spotify",       icon: @image-url("assets/icons/spotify.svg"),        color: Theme.success },
        { name: "Clima",        icon: @image-url("assets/icons/cloud.svg"),          color: Theme.warning },
        { name: "Agenda",       icon: @image-url("assets/icons/calendar.svg"),       color: Theme.danger },
        { name: "Notas",        icon: @image-url("assets/icons/file-text.svg"),      color: Theme.warning },
        { name: "Alarme",       icon: @image-url("assets/icons/calendar.svg"),       color: Theme.accent-cyan },
        { name: "Definicoes",   icon: @image-url("assets/icons/settings.svg"),       color: Theme.text-secondary },
    ];

    callback app-clicked(int);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // Header
    Text {
        x: 16px; y: 10px; width: 200px; height: 18px;
        text: "Aplicacoes";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
    }

    // Grid 4 columns x 2 rows
    for row[index] in [[0,1,2,3],[4,5,6,0]] : HorizontalLayout {
        x: 12px; y: 36px + index * 84px; width: 296px; height: 76px;
        spacing: 8px;
        for i[row-index] in row : Rectangle {
            visible: !(index == 1 && row-index == 3);
            width: 68px; height: 76px;
            border-radius: Theme.radius-s;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.stroke-soft;
            clip: true;
            TouchArea { clicked => { root.app-clicked(i); } }

            // Icon circle
            Rectangle {
                x: 19px; y: 10px; width: 30px; height: 30px;
                border-radius: 15px;
                background: Theme.panel-elevated;
                border-width: 1px;
                border-color: root.apps[i].color;
            }
            Image {
                x: 22px; y: 13px; width: 24px; height: 24px;
                source: root.apps[i].icon;
                image-fit: contain;
            }
            Text {
                x: 4px; y: 48px; width: 60px; height: 18px;
                text: root.apps[i].name;
                color: Theme.text-primary;
                font-size: 8px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
