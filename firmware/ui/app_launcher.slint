import { Theme } from "theme.slint";

// App Launcher — sidebar 45 px + grid 4×2 (cells 50×60).
export struct AppEntry { name: string, icon: string, color: color }

export component AppLauncher inherits Rectangle {
    in property <[AppEntry]> apps: [
        { name: "DC Assistant", icon: "\u{2706}", color: Theme.accent-blue  },
        { name: "Música",        icon: "\u{266A}", color: Theme.accent-hi   },
        { name: "Clima",         icon: "\u{2601}", color: Theme.warning     },
        { name: "Agenda",        icon: "31",       color: Theme.danger      },
        { name: "Notas",         icon: "\u{270E}", color: Theme.warning     },
        { name: "Loja",          icon: "\u{25A0}", color: Theme.accent-pink },
        { name: "Definições",    icon: "\u{2699}", color: Theme.text-secondary },
        { name: "Mais",          icon: "\u{2026}", color: Theme.text-muted  },
    ];
    in property <int> active-rail: 0;
    callback app-clicked(int);
    callback rail-clicked(int);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // ===== Sidebar 45 px =====
    Rectangle {
        x: 0px; y: 0px; width: 45px; height: 100%;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;

        for item[index] in [ "\u{2302}", "\u{266A}", "\u{25A1}", "\u{2699}" ] : Rectangle {
            x: 7px; y: 30px + index * 42px; width: 30px; height: 30px;
            border-radius: 6px;
            background: index == root.active-rail ? Theme.accent : #00000000;
            TouchArea { clicked => { root.rail-clicked(index); } }
            Text {
                text: item;
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // ===== Título =====
    Text {
        x: 56px; y: 32px; width: 200px; height: 20px;
        text: "Aplicações";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        vertical-alignment: center;
    }

    // ===== Grid 4x2 =====
    for row[index] in [[0,1,2,3],[4,5,6,7]] : HorizontalLayout {
        x: 56px; y: 60px + index * 68px; width: 250px; height: 60px;
        spacing: 12px;
        for i in row : Rectangle {
            width: 50px; height: 60px;
            border-radius: 8px;
            background: Theme.tile;
            border-width: 1px;
            border-color: Theme.stroke;
            clip: true;
            TouchArea { clicked => { root.app-clicked(i); } }

            // Disco de cor no topo
            Rectangle {
                x: 10px; y: 6px; width: 30px; height: 30px;
                border-radius: 15px;
                background: root.apps[i].color;
                opacity: 0.95;
            }
            Text {
                x: 0px; y: 4px; width: 100%; height: 28px;
                text: root.apps[i].icon;
                color: Theme.text-primary;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Text {
                x: 0px; y: 40px; width: 100%; height: 14px;
                text: root.apps[i].name;
                color: Theme.text-primary;
                font-size: 8px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // ===== Page indicator =====
    HorizontalLayout {
        x: 142px; y: 196px; width: 36px; height: 6px;
        spacing: 6px;
        Rectangle { width: 14px; height: 6px; border-radius: 3px; background: Theme.accent-blue; }
        Rectangle { width:  6px; height: 6px; border-radius: 3px; background: Theme.tile-hi; }
    }
}
