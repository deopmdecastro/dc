import { Theme } from "theme.slint";

export struct AppEntry { name: string, icon: image, color: color }

// AppLauncher — grelha 4x2 de aplicacoes. Cada card tem um "chip" de icone
// tingido com a cor do app e um anel subtil, dando identidade visual sem
// carregar o ecra pequeno.
export component AppLauncher inherits Rectangle {
    in property <int> language-index: 0;
    in property <[AppEntry]> apps: [
        { name: "Assistente", icon: @image-url("assets/icons/message-circle.svg"), color: Theme.accent-blue },
        { name: "Spotify",    icon: @image-url("assets/icons/spotify.svg"),        color: Theme.success },
        { name: "Clima",      icon: @image-url("assets/icons/cloud.svg"),          color: Theme.accent-cyan },
        { name: "Recursos",   icon: @image-url("assets/icons/zap.svg"),            color: Theme.accent-violet },
        { name: "Notas",      icon: @image-url("assets/icons/file-text.svg"),      color: Theme.warning },
        { name: "Alarme",     icon: @image-url("assets/icons/bell.svg"),           color: Theme.accent-pink },
        { name: "Definicoes", icon: @image-url("assets/icons/settings.svg"),       color: Theme.text-secondary },
    ];

    callback app-clicked(int);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // Header com icone de grelha
    Image {
        x: 16px; y: 13px; width: 15px; height: 15px;
        source: @image-url("assets/icons/grid.svg");
        image-fit: contain;
        colorize: Theme.accent;
    }
    Text {
        x: 38px; y: 10px; width: 200px; height: 20px;
        text: root.language-index == 2 ? "Apps" :
              root.language-index == 3 ? "Applications" :
              root.language-index == 4 ? "Aplicaciones" : "Aplicacoes";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        vertical-alignment: center;
    }
    // Contador de apps
    Text {
        x: 220px; y: 10px; width: 84px; height: 20px;
        text: "7 apps";
        color: Theme.text-muted;
        font-size: Theme.font-xs;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // Grid 4 colunas x 2 linhas
    for row[index] in [[0,1,2,3],[4,5,6,0]] : HorizontalLayout {
        x: 12px; y: 40px + index * 86px; width: 296px; height: 80px;
        spacing: 8px;
        for i[row-index] in row : Rectangle {
            visible: !(index == 1 && row-index == 3);
            width: 68px; height: 80px;
            border-radius: Theme.radius-m;
            background: t.pressed ? Theme.panel-elevated : Theme.panel;
            border-width: 1px;
            border-color: t.pressed ? root.apps[i].color : Theme.stroke-soft;
            clip: true;
            animate background { duration: 120ms; }

            t := TouchArea { clicked => { root.app-clicked(i); } }

            // Chip de icone tingido
            Rectangle {
                x: 20px; y: 12px; width: 28px; height: 28px;
                border-radius: 9px;
                background: Theme.panel-elevated;
                border-width: 1.5px;
                border-color: root.apps[i].color;
                Image {
                    x: 5px; y: 5px; width: 18px; height: 18px;
                    source: root.apps[i].icon;
                    image-fit: contain;
                    colorize: root.apps[i].color;
                }
            }
            Text {
                x: 2px; y: 48px; width: 64px; height: 26px;
                text:
                    root.language-index == 2 ?
                        (i == 0 ? "Assistant" : i == 1 ? "Spotify" : i == 2 ? "Weather" : i == 3 ? "Features" : i == 4 ? "Notes" : i == 5 ? "Alarm" : "Settings") :
                    root.language-index == 3 ?
                        (i == 0 ? "Assistant" : i == 1 ? "Spotify" : i == 2 ? "Meteo" : i == 3 ? "Fonctions" : i == 4 ? "Notes" : i == 5 ? "Alarme" : "Reglages") :
                    root.language-index == 4 ?
                        (i == 0 ? "Asistente" : i == 1 ? "Spotify" : i == 2 ? "Clima" : i == 3 ? "Funciones" : i == 4 ? "Notas" : i == 5 ? "Alarma" : "Ajustes") :
                    root.apps[i].name;
                color: Theme.text-secondary;
                font-size: 9px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }
}
