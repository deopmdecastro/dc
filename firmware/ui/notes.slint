// =====================================================
// Notas — novo modelo: lista dinamica de notas (modelo reativo),
// scroll vertical, swipe de baixo para cima para baixo para baixo,
// e teclado com backspace/limpar espaco/resize seguro.
// =====================================================
import { Theme } from "theme.slint";

export struct NoteEntry { text: string, tint: color }

component NoteKey inherits Rectangle {
    in property <string> label;
    in property <bool> is-space: false;
    in-out property <string> text-value;

    border-radius: Theme.radius-xs;
    background: t.pressed ? Theme.accent : Theme.panel-elevated;
    border-width: 1px;
    border-color: t.pressed ? Theme.accent-hi : Theme.stroke-soft;
    t := TouchArea {
        clicked => {
            // Bloqueia clique quando uma das sobreposicoes modais
            // (backdrop do teclado de senha) interceta o input.
            if (root.text-value == "" && !root.is-space) {
                root.text-value = root.label;
            } else if (root.is-space) {
                root.text-value = root.text-value + " ";
            } else {
                root.text-value = root.text-value + root.label;
            }
        }
    }
    Text {
        text: root.label == " " ? "␣" : root.label;
        color: t.pressed ? Theme.bg-0 : Theme.text-primary;
        font-size: root.is-space ? 8px : 9px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component NoteKeyRow inherits HorizontalLayout {
    in property <[string]> keys;
    in-out property <string> text-value;
    spacing: 4px;
    for key[i] in root.keys : NoteKey {
        width: i == root.keys.length - 1 && root.keys[i] == " " ? 60px : 32px;
        height: 22px;
        label: key;
        is-space: key == " ";
        text-value <=> root.text-value;
    }
}

component NoteAction inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked();

    border-radius: Theme.radius-s;
    background: t.pressed
        ? (root.danger ? Theme.danger : Theme.accent-hi)
        : (root.primary ? Theme.accent : (root.danger ? Theme.danger-tint : Theme.panel-elevated));
    border-width: 1px;
    border-color: root.primary ? Theme.accent-hi : (root.danger ? Theme.danger : Theme.stroke-soft);
    t := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: root.primary ? Theme.bg-0 : (root.danger ? Theme.danger : Theme.text-primary);
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component NotesPanel inherits Rectangle {
    in-out property <[NoteEntry]> notes: [
        { text: "Bem-vindo ao DC OS", tint: Theme.accent-cyan },
        { text: "Toque em Nova para escrever", tint: Theme.warning },
        { text: "As notas ficam nesta sessao", tint: Theme.accent-violet },
    ];
    in-out property <string> draft: "";
    in-out property <int> keyboard-mode: 0;
    in-out property <bool> keyboard-collapsed: false;
    in-out property <bool> composing: false;
    in-out property <int> note-scroll: 0;
    in-out property <int> edit-index: -1;
    in property <int> language-index: 0;
    callback back();
    callback delete-note(int);
    callback save-note(string, int);

    property <int> visible-count: max(1, root.notes.length);
    property <int> max-visible: 3;
    property <int> max-scroll: max(0, root.notes.length - root.max-visible);
    property <bool> empty: root.notes.length == 0;
    property <string> title:
        root.language-index == 2 ? "Notes" :
        root.language-index == 3 ? "Notes" :
        root.language-index == 4 ? "Notas" : "Notas";

    width: 320px;
    height: 216px;
    background: Theme.bg-0;
    clip: true;

    Rectangle { x: 0px; y: 0px; width: 320px; height: 34px; background: Theme.bg-1; Rectangle { x: 0px; y: 33px; width: 320px; height: 1px; background: Theme.stroke-soft; } }
    Rectangle {
        x: 6px; y: 4px; width: 34px; height: 28px;
        border-radius: Theme.radius-s;
        background: bk.pressed ? Theme.panel-elevated : #00000000;
        bk := TouchArea { clicked => { root.back(); } }
        Image { x: 9px; y: 7px; width: 14px; height: 14px; source: @image-url("assets/icons/chevron-left.svg"); image-fit: contain; colorize: Theme.accent; }
    }
    Text {
        x: 0px; y: 0px; width: 320px; height: 34px;
        text: root.title;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        x: 248px; y: 6px; width: 60px; height: 24px;
        border-radius: Theme.radius-s;
        background: add.pressed ? Theme.accent-hi : Theme.accent;
        add := TouchArea { clicked => { root.edit-index = -1; root.draft = ""; root.composing = true; } }
        Text { text: root.language-index == 2 ? "New" : root.language-index == 3 ? "Nouveau" : root.language-index == 4 ? "Nuevo" : "Nova"; color: Theme.bg-0; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    }

    // Contador discreto de notas no canto direito do header
    Text {
        x: 188px; y: 0px; width: 56px; height: 34px;
        text: root.notes.length + (root.language-index == 2 ? " note" : root.language-index == 3 ? " note" : root.language-index == 4 ? " nota" : " nota") + (root.notes.length == 1 ? "" : "s");
        color: Theme.text-muted;
        font-size: 9px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // Mensagem quando nao ha notas
    if root.empty: Rectangle {
        x: 16px; y: 72px; width: 288px; height: 120px;
        border-radius: Theme.radius-m;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        Image { x: 132px; y: 28px; width: 24px; height: 24px; source: @image-url("assets/icons/file-text.svg"); image-fit: contain; colorize: Theme.text-muted; }
        Text {
            x: 12px; y: 64px; width: 264px; height: 24px;
            text: root.language-index == 2 ? "No notes. Tap New to start." :
                  root.language-index == 3 ? "Aucune note. Appuyez sur Nouveau." :
                  root.language-index == 4 ? "Sin notas. Toca Nuevo para empezar." : "Sem notas. Toque em Nova para comecar.";
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }

    // Lista de notas (com scroll, mais altura e mais espaco entre cards)
    for n[index] in root.notes : Rectangle {
        visible: index >= root.note-scroll && index < root.note-scroll + root.max-visible;
        x: 14px; y: 50px + (index - root.note-scroll) * 50px; width: 292px; height: 44px;
        border-radius: Theme.radius-s;
        background: ta.pressed ? Theme.panel-elevated : Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        panel-bg := Rectangle {
            // atraso invisivel para feedback de press
            background: #00000000;
            ta := TouchArea {
                clicked => {
                    root.edit-index = index;
                    root.draft = n.text;
                    root.composing = true;
                }
            }
        }
        Rectangle {
            x: 8px; y: 8px; width: 28px; height: 28px;
            border-radius: 8px;
            background: Theme.bg-2;
            Image { x: 7px; y: 7px; width: 14px; height: 14px; source: @image-url("assets/icons/file-text.svg"); image-fit: contain; colorize: n.tint; }
        }
        Text {
            x: 44px; y: 6px; width: 210px; height: 16px;
            text: n.text;
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            x: 44px; y: 22px; width: 210px; height: 14px;
            text: index == 0 ? (root.language-index == 2 ? "Last edit" : root.language-index == 3 ? "Derniere edition" : root.language-index == 4 ? "Ultima edicion" : "Ultima edicao") : (root.language-index == 2 ? "Tap to edit" : root.language-index == 3 ? "Appuyer pour modifier" : root.language-index == 4 ? "Toca para editar" : "Toque para editar");
            color: Theme.text-muted;
            font-size: 8px;
        }
        // botao apagar miniatura
        Rectangle {
            x: 258px; y: 8px; width: 24px; height: 28px;
            border-radius: 6px;
            background: del.pressed ? Theme.danger-tint : #00000000;
            del := TouchArea {
                clicked => {
                    if (root.notes.length > 0) {
                        root.delete-note(index);
                    }
                }
            }
            Image { x: 6px; y: 8px; width: 12px; height: 12px; source: @image-url("assets/icons/trash-2.svg"); image-fit: contain; colorize: del.pressed ? Theme.danger : Theme.text-muted; }
        }
    }

    // Scroll mantido por gesto, sem barra visual.
    TouchArea {
        x: 0px; y: 38px; width: 320px; height: 170px;
        moved => {
            if (!root.composing && self.pressed) {
                if (self.pressed-y - self.mouse-y > 18px) { root.note-scroll = min(root.max-scroll, root.note-scroll + 1); }
                else if (self.mouse-y - self.pressed-y > 18px) { root.note-scroll = max(0, root.note-scroll - 1); }
            }
        }
    }

    // Modal de composicao
    if root.composing: Rectangle {
        x: 0px; y: 0px; width: 320px; height: 216px;
        background: #03050EE0;
        // backdrop que bloqueia toques abaixo do dialog
        TouchArea { x: 0px; y: 0px; width: 320px; height: 216px; clicked => { } }
        Rectangle {
            x: 8px; y: 8px; width: 304px; height: 200px;
            border-radius: Theme.radius-m;
            background: Theme.bg-1;
            border-width: 1px;
            border-color: Theme.stroke;

            Rectangle {
                x: 0px; y: 0px; width: 304px; height: 26px;
                border-radius: Theme.radius-m;
                background: Theme.bg-2;
                Text {
                    x: 14px; y: 0px; width: 220px; height: 26px;
                    text: root.edit-index >= 0 ? (root.language-index == 2 ? "Edit note" : root.language-index == 3 ? "Modifier" : root.language-index == 4 ? "Editar nota" : "Editar nota") : (root.language-index == 2 ? "New note" : root.language-index == 3 ? "Nouvelle note" : root.language-index == 4 ? "Nueva nota" : "Nova nota");
                    color: Theme.text-primary;
                    font-size: Theme.font-sm;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                // Botao X para fechar sem guardar
                Rectangle {
                    x: 274px; y: 4px; width: 22px; height: 18px;
                    border-radius: 6px;
                    background: cx.pressed ? Theme.danger-tint : #00000000;
                    cx := TouchArea { clicked => { root.composing = false; root.draft = ""; root.edit-index = -1; } }
                    Text { x: 0px; y: 0px; width: 22px; height: 18px; text: "×"; color: Theme.text-secondary; font-size: 13px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            Rectangle {
                x: 12px; y: 32px; width: 280px; height: 30px;
                border-radius: Theme.radius-s;
                background: Theme.bg-0;
                border-width: 1px;
                border-color: root.draft == "" ? Theme.stroke-soft : Theme.accent-deep;
                Text {
                    x: 10px; y: 0px; width: 260px; height: 30px;
                    text: root.draft == "" ? (root.language-index == 2 ? "Write..." : root.language-index == 3 ? "Ecrire..." : root.language-index == 4 ? "Escribir..." : "Escrever...") : root.draft;
                    color: root.draft == "" ? Theme.text-muted : Theme.text-primary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            // Botao mostrar/esconder teclado
            Rectangle {
                x: 270px; y: 2px; width: 38px; height: 28px;
                border-radius: Theme.radius-s;
                background: ks.pressed ? Theme.panel-elevated : Theme.panel-soft;
                border-width: 1px;
                border-color: Theme.stroke-soft;
                ks := TouchArea { clicked => { root.keyboard-collapsed = !root.keyboard-collapsed; } }
                Image { x: 11px; y: 7px; width: 16px; height: 14px; source: root.keyboard-collapsed ? @image-url("assets/icons/chevron-right.svg") : @image-url("assets/icons/chevron-left.svg"); image-fit: contain; colorize: Theme.accent; }
            }
            // Teclado (so mostra se nao estiver colapsado)
            if !root.keyboard-collapsed: Rectangle {
                x: 0px; y: 68px; width: 320px; height: 100px;
                background: #00000000;
                // Linhas de teclado - letras
                if root.keyboard-mode == 0 || root.keyboard-mode == 1: Rectangle {
                    x: 12px; y: 0px; width: 280px; height: 66px; background: #00000000;
                    NoteKeyRow { x: 0px; y: 0px; width: 280px; height: 20px; keys: root.keyboard-mode == 0 ? ["a","b","c","d","e","f","g","h"] : ["A","B","C","D","E","F","G","H"]; text-value <=> root.draft; }
                    NoteKeyRow { x: 0px; y: 22px; width: 280px; height: 20px; keys: root.keyboard-mode == 0 ? ["i","j","k","l","m","n","o","p"] : ["I","J","K","L","M","N","O","P"]; text-value <=> root.draft; }
                    NoteKeyRow { x: 0px; y: 44px; width: 280px; height: 20px; keys: root.keyboard-mode == 0 ? ["q","r","s","t","u","v","w","x"] : ["Q","R","S","T","U","V","W","X"]; text-value <=> root.draft; }
                }
                // Linhas de teclado - numeros/simbolos
                if root.keyboard-mode == 2: Rectangle {
                    x: 12px; y: 0px; width: 280px; height: 66px; background: #00000000;
                    NoteKeyRow { x: 0px; y: 0px; width: 280px; height: 20px; keys: ["0","1","2","3","4","5","6","7"]; text-value <=> root.draft; }
                    NoteKeyRow { x: 0px; y: 22px; width: 280px; height: 20px; keys: ["8","9",".",",","?","!","-","_"]; text-value <=> root.draft; }
                    NoteKeyRow { x: 0px; y: 44px; width: 280px; height: 20px; keys: ["@","#","$","%","&","*"," "," "]; text-value <=> root.draft; }
                }
            }
            // Botoes de acao (sempre visiveis)
            // Caps/Shift toggle
            NoteAction {
                x: 12px; y: root.keyboard-collapsed ? 68px : 108px; width: 44px; height: 24px;
                label: root.keyboard-mode == 0 ? "⇧" : "⇩";
                primary: root.keyboard-mode == 1;
                clicked => { root.keyboard-mode = root.keyboard-mode == 0 ? 1 : 0; }
            }
            // Numbers/Symbols toggle
            NoteAction {
                x: 60px; y: root.keyboard-collapsed ? 68px : 108px; width: 44px; height: 24px;
                label: root.keyboard-mode == 2 ? "ABC" : "123";
                primary: root.keyboard-mode == 2;
                clicked => { root.keyboard-mode = root.keyboard-mode == 2 ? 0 : 2; }
            }
            NoteAction {
                x: 108px; y: root.keyboard-collapsed ? 68px : 108px; width: 64px; height: 24px;
                label: root.language-index == 2 ? "Clear" : root.language-index == 3 ? "Effacer" : root.language-index == 4 ? "Borrar" : "Limpar";
                clicked => { root.draft = ""; }
            }
            NoteAction {
                x: 176px; y: root.keyboard-collapsed ? 68px : 108px; width: 52px; height: 24px;
                label: root.language-index == 2 ? "Cancel" : root.language-index == 3 ? "Annuler" : root.language-index == 4 ? "Cancelar" : "Cancelar";
                clicked => { root.composing = false; root.draft = ""; root.edit-index = -1; }
            }
            NoteAction {
                x: 232px; y: root.keyboard-collapsed ? 68px : 108px; width: 56px; height: 24px;
                label: "OK";
                primary: root.draft != "";
                clicked => {
                    if (root.draft != "") {
                        root.save-note(root.draft, root.edit-index);
                        root.composing = false;
                        root.draft = "";
                        root.edit-index = -1;
                    }
                }
            }
        }
    }
}
