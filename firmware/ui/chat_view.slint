import { Theme } from "theme.slint";

// Home / Chat — áudio wave simétrico + mic circular menor (35 px).
export component ChatView inherits Rectangle {
    in property <float>  audio-level: 0.0;
    in property <bool>   listening:   false;
    callback mic-tapped();
    callback menu-tapped();

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // Glow magenta difuso atrás do título
    Rectangle {
        x: 0px; y: 78px; width: 100%; height: 50px;
        background: Theme.accent-deep;
        opacity: 0.35;
    }
    Rectangle {
        x: 60px; y: 110px; width: 200px; height: 2px;
        background: Theme.accent-pink;
        opacity: 0.5;
    }

    // Botão de menu (hamburger) — outline ao invés de tile preenchido
    Rectangle {
        x: 12px; y: 14px; width: 28px; height: 28px;
        border-radius: 14px;
        background: #00000000;
        TouchArea { clicked => { root.menu-tapped(); } }
        Text {
            text: "\u{2630}";
            color: Theme.text-primary;
            font-size: Theme.font-lg;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 0px; y: 50px; width: 100%; height: 20px;
        text: "Olá, eu sou o";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 0px; y: 74px; width: 100%; height: 28px;
        text: "DC Assistant";
        color: Theme.accent-hi;
        font-size: Theme.font-xl;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 0px; y: 116px; width: 100%; height: 18px;
        text: "Como posso ajudar você hoje?";
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Waveform simétrica: gradiente pink → cyan
    HorizontalLayout {
        x: 36px; y: 148px; width: 248px; height: 30px;
        alignment: center;
        spacing: 3px;
        for i in 28 : Rectangle {
            width: 4px;
            height: 4px + (root.listening ? 22px : 12px) * (0.3 + 0.7 * (mod(i * 13, 9) / 9));
            y: (parent.height - self.height) / 2;
            border-radius: 2px;
            background: i < 14 ? Theme.accent-pink : Theme.accent-2;
            animate height { duration: 120ms; easing: ease-in-out; }
        }
    }

    // Mic — apenas outline (35 px, y=190)
    Rectangle {
        x: 142px; y: 188px; width: 36px; height: 36px;
        border-radius: 18px;
        background: #00000000;
        border-width: 2px;
        border-color: root.listening ? Theme.accent-pink : Theme.accent-hi;
        TouchArea { clicked => { root.mic-tapped(); } }
        Text {
            text: "\u{1F3A4}";
            font-size: 16px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
