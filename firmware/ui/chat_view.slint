import { Theme } from "theme.slint";

// ChatView — tela home. Onda de áudio reage a `audio-level` (0..1).
export component ChatView inherits Rectangle {
    in property <float>  audio-level: 0.0;
    in property <bool>   listening:   false;
    callback mic-tapped();
    callback menu-tapped();

    width: 100%; height: 100%;
    background: Theme.bg-1;

    // Menu ⋮ (esquerda)
    Rectangle {
        x: 8px; y: 6px; width: 24px; height: 24px;
        border-radius: 6px; background: Theme.surface;
        TouchArea { clicked => { root.menu-tapped(); } }
        Text { text: "\u{2630}"; color: Theme.text-primary; horizontal-alignment: center;
               vertical-alignment: center; }
    }

    VerticalLayout {
        alignment: center; spacing: 4px; padding-top: 20px;
        Text { text: "Olá, eu sou o"; color: Theme.text-secondary;
               font-size: Theme.font-sm; horizontal-alignment: center; }
        Text { text: "DC Assistant"; color: Theme.accent-2;
               font-size: Theme.font-xl; horizontal-alignment: center; font-weight: 700; }
        Text { text: "Como posso ajudar você hoje?"; color: Theme.text-muted;
               font-size: Theme.font-xs; horizontal-alignment: center; }

        // Wave visualizer — 16 barras
        HorizontalLayout {
            alignment: center; spacing: 3px; padding-top: 8px;
            for i in 16 : Rectangle {
                width: 6px;
                height: 4px + (root.audio-level * 30px) * (0.4 + 0.6 * (mod(i * 37, 10) / 10));
                background: mod(i, 2) == 0 ? Theme.accent-2 : Theme.accent-pink;
                border-radius: 3px;
                animate height { duration: 120ms; easing: ease-out; }
            }
        }
    }

    // Botão do microfone
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 12px;
        width: 46px; height: 46px; border-radius: 23px;
        background: root.listening ? Theme.accent-pink : Theme.accent;
        TouchArea { clicked => { root.mic-tapped(); } }
        Text { text: "\u{1F3A4}"; horizontal-alignment: center; vertical-alignment: center; }
    }
}
