import { Theme } from "theme.slint";

// Home: chat view principal com visualizador de áudio.
export component ChatView inherits Rectangle {
    in property <float>  audio-level: 0.0;
    in property <bool>   listening:   false;
    callback mic-tapped();
    callback menu-tapped();

    width: 320px;
    height: 216px;
    background: Theme.bg-1;

    // Glow roxo difuso atrás do título (cyan/magenta)
    Rectangle {
        x: 0px; y: 70px; width: 100%; height: 60px;
        background: #2A1054;
        opacity: 0.35;
    }
    Rectangle {
        x: 60px; y: 96px; width: 200px; height: 2px;
        background: Theme.accent-pink;
        opacity: 0.4;
    }

    // Botão de menu (hamburger)
    Rectangle {
        x: 10px; y: 10px; width: 32px; height: 32px;
        border-radius: 16px;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;
        TouchArea { clicked => { root.menu-tapped(); } }
        Text {
            text: "\u{2630}";
            color: Theme.text-primary;
            font-size: Theme.font-xl;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 0px; y: 42px; width: 100%; height: 20px;
        text: "Olá, eu sou o";
        color: Theme.text-secondary;
        font-size: Theme.font-lg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 0px; y: 64px; width: 100%; height: 28px;
        text: "DC Assistant";
        color: Theme.accent-2;
        font-size: Theme.font-xxl;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 0px; y: 94px; width: 100%; height: 16px;
        text: "Como posso ajudar você hoje?";
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Visualizador de áudio: 28 barras com gradiente pink→cyan→purple
    HorizontalLayout {
        x: 36px; y: 122px; width: 248px; height: 32px;
        alignment: center;
        spacing: 2px;
        for i in 32 : Rectangle {
            width: 4px;
            height: 4px + (root.listening ? 26px : 14px) * (0.35 + 0.65 * (mod(i * 17, 11) / 11));
            y: (parent.height - self.height) / 2;
            border-radius: 2px;
            background: i < 12 ? Theme.accent-pink :
                        i < 22 ? Theme.accent-2 :
                        Theme.accent-hi;
            animate height { duration: 120ms; easing: ease-in-out; }
        }
    }

    // Botão de microfone grande
    Rectangle {
        x: 134px; y: 160px; width: 52px; height: 52px;
        border-radius: 26px;
        background: Theme.bg-0;
        border-width: 2px;
        border-color: root.listening ? Theme.accent-pink : Theme.accent-hi;
        TouchArea { clicked => { root.mic-tapped(); } }
        // Ícone de microfone estilizado
        Rectangle {
            x: 22px; y: 12px; width: 8px; height: 16px;
            border-radius: 4px;
            background: Theme.accent-2;
        }
        Rectangle {
            x: 17px; y: 26px; width: 18px; height: 2px;
            border-radius: 1px;
            background: Theme.accent-2;
        }
        Rectangle {
            x: 22px; y: 30px; width: 8px; height: 6px;
            border-radius: 2px;
            background: Theme.accent-2;
        }
    }
}
