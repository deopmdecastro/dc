import { Theme } from "theme.slint";

export component ChatView inherits Rectangle {
    in property <float> audio-level: 0.0;
    in property <bool> listening: false;
    callback mic-tapped();
    callback menu-tapped();

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    Rectangle {
        x: 14px; y: 14px; width: 30px; height: 30px;
        border-radius: 15px;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke;
        TouchArea { clicked => { root.menu-tapped(); } }
        Image {
            x: 8px; y: 8px; width: 14px; height: 14px;
            source: @image-url("assets/icons/menu.svg");
            image-fit: contain;
        }
    }

    Rectangle {
        x: 58px; y: 66px; width: 204px; height: 44px;
        border-radius: 22px;
        background: Theme.accent-deep;
        opacity: 0.18;
    }

    Text {
        x: 0px; y: 48px; width: 100%; height: 20px;
        text: "Olá, eu sou o";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 0px; y: 70px; width: 100%; height: 30px;
        text: "DC Assistant";
        color: Theme.accent-cyan;
        font-size: 20px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 0px; y: 102px; width: 100%; height: 16px;
        text: "Como posso ajudar você hoje?";
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    HorizontalLayout {
        x: 40px; y: 136px; width: 240px; height: 34px;
        alignment: center;
        spacing: 3px;
        for i in 32 : Rectangle {
            property <int> dist: i < 16 ? 15 - i : i - 16;
            width: 4px;
            height: 7px + (root.listening ? 16px : 8px) - dist * 0.7px + root.audio-level * (dist < 5 ? 10px : 5px);
            border-radius: 2px;
            y: (parent.height - self.height) / 2;
            background: i < 16 ? Theme.accent-pink : Theme.accent-cyan;
            opacity: root.listening ? 1.0 : 0.75;
            animate height { duration: 120ms; easing: ease-in-out; }
        }
    }

    Rectangle {
        x: 139px; y: 180px; width: 42px; height: 42px;
        border-radius: 21px;
        background: Theme.panel-soft;
        border-width: 2px;
        border-color: root.listening ? Theme.accent-pink : Theme.accent;
        TouchArea { clicked => { root.mic-tapped(); } }
        Rectangle {
            x: 5px; y: 5px; width: 32px; height: 32px;
            border-radius: 16px;
            background: root.listening ? Theme.accent : #00000000;
            opacity: root.listening ? 0.28 : 0.0;
        }
        Image {
            x: 11px; y: 10px; width: 20px; height: 20px;
            source: @image-url("assets/icons/mic.svg");
            image-fit: contain;
        }
    }
}
