import { Theme } from "theme.slint";

export component ChatView inherits Rectangle {
    in property <float> audio-level: 0.0;
    in property <bool> listening: false;
    callback mic-tapped();
    callback menu-tapped();

    property <length> swipe-x: 0px;
    property <bool> swiping: false;

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    TouchArea {
        width: 100%;
        height: 100%;
        moved => {
            if (self.pressed) {
                root.swiping = true;
                root.swipe-x = self.mouse-x - self.pressed-x;
            }
        }
        clicked => {
            if (root.swiping && root.swipe-x < -40px) {
                root.menu-tapped();
            }
            root.swiping = false;
            root.swipe-x = 0px;
        }
    }

    Text {
        x: 0px; y: 40px; width: 320px; height: 18px;
        text: "DC OS";
        color: Theme.text-secondary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0px; y: 64px; width: 320px; height: 28px;
        text: "Assistente pessoal";
        color: Theme.text-primary;
        font-size: 19px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0px; y: 98px; width: 320px; height: 16px;
        text: "Como posso ajudar hoje?";
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Image {
        x: 5px; y: 102px; width: 11px; height: 11px;
        source: @image-url("assets/icons/chevron-left.svg");
        image-fit: contain;
        opacity: 0.35;
    }

    Text {
        x: 0px; y: 118px; width: 30px; height: 10px;
        text: "apps";
        color: Theme.text-dim;
        font-size: 7px;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        x: 42px; y: 136px; width: 236px; height: 32px;
        alignment: center;
        spacing: 4px;
        for i in 32 : Rectangle {
            property <int> dist: i < 16 ? 15 - i : i - 16;
            width: 3px;
            height: root.listening
                ? (dist < 3 ? 22px : dist < 7 ? 18px : dist < 11 ? 14px : 10px)
                : (dist < 5 ? 12px : dist < 10 ? 9px : 6px);
            border-radius: 2px;
            y: (parent.height - self.height) / 2;
            background: root.listening ? Theme.accent : Theme.stroke;
        }
    }

    Rectangle {
        x: 134px; y: 174px; width: 52px; height: 38px;
        border-radius: 19px;
        background: Theme.panel;
        border-width: 1px;
        border-color: root.listening ? Theme.accent-hi : Theme.stroke;
        TouchArea { clicked => { root.mic-tapped(); } }

        Rectangle {
            x: 10px; y: 3px; width: 32px; height: 32px;
            border-radius: 16px;
            background: root.listening ? Theme.accent-deep : #00000000;
        }

        Image {
            x: 16px; y: 9px; width: 20px; height: 20px;
            source: @image-url("assets/icons/mic.svg");
            image-fit: contain;
        }
    }
}
