import { Theme } from "theme.slint";

// ChatView — home screen. Swipe left opens the app launcher.
// The old "Abrir Apps" button has been removed; gesture replaces it.
export component ChatView inherits Rectangle {
    in property <float> audio-level: 0.0;
    in property <bool> listening: false;
    callback mic-tapped();
    callback menu-tapped();

    // Swipe gesture state
    property <length> swipe-x: 0px;
    property <bool> swiping: false;

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // Full-screen TouchArea for swipe detection
    TouchArea {
        width: 100%;
        height: 100%;
        moved => {
            if (self.pressed) {
                root.swiping = true;
                root.swipe-x = self.mouse-x - self.pressed-x;
            }
        }
        clicked => {
            if (root.swiping && root.swipe-x < -40px) {
                root.menu-tapped();
            }
            root.swiping = false;
            root.swipe-x = 0px;
        }
    }

    // Greeting text
    Text {
        x: 0px; y: 48px; width: 100%; height: 20px;
        text: "Ola, eu sou o";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 0px; y: 70px; width: 100%; height: 30px;
        text: "DC Assistant";
        color: Theme.accent-cyan;
        font-size: 20px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 0px; y: 102px; width: 100%; height: 16px;
        text: "Como posso ajudar voce hoje?";
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Swipe hint arrow (left edge)
    Image {
        x: 4px; y: 100px; width: 12px; height: 12px;
        source: @image-url("assets/icons/chevron-left.svg");
        image-fit: contain;
        opacity: 0.3;
    }
    Text {
        x: 0px; y: 118px; width: 30px; height: 10px;
        text: "apps";
        color: Theme.text-dim;
        font-size: 7px;
        horizontal-alignment: center;
    }

    // Audio waveform visualization
    HorizontalLayout {
        x: 40px; y: 136px; width: 240px; height: 34px;
        alignment: center;
        spacing: 3px;
        for i in 32 : Rectangle {
            property <int> dist: i < 16 ? 15 - i : i - 16;
            width: 4px;
            height: root.listening
                ? (dist < 3 ? 24px : dist < 7 ? 20px : dist < 11 ? 16px : 12px)
                : (dist < 5 ? 14px : dist < 10 ? 11px : 8px);
            border-radius: 2px;
            y: (parent.height - self.height) / 2;
            background: i < 16 ? Theme.accent-pink : Theme.accent-cyan;
        }
    }

    // Mic button
    Rectangle {
        x: 132px; y: 173px; width: 56px; height: 42px;
        border-radius: 21px;
        background: Theme.panel-soft;
        border-width: 2px;
        border-color: root.listening ? Theme.accent-pink : Theme.accent;
        TouchArea { clicked => { root.mic-tapped(); } }
        Rectangle {
            x: 12px; y: 5px; width: 32px; height: 32px;
            border-radius: 16px;
            background: root.listening ? Theme.accent-deep : #00000000;
        }
        Image {
            x: 18px; y: 10px; width: 20px; height: 20px;
            source: @image-url("assets/icons/mic.svg");
            image-fit: contain;
        }
    }
}
