import { Theme } from "theme.slint";

export component ControlCenter inherits Rectangle {
    in-out property <float> volume:     0.75;
    in-out property <float> brightness: 0.60;
    in-out property <bool>  wifi-on:      true;
    in-out property <bool>  bluetooth-on: true;
    in-out property <bool>  dnd-on:       false;
    in-out property <bool>  autorotate:   true;

    callback brightness-changed(float);
    callback volume-changed(float);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    Rectangle {
        x: 4px; y: 8px; width: 312px; height: 200px;
        border-radius: Theme.radius-m;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.stroke;
    }

    Rectangle {
        x: 140px; y: 0px; width: 40px; height: 15px;
        border-radius: 7px;
        background: Theme.tile;
        Text {
            text: "\u{2304}";
            color: Theme.text-secondary;
            font-size: Theme.font-lg;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    for tile[index] in [
        { label: "Wi-Fi", icon: "\u{25CF}", active: root.wifi-on, color: Theme.accent-blue },
        { label: "Bluetooth", icon: "B", active: root.bluetooth-on, color: Theme.accent-blue },
        { label: "Não perturbe", icon: "\u{25D4}", active: root.dnd-on, color: Theme.accent },
        { label: "Rotação\nautomática", icon: "\u{21BB}", active: root.autorotate, color: Theme.accent-2 },
    ] : Rectangle {
        x: 17px + index * 73px; y: 26px; width: 66px; height: 62px;
        border-radius: Theme.radius-m;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;
        TouchArea {
            clicked => {
                if (index == 0) { root.wifi-on = !root.wifi-on; }
                if (index == 1) { root.bluetooth-on = !root.bluetooth-on; }
                if (index == 2) { root.dnd-on = !root.dnd-on; }
                if (index == 3) { root.autorotate = !root.autorotate; }
            }
        }
        Rectangle {
            x: 21px; y: 7px; width: 24px; height: 24px;
            border-radius: 12px;
            background: tile.active ? tile.color : Theme.tile-hi;
        }
        Text {
            x: 0px; y: 7px; width: 100%; height: 24px;
            text: tile.icon;
            color: Theme.text-primary;
            font-size: Theme.font-md;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            x: 2px; y: 37px; width: 62px; height: 20px;
            text: tile.label;
            color: Theme.text-primary;
            font-size: 8px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 16px; y: 101px; width: 288px; height: 40px;
        border-radius: Theme.radius-m;
        background: Theme.tile;
        Text { x: 16px; y: 0px; width: 72px; height: 18px; text: "\u{266A}  Volume"; color: Theme.text-primary; font-size: Theme.font-sm; vertical-alignment: center; }
        Text { x: 250px; y: 0px; width: 28px; height: 18px; text: Math.round(root.volume * 100) + "%"; color: Theme.text-secondary; font-size: Theme.font-sm; horizontal-alignment: right; vertical-alignment: center; }
        Rectangle { x: 50px; y: 25px; width: 220px; height: 4px; border-radius: 2px; background: Theme.bg-2;
            Rectangle { width: parent.width * root.volume; height: 100%; border-radius: 2px; background: Theme.accent-blue; }
            Rectangle { x: parent.width * root.volume - 4px; y: -3px; width: 10px; height: 10px; border-radius: 5px; background: Theme.text-primary; }
        }
    }

    Rectangle {
        x: 16px; y: 151px; width: 288px; height: 40px;
        border-radius: Theme.radius-m;
        background: Theme.tile;
        Text { x: 16px; y: 0px; width: 72px; height: 18px; text: "\u{2600}  Brilho"; color: Theme.text-primary; font-size: Theme.font-sm; vertical-alignment: center; }
        Text { x: 250px; y: 0px; width: 28px; height: 18px; text: Math.round(root.brightness * 100) + "%"; color: Theme.text-secondary; font-size: Theme.font-sm; horizontal-alignment: right; vertical-alignment: center; }
        Rectangle { x: 50px; y: 25px; width: 220px; height: 4px; border-radius: 2px; background: Theme.bg-2;
            Rectangle { width: parent.width * root.brightness; height: 100%; border-radius: 2px; background: Theme.accent-hi; }
            Rectangle { x: parent.width * root.brightness - 4px; y: -3px; width: 10px; height: 10px; border-radius: 5px; background: Theme.text-primary; }
        }
    }
}
