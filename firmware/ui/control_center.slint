import { Theme } from "theme.slint";

// Control Center — tiles 45×45 + sliders compactos na parte inferior.
export component ControlCenter inherits Rectangle {
    in-out property <float> volume:     0.75;
    in-out property <float> brightness: 0.60;
    in-out property <bool>  wifi-on:      true;
    in-out property <bool>  bluetooth-on: true;
    in-out property <bool>  dnd-on:       false;
    in-out property <bool>  autorotate:   true;

    callback brightness-changed(float);
    callback volume-changed(float);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // ===== 4 tiles quadradas 45×45 =====
    for tile[index] in [
        { label: "Wi-Fi",            icon: "\u{2301}", active: root.wifi-on,      color: Theme.accent-blue },
        { label: "Bluetooth",        icon: "\u{2960}", active: root.bluetooth-on, color: Theme.accent-blue },
        { label: "Não perturbe",     icon: "\u{25D4}", active: root.dnd-on,       color: Theme.accent      },
        { label: "Rotação automática", icon: "\u{21BB}", active: root.autorotate,  color: Theme.accent-2    },
    ] : Rectangle {
        x: 30px + index * 60px; y: 26px; width: 45px; height: 45px;
        border-radius: 22px;
        background: tile.active ? tile.color : Theme.tile;
        border-width: 1px;
        border-color: tile.active ? tile.color : Theme.stroke;
        TouchArea {
            clicked => {
                if (index == 0) { root.wifi-on = !root.wifi-on; }
                if (index == 1) { root.bluetooth-on = !root.bluetooth-on; }
                if (index == 2) { root.dnd-on = !root.dnd-on; }
                if (index == 3) { root.autorotate = !root.autorotate; }
            }
        }
        Text {
            x: 0px; y: 0px; width: 100%; height: 100%;
            text: tile.icon;
            color: tile.active ? Theme.text-primary : Theme.text-muted;
            font-size: 18px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Labels sob as tiles (1 linha)
    for tile_lbl[index] in [ "Wi-Fi", "Bluetooth", "Não perturbe", "Rotação automática" ] : Text {
        x: 22px + index * 60px; y: 75px; width: 60px; height: 14px;
        text: tile_lbl;
        color: Theme.text-primary;
        font-size: 8px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // ===== Volume slider =====
    Rectangle {
        x: 14px; y: 110px; width: 292px; height: 28px;
        border-radius: Theme.radius-m;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;

        Text { x: 14px; y: 0px; width: 80px; height: 100%;
            text: "\u{266A}  Volume"; color: Theme.text-primary;
            font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; }
        Text { x: 232px; y: 0px; width: 48px; height: 100%;
            text: Math.round(root.volume * 100) + "%"; color: Theme.text-secondary;
            font-size: Theme.font-sm; horizontal-alignment: right; vertical-alignment: center; }

        Rectangle {
            x: 100px; y: 12px; width: 178px; height: 4px;
            border-radius: 2px;
            background: Theme.bg-2;
            Rectangle {
                width: parent.width * root.volume; height: 100%;
                border-radius: 2px;
                background: Theme.accent-blue;
            }
            Rectangle {
                x: parent.width * root.volume - 5px; y: -3px;
                width: 10px; height: 10px;
                border-radius: 5px;
                background: Theme.text-primary;
            }
        }
    }

    // ===== Brightness slider =====
    Rectangle {
        x: 14px; y: 148px; width: 292px; height: 28px;
        border-radius: Theme.radius-m;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;

        Text { x: 14px; y: 0px; width: 80px; height: 100%;
            text: "\u{2600}  Brilho"; color: Theme.text-primary;
            font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; }
        Text { x: 232px; y: 0px; width: 48px; height: 100%;
            text: Math.round(root.brightness * 100) + "%"; color: Theme.text-secondary;
            font-size: Theme.font-sm; horizontal-alignment: right; vertical-alignment: center; }

        Rectangle {
            x: 100px; y: 12px; width: 178px; height: 4px;
            border-radius: 2px;
            background: Theme.bg-2;
            Rectangle {
                width: parent.width * root.brightness; height: 100%;
                border-radius: 2px;
                background: Theme.accent-hi;
            }
            Rectangle {
                x: parent.width * root.brightness - 5px; y: -3px;
                width: 10px; height: 10px;
                border-radius: 5px;
                background: Theme.text-primary;
            }
        }
    }
}
