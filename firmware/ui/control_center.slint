import { Theme } from "theme.slint";

// Control Center — overlay com toggles rápidos e sliders de volume/brilho.
export component ControlCenter inherits Rectangle {
    in-out property <float> volume:     0.75;
    in-out property <float> brightness: 0.60;
    in-out property <bool>  wifi-on:      true;
    in-out property <bool>  bluetooth-on: true;
    in-out property <bool>  dnd-on:       false;
    in-out property <bool>  autorotate:   true;

    callback brightness-changed(float);
    callback volume-changed(float);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // Painel principal
    Rectangle {
        x: 4px; y: 6px; width: 312px; height: 204px;
        border-radius: Theme.radius-m;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.stroke;
    }

    // Puxador (handle) no topo
    Rectangle {
        x: 140px; y: 4px; width: 40px; height: 8px;
        border-radius: 4px;
        background: Theme.tile-hi;
        opacity: 0.7;
    }

    // ===== 4 tiles quadrados de atalho =====
    for tile[index] in [
        { label: "Wi-Fi",            icon: "\u{2301}", active: root.wifi-on,      color: Theme.accent-blue,   shape: 0 },
        { label: "Bluetooth",        icon: "\u{2960}", active: root.bluetooth-on, color: Theme.accent-blue,   shape: 0 },
        { label: "Não perturbe",     icon: "\u{25D4}", active: root.dnd-on,       color: Theme.accent,        shape: 1 },
        { label: "Rotação\nautomática", icon: "\u{21BB}", active: root.autorotate, color: Theme.accent-2,    shape: 0 },
    ] : Rectangle {
        x: 14px + index * 74px; y: 24px; width: 66px; height: 66px;
        border-radius: Theme.radius-m;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;
        TouchArea {
            clicked => {
                if (index == 0) { root.wifi-on = !root.wifi-on; }
                if (index == 1) { root.bluetooth-on = !root.bluetooth-on; }
                if (index == 2) { root.dnd-on = !root.dnd-on; }
                if (index == 3) { root.autorotate = !root.autorotate; }
            }
        }

        // Glow circular do ícone quando ativo
        Rectangle {
            x: 21px; y: 6px; width: 24px; height: 24px;
            border-radius: 12px;
            background: tile.active ? tile.color : Theme.tile-hi;
            opacity: tile.active ? 0.95 : 0.4;
        }
        // Glifo do ícone (canto escuro do glow → texto branco)
        Text {
            x: 0px; y: 6px; width: 100%; height: 24px;
            text: tile.icon;
            color: tile.active ? Theme.text-primary : Theme.text-muted;
            font-size: 13px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            x: 2px; y: 36px; width: 62px; height: 24px;
            text: tile.label;
            color: Theme.text-primary;
            font-size: 8px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== Slider de Volume =====
    Rectangle {
        x: 14px; y: 102px; width: 292px; height: 38px;
        border-radius: Theme.radius-m;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;

        Text {
            x: 14px; y: 0px; width: 86px; height: 18px;
            text: "\u{266A}  Volume";
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            x: 240px; y: 0px; width: 40px; height: 18px;
            text: Math.round(root.volume * 100) + "%";
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Rectangle {
            x: 50px; y: 25px; width: 220px; height: 4px;
            border-radius: 2px;
            background: Theme.bg-2;
            Rectangle {
                width: parent.width * root.volume; height: 100%;
                border-radius: 2px;
                background: Theme.accent-blue;
            }
            Rectangle {
                x: parent.width * root.volume - 5px; y: -3px;
                width: 10px; height: 10px;
                border-radius: 5px;
                background: Theme.text-primary;
            }
        }
    }

    // ===== Slider de Brilho =====
    Rectangle {
        x: 14px; y: 148px; width: 292px; height: 38px;
        border-radius: Theme.radius-m;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;

        Text {
            x: 14px; y: 0px; width: 86px; height: 18px;
            text: "\u{2600}  Brilho";
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            x: 240px; y: 0px; width: 40px; height: 18px;
            text: Math.round(root.brightness * 100) + "%";
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Rectangle {
            x: 50px; y: 25px; width: 220px; height: 4px;
            border-radius: 2px;
            background: Theme.bg-2;
            Rectangle {
                width: parent.width * root.brightness; height: 100%;
                border-radius: 2px;
                background: Theme.accent-hi;
            }
            Rectangle {
                x: parent.width * root.brightness - 5px; y: -3px;
                width: 10px; height: 10px;
                border-radius: 5px;
                background: Theme.text-primary;
            }
        }
    }
}
