import { Theme } from "theme.slint";

export component ControlCenter inherits Rectangle {
    in-out property <float> volume: 0.75;
    in-out property <float> brightness: 0.60;
    in-out property <bool> wifi-on: true;
    in-out property <bool> bluetooth-on: true;
    in-out property <bool> dnd-on: false;
    in-out property <bool> autorotate: true;

    callback brightness-changed(float);
    callback volume-changed(float);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    Rectangle {
        x: 137px; y: 8px; width: 46px; height: 4px;
        border-radius: 2px;
        background: Theme.text-secondary;
        opacity: 0.7;
    }

    for tile[index] in [
        { label: "Wi‑Fi", icon: @image-url("assets/icons/wifi.svg"),       active: root.wifi-on,      color: Theme.accent-blue },
        { label: "Bluetooth", icon: @image-url("assets/icons/bluetooth.svg"), active: root.bluetooth-on, color: Theme.accent-blue },
        { label: "Não perturbe", icon: @image-url("assets/icons/moon.svg"), active: root.dnd-on,       color: Theme.accent },
        { label: "Rotação\nautomática", icon: @image-url("assets/icons/rotate-cw.svg"), active: root.autorotate, color: Theme.accent-cyan },
    ] : Rectangle {
        x: 18px + index * 72px; y: 28px; width: 54px; height: 54px;
        border-radius: 27px;
        background: tile.active ? tile.color : Theme.panel-soft;
        border-width: 1px;
        border-color: tile.active ? tile.color : Theme.stroke;
        TouchArea {
            clicked => {
                if (index == 0) { root.wifi-on = !root.wifi-on; }
                if (index == 1) { root.bluetooth-on = !root.bluetooth-on; }
                if (index == 2) { root.dnd-on = !root.dnd-on; }
                if (index == 3) { root.autorotate = !root.autorotate; }
            }
        }
        Image {
            x: 17px; y: 17px; width: 20px; height: 20px;
            source: tile.icon;
            image-fit: contain;
            opacity: tile.active ? 1.0 : 0.75;
        }
    }

    for label[index] in ["Wi‑Fi", "Bluetooth", "Não perturbe", "Rotação\nautomática"] : Text {
        x: 10px + index * 72px; y: 88px; width: 70px; height: 24px;
        text: label;
        color: Theme.text-primary;
        font-size: 8px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: 14px; y: 122px; width: 292px; height: 30px;
        border-radius: Theme.radius-m;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke;
        Image {
            x: 12px; y: 8px; width: 14px; height: 14px;
            source: @image-url("assets/icons/volume-2.svg");
            image-fit: contain;
        }
        Text {
            x: 32px; y: 0px; width: 90px; height: 100%;
            text: "Volume";
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            x: 236px; y: 0px; width: 44px; height: 100%;
            text: Math.round(root.volume * 100) + "%";
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle {
            x: 88px; y: 13px; width: 148px; height: 4px;
            border-radius: 2px;
            background: Theme.bg-2;
            Rectangle {
                width: parent.width * root.volume; height: 100%;
                border-radius: 2px;
                background: Theme.accent-blue;
            }
            Rectangle {
                x: parent.width * root.volume - 5px; y: -3px;
                width: 10px; height: 10px;
                border-radius: 5px;
                background: Theme.text-primary;
            }
        }
    }

    Rectangle {
        x: 14px; y: 162px; width: 292px; height: 30px;
        border-radius: Theme.radius-m;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke;
        Image {
            x: 12px; y: 8px; width: 14px; height: 14px;
            source: @image-url("assets/icons/sun.svg");
            image-fit: contain;
        }
        Text {
            x: 32px; y: 0px; width: 90px; height: 100%;
            text: "Brilho";
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            x: 236px; y: 0px; width: 44px; height: 100%;
            text: Math.round(root.brightness * 100) + "%";
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle {
            x: 88px; y: 13px; width: 148px; height: 4px;
            border-radius: 2px;
            background: Theme.bg-2;
            Rectangle {
                width: parent.width * root.brightness; height: 100%;
                border-radius: 2px;
                background: Theme.accent;
            }
            Rectangle {
                x: parent.width * root.brightness - 5px; y: -3px;
                width: 10px; height: 10px;
                border-radius: 5px;
                background: Theme.text-primary;
            }
        }
    }
}
