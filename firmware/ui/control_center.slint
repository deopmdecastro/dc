import { Theme } from "theme.slint";

// Slider do control center (Volume, Brilho) com pega arredondada.
component ControlSlider inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <color> accent-color;
    in-out property <float> value;
    callback changed(float);

    border-radius: Theme.radius-m;
    background: Theme.panel-soft;
    border-width: 1px;
    border-color: Theme.stroke;

    Rectangle {
        x: 10px; y: 7px; width: 24px; height: 24px;
        border-radius: 8px;
        background: Theme.bg-2;
        Image { x: 5px; y: 5px; width: 14px; height: 14px; source: root.icon; image-fit: contain; colorize: root.accent-color; }
    }
    Text {
        x: 42px; y: 0px; width: 80px; height: 100%;
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.font-sm;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        x: 250px; y: 0px; width: 40px; height: 100%;
        text: Math.round(root.value * 100) + "%";
        color: root.accent-color;
        font-size: Theme.font-sm;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Rectangle {
        x: 118px; y: 16px; width: 122px; height: 6px;
        border-radius: 3px;
        background: Theme.bg-2;
        Rectangle {
            width: max(6px, parent.width * root.value); height: 100%;
            border-radius: 3px;
            background: root.accent-color;
        }
        Rectangle {
            x: max(0px, parent.width * root.value - 6px); y: -3px;
            width: 12px; height: 12px;
            border-radius: 6px;
            background: Theme.text-primary;
            border-width: 2px;
            border-color: root.accent-color;
        }
        TouchArea {
            clicked => {
                root.value = max(0.0, min(1.0, self.mouse-x / parent.width));
                root.changed(root.value);
            }
            moved => {
                if (self.pressed) {
                    root.value = max(0.0, min(1.0, self.mouse-x / parent.width));
                    root.changed(root.value);
                }
            }
        }
    }
}

export component ControlCenter inherits Rectangle {
    in-out property <float> volume: 0.75;
    in-out property <float> brightness: 0.60;
    in-out property <bool> wifi-on: true;
    in-out property <bool> wifi-connected: false;
    in-out property <bool> bluetooth-on: true;
    in-out property <bool> dnd-on: false;
    in-out property <bool> autorotate: true;
    in property <string> current-time: "--:--";
    in property <int> language-index: 0;

    callback brightness-changed(float);
    callback volume-changed(float);
    callback wifi-changed(bool);
    callback bluetooth-changed(bool);
    callback rotation-changed(bool);

    width: 320px;
    height: 216px;
    background: Theme.bg-1;

    // Pega de arrastar
    Rectangle {
        x: 137px; y: 8px; width: 46px; height: 4px;
        border-radius: 2px;
        background: Theme.stroke;
    }

    Text {
        x: 16px; y: 16px; width: 200px; height: 16px;
        text: root.language-index == 2 ? "Control Center" :
              root.language-index == 3 ? "Centre de controle" :
              root.language-index == 4 ? "Centro de control" : "Centro de Controlo";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
    }

    // Relogio no canto superior direito do Control Center, em destaque
    Text {
        x: 232px; y: 16px; width: 76px; height: 16px;
        text: root.current-time;
        color: Theme.accent;
        font-size: Theme.font-md;
        font-weight: 800;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // Tiles de toggle rapidos
    for tile[index] in [
        { label: root.language-index == 2 ? "Wi-Fi" : root.language-index == 3 ? "Wi-Fi" : root.language-index == 4 ? "Wi-Fi" : "Wi-Fi", icon: @image-url("assets/icons/wifi.svg"), active: root.wifi-on, color: Theme.accent-blue },
        { label: root.language-index == 2 ? "Bluetooth" : root.language-index == 3 ? "Bluetooth" : root.language-index == 4 ? "Bluetooth" : "Bluetooth", icon: @image-url("assets/icons/bluetooth.svg"), active: root.bluetooth-on, color: Theme.accent },
        { label: root.language-index == 2 ? "Do not disturb" : root.language-index == 3 ? "Ne pas deranger" : root.language-index == 4 ? "No molestar" : "Nao perturbe", icon: @image-url("assets/icons/moon.svg"), active: root.dnd-on, color: Theme.accent-violet },
        { label: root.language-index == 2 ? "Orientation" : root.language-index == 3 ? "Orientation" : root.language-index == 4 ? "Orientacion" : "Orientacao", icon: @image-url("assets/icons/rotate-cw.svg"), active: root.autorotate, color: Theme.accent-cyan },
    ] : Rectangle {
        x: 12px + index * 75px; y: 40px; width: 64px; height: 52px;
        border-radius: Theme.radius-m;
        background: tile.active ? tile.color : Theme.panel-soft;
        border-width: 1px;
        border-color: tile.active ? tile.color : Theme.stroke;
        animate background { duration: 130ms; }
        ta := TouchArea {
            clicked => {
                if (index == 0) { root.wifi-on = !root.wifi-on; root.wifi-changed(root.wifi-on); }
                if (index == 1) { root.bluetooth-on = !root.bluetooth-on; root.bluetooth-changed(root.bluetooth-on); }
                if (index == 2) { root.dnd-on = !root.dnd-on; }
                if (index == 3) { root.autorotate = !root.autorotate; root.rotation-changed(root.autorotate); }
            }
        }
        Image {
            x: 22px; y: 15px; width: 20px; height: 20px;
            source: tile.icon; image-fit: contain;
            colorize: tile.active ? Theme.bg-0 : Theme.text-secondary;
        }
    }

    for label[index] in [
        root.language-index == 2 ? "Wi-Fi" : root.language-index == 3 ? "Wi-Fi" : root.language-index == 4 ? "Wi-Fi" : "Wi-Fi",
        root.language-index == 2 ? "Bluetooth" : root.language-index == 3 ? "Bluetooth" : root.language-index == 4 ? "Bluetooth" : "Bluetooth",
        root.language-index == 2 ? "DND" : root.language-index == 3 ? "NPD" : root.language-index == 4 ? "DND" : "N. perturbe",
        root.language-index == 2 ? "Orientation" : root.language-index == 3 ? "Orientation" : root.language-index == 4 ? "Orientacion" : "Orientacao"
    ] : Text {
        x: 12px + index * 75px; y: 94px; width: 64px; height: 12px;
        text: label;
        color: Theme.text-secondary;
        font-size: 8px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ControlSlider {
        x: 12px; y: 118px; width: 296px; height: 36px;
        label: root.language-index == 2 ? "Volume" : root.language-index == 3 ? "Volume" : root.language-index == 4 ? "Volumen" : "Volume";
        icon: @image-url("assets/icons/volume-2.svg");
        accent-color: Theme.accent-blue;
        value <=> root.volume;
        changed(v) => { root.volume-changed(v); }
    }

    ControlSlider {
        x: 12px; y: 160px; width: 296px; height: 36px;
        label: root.language-index == 2 ? "Brightness" : root.language-index == 3 ? "Luminosite" : root.language-index == 4 ? "Brillo" : "Brilho";
        icon: @image-url("assets/icons/sun.svg");
        accent-color: Theme.warning;
        value <=> root.brightness;
        changed(v) => { root.brightness-changed(v); }
    }
}
