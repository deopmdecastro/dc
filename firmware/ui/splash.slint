import { Theme } from "theme.slint";

export component SplashScreen inherits Rectangle {
    width: 320px;
    height: 240px;

    // Fundo com degradê radial sutil partindo do centro
    background: @radial-gradient(circle, Theme.accent-deep 0%, Theme.bg-0 70%);

    // Layout principal centralizado
    VerticalLayout {
        alignment: center;
        spacing: 14px;

        // Logo
        Image {
            height: 48px;
            source: @image-url("assets/branding/dc-assistant-logo-white.png");
            image-fit: contain;
            horizontal-alignment: center;
        }

        // Nome do Sistema
        Text {
            text: "DC OS";
            color: Theme.text-primary;
            font-size: Theme.font-md;
            font-weight: 700;
            horizontal-alignment: center;
            letter-spacing: 2px;
        }

        // Barra de progresso centralizada
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 120px;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.bg-2;
                clip: true;

                Rectangle {
                    property <length> anim-offset: (animation-tick() / 10ms) * 1px;
                    x: -60px + mod(self.anim-offset, 180px);
                    width: 60px;
                    height: 100%;
                    border-radius: 1.5px;
                    background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent-hi 100%);
                }
            }
        }
    }
}
