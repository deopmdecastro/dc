import { Theme } from "theme.slint";

// Splash escuro e estavel para o firmware. Evita animacoes, gradientes e
// opacidades fracionarias porque o backend LLVM-Xtensa pode falhar ao
// compilar constantes float geradas pelo Slint.
export component SplashScreen inherits Rectangle {
    width: 320px;
    height: 240px;
    background: Theme.bg-0;

    Rectangle {
        x: 44px; y: 42px; width: 232px; height: 156px;
        border-radius: 78px;
        background: Theme.bg-1;
        border-width: 1px;
        border-color: Theme.accent-deep;
    }
    Rectangle {
        x: 84px; y: 86px; width: 152px; height: 52px;
        border-radius: 26px;
        background: #00000000;
        border-width: 2px;
        border-color: Theme.accent;
    }
    Rectangle {
        x: 114px; y: 98px; width: 92px; height: 28px;
        border-radius: 14px;
        background: #00000000;
        border-width: 2px;
        border-color: Theme.accent-cyan;
    }
    Image {
        x: 60px;
        y: 60px;
        width: 200px;
        height: 120px;
        source: @image-url("assets/branding/dc-assistant-logo-white.png");
        image-fit: contain;
    }
}
