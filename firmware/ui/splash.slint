import { Theme } from "theme.slint";

// Splash — logo "DC OS" + subtítulo + plataforma circular pulsante.
export component SplashScreen inherits Rectangle {
    width: 320px;
    height: 240px;
    background: Theme.bg-0;

    property <float> pulse: 0;
    animate pulse { duration: 1400ms; easing: ease-in-out; iteration-count: -1; direction: alternate; }
    init => { self.pulse = 1; }

    // ======= "Estágio" circular inferior =======
    // Halo roxo difuso
    Rectangle {
        x: 30px; y: 162px; width: 260px; height: 38px;
        border-radius: 19px;
        background: #37128E;
        opacity: 0.55;
    }
    // Anel de luz cyan
    Rectangle {
        x: 60px; y: 168px; width: 200px; height: 24px;
        border-radius: 12px;
        background: Theme.accent-2;
        opacity: 0.18 + root.pulse * 0.22;
    }
    // Linha de brilho central
    Rectangle {
        x: 86px; y: 178px; width: 148px; height: 4px;
        border-radius: 2px;
        background: Theme.accent-2;
        opacity: 0.65;
    }
    // Núcleo magenta
    Rectangle {
        x: 118px; y: 174px; width: 84px; height: 12px;
        border-radius: 6px;
        background: Theme.accent-pink;
        opacity: 0.55;
    }
    // Pontos de luz orbitando (efeito do palco)
    Rectangle {
        x: 64px; y: 184px; width: 6px; height: 6px;
        border-radius: 3px;
        background: Theme.text-primary;
        opacity: 0.85;
    }
    Rectangle {
        x: 250px; y: 184px; width: 6px; height: 6px;
        border-radius: 3px;
        background: Theme.text-primary;
        opacity: 0.85;
    }

    // ======= Logo "DC" em gradiente (cyan→magenta) =======
    Text {
        x: 0px; y: 38px; width: 100%; height: 64px;
        text: "DC";
        color: Theme.accent-2;
        font-size: 64px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // "Echo" magenta sutil para simular o blend do gradiente do mockup
    Text {
        x: 1px; y: 39px; width: 100%; height: 64px;
        text: "DC";
        color: Theme.accent-pink;
        font-size: 64px;
        font-weight: 800;
        opacity: 0.35;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // ======= Título =======
    Text {
        x: 0px; y: 108px; width: 100%; height: 30px;
        text: "DC OS";
        color: Theme.text-primary;
        font-size: Theme.font-xxl;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0px; y: 140px; width: 100%; height: 18px;
        text: "Seu assistente pessoal";
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
