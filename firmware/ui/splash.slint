import { Theme } from "theme.slint";

export component SplashScreen inherits Rectangle {
    width: 320px;
    height: 240px;
    background: Theme.bg-0;

    Rectangle {
        x: 34px; y: 52px; width: 252px; height: 128px;
        border-radius: Theme.radius-m;
        background: Theme.bg-1;
        border-width: 1px;
        border-color: Theme.stroke-soft;
    }

    Image {
        x: 94px;
        y: 72px;
        width: 132px;
        height: 78px;
        source: @image-url("assets/branding/dc-assistant-logo-white.png");
        image-fit: contain;
    }

    Rectangle {
        x: 96px; y: 172px; width: 128px; height: 2px;
        background: Theme.accent;
    }

    Text {
        x: 0px; y: 186px; width: 320px; height: 16px;
        text: "DC OS";
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
