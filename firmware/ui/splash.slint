import { Theme } from "theme.slint";

export component SplashScreen inherits Rectangle {
    width: 320px;
    height: 240px;

    // Fundo com degrade radial subtil partindo do centro
    background: @radial-gradient(circle, Theme.accent-deep 0%, Theme.bg-0 65%);

    VerticalLayout {
        alignment: center;
        spacing: 16px;

        // Logo
        Image {
            height: 50px;
            source: @image-url("assets/branding/dc-assistant-logo-white.png");
            image-fit: contain;
            horizontal-alignment: center;
        }

        // Nome do sistema
        Text {
            text: "DC OS";
            color: Theme.text-primary;
            font-size: Theme.font-lg;
            font-weight: 800;
            horizontal-alignment: center;
            letter-spacing: 3px;
        }

        // Subtitulo
        Text {
            text: "Assistente pessoal";
            color: Theme.accent-hi;
            font-size: Theme.font-xs;
            horizontal-alignment: center;
            letter-spacing: 1px;
        }

        // Barra de progresso indeterminada
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 140px;
                height: 4px;
                border-radius: 2px;
                background: Theme.bg-2;
                clip: true;
                Rectangle {
                    property <length> anim-offset: (animation-tick() / 8ms) * 1px;
                    x: -70px + mod(self.anim-offset, 210px);
                    width: 70px;
                    height: 100%;
                    border-radius: 2px;
                    background: @linear-gradient(90deg, Theme.bg-2 0%, Theme.accent 50%, Theme.bg-2 100%);
                }
            }
        }
    }
}
