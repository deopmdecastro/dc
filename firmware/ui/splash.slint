import { Theme } from "theme.slint";

// Splash — "DC" sobre plataforma neon pulsante. y-pos alinhado à referência.
export component SplashScreen inherits Rectangle {
    width: 320px;
    height: 240px;
    background: Theme.bg-0;

    property <float> pulse: 0;
    animate pulse { duration: 1400ms; easing: ease-in-out; iteration-count: -1; direction: alternate; }
    init => { self.pulse = 1; }

    // Plataforma circular inferior (y=165-200, ~35 px)
    Rectangle {
        x: 50px; y: 165px; width: 220px; height: 35px;
        border-radius: 18px;
        background: Theme.accent-deep;
        opacity: 0.55;
    }
    Rectangle {
        x: 80px; y: 170px; width: 160px; height: 24px;
        border-radius: 12px;
        background: Theme.accent;
        opacity: 0.25 + root.pulse * 0.3;
    }
    Rectangle {
        x: 110px; y: 178px; width: 100px; height: 4px;
        border-radius: 2px;
        background: Theme.accent-2;
        opacity: 0.85;
    }
    Rectangle {
        x: 134px; y: 173px; width: 52px; height: 16px;
        border-radius: 8px;
        background: Theme.accent-pink;
        opacity: 0.55;
    }

    // Logo "DC" centrado (y=20-100)
    Text {
        x: 0px; y: 36px; width: 100%; height: 64px;
        text: "DC";
        color: Theme.accent-2;
        font-size: 64px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 2px; y: 40px; width: 100%; height: 64px;
        text: "DC";
        color: Theme.accent-pink;
        font-size: 64px;
        font-weight: 800;
        opacity: 0.5;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Subtítulo do título (y=110-130)
    Text {
        x: 0px; y: 110px; width: 100%; height: 20px;
        text: "DC OS";
        color: Theme.text-primary;
        font-size: Theme.font-xl;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0px; y: 134px; width: 100%; height: 14px;
        text: "Seu assistente pessoal";
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
