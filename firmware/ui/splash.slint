import { Theme } from "theme.slint";

// Splash minimalista estilo iPhone:
// - fundo escuro sólido com um leve gradiente radial (via camadas de aura)
// - apenas o logo branco DC ao centro
// - fade in suave, breve hold, fade out (transição moderna, sem barra de progresso)
// - sem texto
export component SplashScreen inherits Rectangle {
    width: 320px;
    height: 240px;
    background: Theme.bg-0;

    // 0 = invisivel, 1 = totalmente visivel
    property <float> fade: 0;
    // Fica ligeiramente maior no fim (efeito "breathing" subtil, tipo iOS)
    property <float> scale: 0.96;

    animate fade  { duration: 900ms; easing: ease-in-out; }
    animate scale { duration: 1400ms; easing: ease-out; }

    init => {
        self.fade = 1.0;
        self.scale = 1.0;
    }

    // Gradiente radial subtil: aura violeta atras do logo (dark background,
    // mantem o feel do mockup mas sem elementos de "loading").
    // Usa @radial-gradient a desvanecer para transparente em vez de
    // retangulos solidos empilhados — isso e o que causava o efeito de
    // "aneis"/degrade rigido (bordas duras entre camadas de opacidade fixa).
    Rectangle {
        x: 20px; y: 10px; width: 280px; height: 220px;
        border-radius: 110px;
        background: @radial-gradient(circle, Theme.accent-violet 0%, transparent 65%);
        opacity: 0.55 * root.fade;
    }
    Rectangle {
        x: 65px; y: 45px; width: 190px; height: 150px;
        border-radius: 75px;
        background: @radial-gradient(circle, Theme.accent 0%, transparent 70%);
        opacity: 0.6 * root.fade;
    }
    Rectangle {
        x: 105px; y: 75px; width: 110px; height: 90px;
        border-radius: 45px;
        background: @radial-gradient(circle, Theme.accent-hi 0%, transparent 75%);
        opacity: 0.5 * root.fade;
    }

    // Logo branco oficial, centrado. Escala leve para um "hero" iOS-like.
    Image {
        // Centra manualmente aplicando padding em torno de 320x240
        x: 60px + (1 - root.scale) * 20px;
        y: 60px + (1 - root.scale) * 15px;
        width:  200px * root.scale;
        height: 120px * root.scale;
        source: @image-url("assets/branding/dc-assistant-logo-white.png");
        image-fit: contain;
        opacity: root.fade;
    }
}
