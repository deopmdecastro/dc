import { Theme } from "theme.slint";

// Barra de status fixa no topo (24 px) — relógio centralizado,
// Wi-Fi + Bluetooth à direita.
export component StatusBar inherits Rectangle {
    in property <string> current-time: "09:42";
    in property <bool>   wifi-on:      true;
    in property <bool>   bluetooth-on: true;

    height: 24px;
    background: Theme.bg-0;

    Text {
        x: 0px; y: 0px; width: 100%; height: 100%;
        text: root.current-time;
        color: Theme.text-primary;
        font-size: Theme.font-sm;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    HorizontalLayout {
        x: parent.width - 56px; y: 0px; width: 48px; height: 100%;
        spacing: 8px;

        Text {
            text: root.wifi-on ? "\u{2301}" : "\u{25CB}";
            color: root.wifi-on ? Theme.text-primary : Theme.text-muted;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: "\u{2960}";
            color: root.bluetooth-on ? Theme.text-primary : Theme.text-muted;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}
