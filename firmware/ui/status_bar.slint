import { Theme } from "theme.slint";

export component StatusBar inherits Rectangle {
    in property <string> current-time: "09:42";
    in property <bool> wifi-on: true;
    in property <bool> bluetooth-on: true;

    height: 24px;
    background: Theme.bg-0;

    Rectangle {
        x: 0px; y: 23px; width: parent.width; height: 1px;
        background: Theme.stroke-soft;
        opacity: 0.8;
    }

    Text {
        x: 0px; y: 0px; width: 100%; height: 100%;
        text: root.current-time;
        color: Theme.text-primary;
        font-size: Theme.font-sm;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Image {
        x: 272px; y: 6px; width: 14px; height: 14px;
        source: @image-url("assets/icons/wifi.svg");
        image-fit: contain;
        opacity: root.wifi-on ? 1.0 : 0.35;
    }

    Image {
        x: 294px; y: 6px; width: 14px; height: 14px;
        source: @image-url("assets/icons/bluetooth.svg");
        image-fit: contain;
        opacity: root.bluetooth-on ? 1.0 : 0.35;
    }
}
