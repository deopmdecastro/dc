import { Theme } from "theme.slint";

export component StatusBar inherits Rectangle {
    in property <string> current-time: "09:42";
    in property <bool>   wifi-on:      true;
    in property <bool>   bluetooth-on: true;

    height: 24px;
    background: Theme.bg-0;

    Text {
        x: 0px; y: 0px; width: 100%; height: 100%;
        text: root.current-time;
        color: Theme.text-primary;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    HorizontalLayout {
        x: parent.width - 58px; y: 0px; width: 48px; height: 100%;
        spacing: 8px;
        Text {
            text: root.wifi-on ? "\u{25E0}" : "\u{25CB}";
            color: root.wifi-on ? Theme.text-primary : Theme.text-muted;
            font-size: Theme.font-lg;
            vertical-alignment: center;
        }
        Text {
            text: "B";
            color: root.bluetooth-on ? Theme.text-primary : Theme.text-muted;
            font-size: Theme.font-md;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}
