import { Theme } from "theme.slint";

export component FeaturesPanel inherits Rectangle {
    in property <bool> wifi-on: true;
    in property <bool> bluetooth-on: false;
    in property <bool> api-online: false;
    in property <int> language-index: 0;
    callback back();

    property <string> title:
        root.language-index == 2 ? "Features" :
        root.language-index == 3 ? "Fonctions" :
        root.language-index == 4 ? "Funciones" : "Recursos";

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    Rectangle { x: 0px; y: 0px; width: 320px; height: 34px; background: Theme.bg-1; Rectangle { x: 0px; y: 33px; width: 320px; height: 1px; background: Theme.stroke-soft; } }
    Rectangle {
        x: 6px; y: 4px; width: 34px; height: 28px;
        border-radius: Theme.radius-s;
        background: bk.pressed ? Theme.panel-elevated : #00000000;
        bk := TouchArea { clicked => { root.back(); } }
        Image { x: 9px; y: 7px; width: 14px; height: 14px; source: @image-url("assets/icons/chevron-left.svg"); image-fit: contain; colorize: Theme.accent; }
    }
    Text {
        x: 0px; y: 0px; width: 320px; height: 34px;
        text: root.title;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    for item[index] in [
        { title: "Spotify", detail: root.api-online ? "API pronta" : "Aguardando API", icon: @image-url("assets/icons/spotify.svg"), tint: Theme.success },
        { title: "Wi-Fi", detail: root.wifi-on ? "Scan e senha ativos" : "Desligado", icon: @image-url("assets/icons/wifi.svg"), tint: Theme.accent-blue },
        { title: "Clima", detail: "Open-Meteo por regiao", icon: @image-url("assets/icons/cloud.svg"), tint: Theme.accent-cyan },
        { title: "Bluetooth", detail: root.bluetooth-on ? "BLE ligado" : "BLE desligado", icon: @image-url("assets/icons/bluetooth.svg"), tint: Theme.accent-violet },
    ] : Rectangle {
        x: index == 0 || index == 2 ? 16px : 162px;
        y: index < 2 ? 48px : 118px;
        width: 136px; height: 58px;
        border-radius: Theme.radius-s;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        Rectangle { x: 8px; y: 8px; width: 24px; height: 24px; border-radius: 8px; background: Theme.bg-2; }
        Image { x: 13px; y: 13px; width: 14px; height: 14px; source: item.icon; image-fit: contain; colorize: item.tint; }
        Text { x: 40px; y: 8px; width: 84px; height: 14px; text: item.title; color: Theme.text-primary; font-size: Theme.font-sm; font-weight: 800; overflow: elide; }
        Text { x: 40px; y: 25px; width: 84px; height: 22px; text: item.detail; color: Theme.text-muted; font-size: 8px; wrap: word-wrap; overflow: elide; }
    }
}
