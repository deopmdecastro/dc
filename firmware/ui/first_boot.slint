import { Theme } from "theme.slint";

// First boot — setup inicial (senha, região, idioma).
export component PasscodeSetup inherits Rectangle {
    in-out property <string> passcode: "";
    callback confirm(string);

    width: 100%; height: 100%;
    background: Theme.bg-1;

    VerticalLayout {
        padding: 8px; spacing: 4px;
        Text { text: "Definir Senha"; color: Theme.text-primary; font-size: Theme.font-lg;
               horizontal-alignment: center; }
        Text { text: "Crie uma senha para proteger o DC Assistant.";
               color: Theme.text-secondary; font-size: Theme.font-xs;
               horizontal-alignment: center; wrap: word-wrap; }

        // dots
        HorizontalLayout {
            alignment: center; spacing: 8px;
            for i in 5: Rectangle {
                width: 10px; height: 10px; border-radius: 5px;
                background: i < root.passcode.character-count ? Theme.accent : Theme.surface;
            }
        }

        // Keypad 3×4
        for row in [[ "1","2","3","4","5" ], [ "6","7","8","9","0" ]] : HorizontalLayout {
            spacing: 6px; alignment: center;
            for k in row : Rectangle {
                width: 46px; height: 34px; border-radius: Theme.radius-s;
                background: Theme.surface;
                TouchArea {
                    clicked => {
                        if (root.passcode.character-count < 5) {
                            root.passcode = root.passcode + k;
                        }
                    }
                }
                Text { text: k; color: Theme.text-primary; font-size: Theme.font-md;
                       horizontal-alignment: center; vertical-alignment: center; }
            }
        }

        Rectangle {
            width: 46px; height: 30px; border-radius: Theme.radius-s;
            background: Theme.accent; x: parent.width - self.width - 12px;
            TouchArea { clicked => { root.confirm(root.passcode); } }
            Text { text: "OK"; color: Theme.text-primary; font-size: Theme.font-sm;
                   horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

export component RegionLanguage inherits Rectangle {
    in-out property <string> region:   "Brasil";
    in-out property <string> language: "Português (Brasil)";
    callback continue-clicked();

    width: 100%; height: 100%;
    background: Theme.bg-1;

    VerticalLayout {
        padding: 12px; spacing: 8px;
        Text { text: "Selecione sua Região"; color: Theme.text-primary; font-size: Theme.font-md; }
        Rectangle {
            height: 32px; border-radius: Theme.radius-m; background: Theme.surface;
            Text { text: "\u{1F1E7}\u{1F1F7}  " + root.region;
                   color: Theme.text-primary; font-size: Theme.font-sm;
                   x: 10px; vertical-alignment: center; }
        }
        Text { text: "Selecione seu Idioma"; color: Theme.text-primary; font-size: Theme.font-md; }
        Rectangle {
            height: 32px; border-radius: Theme.radius-m; background: Theme.surface;
            Text { text: root.language; color: Theme.text-primary; font-size: Theme.font-sm;
                   x: 10px; vertical-alignment: center; }
        }
        Rectangle {
            height: 36px; border-radius: Theme.radius-m; background: Theme.accent;
            TouchArea { clicked => { root.continue-clicked(); } }
            Text { text: "Continuar"; color: Theme.text-primary; font-size: Theme.font-md;
                   horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}
