import { Theme } from "theme.slint";

// Definição de senha no primeiro boot.
export component PasscodeSetup inherits Rectangle {
    in-out property <string> passcode: "";
    callback confirm(string);

    width: 320px;
    height: 240px;
    background: Theme.bg-1;

    Text {
        x: 0px; y: 14px; width: 100%; height: 22px;
        text: "Definir Senha";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 45px; y: 42px; width: 230px; height: 30px;
        text: "Crie uma senha para proteger\nseu DC Assistant.";
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Indicadores de senha (5 bolinhas)
    HorizontalLayout {
        x: 91px; y: 82px; width: 138px; height: 14px;
        spacing: 14px;
        for i in 5: Rectangle {
            width: 12px; height: 12px;
            border-radius: 6px;
            background: i < root.passcode.character-count ? Theme.accent-hi : #00000000;
            border-width: 1px;
            border-color: i < root.passcode.character-count ? Theme.accent-hi : Theme.text-muted;
        }
    }

    // Teclado numérico 2x5
    for row[index] in [[ "1","2","3","4","5" ], [ "6","7","8","9","0" ]] : HorizontalLayout {
        x: 50px; y: 110px + index * 40px; width: 220px; height: 32px;
        spacing: 8px;
        for k in row : Rectangle {
            width: 38px; height: 32px;
            border-radius: Theme.radius-s;
            background: Theme.tile;
            border-width: 1px;
            border-color: Theme.stroke;

            TouchArea {
                clicked => {
                    if (root.passcode.character-count < 5) {
                        root.passcode = root.passcode + k;
                    }
                }
            }

            Text {
                text: k;
                color: Theme.text-primary;
                font-size: Theme.font-lg;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // Botão de confirmar (substitui o "0" após digitado)
    Rectangle {
        x: 218px; y: 196px; width: 52px; height: 32px;
        border-radius: Theme.radius-m;
        background: Theme.accent;
        TouchArea { clicked => { root.confirm(root.passcode); } }
        Text {
            text: "\u{2713}";
            color: Theme.text-primary;
            font-size: Theme.font-xl;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Seleção de região e idioma.
export component RegionLanguage inherits Rectangle {
    in-out property <string> region:   "Brasil";
    in-out property <string> language: "Português (Brasil)";
    callback continue-clicked();

    width: 320px;
    height: 240px;
    background: Theme.bg-1;

    Text {
        x: 0px; y: 18px; width: 100%; height: 22px;
        text: "Selecione sua Região";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Linha de seleção de Região com bandeira
    Rectangle {
        x: 42px; y: 56px; width: 236px; height: 38px;
        border-radius: Theme.radius-m;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;

        // Mini bandeira do Brasil (verde com losango amarelo e círculo)
        Rectangle {
            x: 12px; y: 8px; width: 22px; height: 22px;
            border-radius: 11px;
            background: #009C3B;
            Text {
                text: "\u{25C6}";
                color: #FFDF00;
                font-size: 14px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Text {
                text: "\u{25CF}";
                color: #002776;
                font-size: 8px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            x: 46px; y: 0px; width: 160px; height: 100%;
            text: root.region;
            color: Theme.text-primary;
            font-size: Theme.font-md;
            vertical-alignment: center;
        }
        Text {
            x: parent.width - 22px; y: 0px; width: 16px; height: 100%;
            text: "\u{203A}";
            color: Theme.text-secondary;
            font-size: Theme.font-xl;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 0px; y: 116px; width: 100%; height: 22px;
        text: "Selecione seu Idioma";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: 42px; y: 156px; width: 236px; height: 38px;
        border-radius: Theme.radius-m;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;

        TouchArea { }

        Text {
            x: 14px; y: 0px; width: 200px; height: 100%;
            text: root.language;
            color: Theme.text-primary;
            font-size: Theme.font-md;
            vertical-alignment: center;
        }
        Text {
            x: parent.width - 22px; y: 0px; width: 16px; height: 100%;
            text: "\u{203A}";
            color: Theme.text-secondary;
            font-size: Theme.font-xl;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 42px; y: 210px; width: 236px; height: 28px;
        border-radius: Theme.radius-m;
        background: Theme.accent;
        TouchArea { clicked => { root.continue-clicked(); } }
        Text {
            text: "Continuar";
            color: Theme.text-primary;
            font-size: Theme.font-md;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
