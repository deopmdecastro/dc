import { Theme } from "theme.slint";

component LocalePicker inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <image> icon;
    callback clicked();

    border-radius: Theme.radius-m;
    background: t.pressed ? Theme.panel-elevated : Theme.panel-soft;
    border-width: 1px;
    border-color: Theme.stroke;
    animate background { duration: 120ms; }
    t := TouchArea { clicked => { root.clicked(); } }
    Rectangle {
        x: 12px; y: 11px; width: 26px; height: 26px;
        border-radius: 8px;
        background: Theme.bg-2;
        Image { x: 6px; y: 6px; width: 14px; height: 14px; source: root.icon; image-fit: contain; colorize: Theme.accent; }
    }
    Text {
        x: 48px; y: 8px; width: 150px; height: 12px;
        text: root.title;
        color: Theme.text-muted;
        font-size: Theme.font-xs;
        font-weight: 600;
    }
    Text {
        x: 48px; y: 22px; width: 190px; height: 18px;
        text: root.value;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 236px; y: 0px; width: 20px; height: 100%;
        text: ">";
        color: Theme.text-muted;
        font-size: Theme.font-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component PasscodeSetup inherits Rectangle {
    in-out property <string> d0: "";
    in-out property <string> d1: "";
    in-out property <string> d2: "";
    in-out property <string> d3: "";
    in-out property <string> d4: "";
    in-out property <int> filled: 0;

    property <int> pin-length: 5;
    property <string> passcode-str: root.d0 + root.d1 + root.d2 + root.d3 + root.d4;

    callback confirm(string);

    width: 320px;
    height: 240px;
    background: Theme.bg-0;

    // Cabecalho com icone de escudo
    Rectangle {
        x: 143px; y: 12px; width: 34px; height: 34px;
        border-radius: 11px;
        background: Theme.accent-tint;
        border-width: 1px;
        border-color: Theme.accent-deep;
        Image { x: 8px; y: 8px; width: 18px; height: 18px; source: @image-url("assets/icons/shield.svg"); image-fit: contain; colorize: Theme.accent; }
    }
    Text {
        x: 0px; y: 50px; width: 320px; height: 20px;
        text: "Definir PIN";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 30px; y: 70px; width: 260px; height: 14px;
        text: "Crie uma senha para proteger o assistente.";
        color: Theme.text-secondary;
        font-size: Theme.font-xs;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    HorizontalLayout {
        x: 118px; y: 90px; width: 84px; height: 12px;
        spacing: 10px;
        for i in root.pin-length: Rectangle {
            width: 12px; height: 12px;
            border-radius: 6px;
            background: i < root.filled ? Theme.accent : #00000000;
            border-width: 1.5px;
            border-color: i < root.filled ? Theme.accent-hi : Theme.text-muted;
        }
    }

    for row[index] in [[ "1","2","3","4","5" ], [ "6","7","8","9","0" ]] : HorizontalLayout {
        x: 30px; y: 110px + index * 40px; width: 260px; height: 34px;
        spacing: 8px;
        for k in row : Rectangle {
            width: 45px; height: 34px;
            border-radius: Theme.radius-s;
            background: tk.pressed ? Theme.accent-deep : Theme.panel-soft;
            border-width: 1px;
            border-color: tk.pressed ? Theme.accent : Theme.stroke;
            tk := TouchArea {
                clicked => {
                    if (root.filled < root.pin-length) {
                        if      (root.filled == 0) { root.d0 = k; }
                        else if (root.filled == 1) { root.d1 = k; }
                        else if (root.filled == 2) { root.d2 = k; }
                        else if (root.filled == 3) { root.d3 = k; }
                        else if (root.filled == 4) { root.d4 = k; }
                        root.filled = root.filled + 1;
                    }
                }
            }
            Text {
                text: k;
                color: Theme.text-primary;
                font-size: Theme.font-lg;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    Rectangle {
        x: 30px; y: 196px; width: 60px; height: 34px;
        border-radius: Theme.radius-s;
        background: root.filled > 0 ? Theme.panel-elevated : Theme.panel-soft;
        border-width: 1px;
        border-color: root.filled > 0 ? Theme.stroke : Theme.text-dim;
        tdel := TouchArea {
            clicked => {
                if (root.filled > 0) {
                    root.filled = root.filled - 1;
                    if      (root.filled == 0) { root.d0 = ""; }
                    else if (root.filled == 1) { root.d1 = ""; }
                    else if (root.filled == 2) { root.d2 = ""; }
                    else if (root.filled == 3) { root.d3 = ""; }
                    else if (root.filled == 4) { root.d4 = ""; }
                }
            }
        }
        Image { x: 20px; y: 9px; width: 20px; height: 16px; source: @image-url("assets/icons/delete-left.svg"); image-fit: contain; colorize: Theme.text-secondary; }
    }

    Rectangle {
        x: 100px; y: 196px; width: 190px; height: 34px;
        border-radius: Theme.radius-s;
        background: root.filled == root.pin-length ? Theme.accent : Theme.accent-deep;
        border-width: 1px;
        border-color: root.filled == root.pin-length ? Theme.accent-hi : Theme.stroke;
        tok := TouchArea {
            clicked => {
                if (root.filled == root.pin-length) {
                    root.confirm(root.passcode-str);
                }
            }
        }
        Image { x: 66px; y: 9px; width: 18px; height: 16px; source: @image-url("assets/icons/check.svg"); image-fit: contain; colorize: root.filled == root.pin-length ? Theme.bg-0 : Theme.text-secondary; }
        Text { x: 90px; y: 0px; width: 90px; height: 100%; text: "Confirmar"; color: root.filled == root.pin-length ? Theme.bg-0 : Theme.text-secondary; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    }
}

export component RegionLanguage inherits Rectangle {
    in-out property <int> region-index: 0;
    in-out property <int> language-index: 0;

    property <string> region-label:
        root.region-index == 0 ? "Brasil" :
        root.region-index == 1 ? "Portugal" :
        root.region-index == 2 ? "Angola" :
        root.region-index == 3 ? "Mocambique" : "Estados Unidos";
    property <string> language-label:
        root.language-index == 0 ? "Portugues (Brasil)" :
        root.language-index == 1 ? "Portugues (Portugal)" :
        root.language-index == 2 ? "English" :
        root.language-index == 3 ? "Francais" : "Espanol";

    callback continue-clicked(int, int);

    width: 320px;
    height: 240px;
    background: Theme.bg-0;

    Rectangle {
        x: 143px; y: 16px; width: 34px; height: 34px;
        border-radius: 11px;
        background: Theme.accent-tint;
        border-width: 1px;
        border-color: Theme.accent-deep;
        Image { x: 8px; y: 8px; width: 18px; height: 18px; source: @image-url("assets/icons/globe.svg"); image-fit: contain; colorize: Theme.accent; }
    }
    Text {
        x: 0px; y: 54px; width: 320px; height: 20px;
        text: "Idioma e Regiao";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    LocalePicker {
        x: 30px; y: 84px; width: 260px; height: 48px;
        title: "Regiao";
        value: root.region-label;
        icon: @image-url("assets/icons/globe.svg");
        clicked => { root.region-index = root.region-index == 4 ? 0 : root.region-index + 1; }
    }

    LocalePicker {
        x: 30px; y: 138px; width: 260px; height: 48px;
        title: "Idioma";
        value: root.language-label;
        icon: @image-url("assets/icons/message-circle.svg");
        clicked => { root.language-index = root.language-index == 4 ? 0 : root.language-index + 1; }
    }

    Rectangle {
        x: 30px; y: 194px; width: 260px; height: 36px;
        border-radius: Theme.radius-m;
        background: tc.pressed ? Theme.accent-hi : Theme.accent;
        tc := TouchArea { clicked => { root.continue-clicked(root.region-index, root.language-index); } }
        Text {
            text: "Continuar";
            color: Theme.bg-0;
            font-size: Theme.font-md;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
