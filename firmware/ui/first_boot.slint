import { Theme } from "theme.slint";

export component PasscodeSetup inherits Rectangle {
    in-out property <string> passcode: "";
    callback confirm(string);

    width: 320px;
    height: 240px;
    background: Theme.bg-0;

    Rectangle {
        x: 0px; y: 0px; width: 100%; height: 100%;
        background: Theme.bg-1;
    }

    Text {
        x: 0px; y: 18px; width: 100%; height: 22px;
        text: "Definir Senha";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 55px; y: 48px; width: 210px; height: 34px;
        text: "Crie uma senha para proteger\nseu DC Assistant.";
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    HorizontalLayout {
        x: 91px; y: 88px; width: 138px; height: 14px;
        spacing: 14px;
        for i in 5: Rectangle {
            width: 12px; height: 12px;
            border-radius: 6px;
            background: i < root.passcode.character-count ? Theme.accent-hi : #00000000;
            border-width: 1px;
            border-color: i < root.passcode.character-count ? Theme.accent-hi : Theme.text-muted;
        }
    }

    for row[index] in [[ "1","2","3","4","5" ], [ "6","7","8","9","0" ]] : HorizontalLayout {
        x: 50px; y: 116px + index * 40px; width: 220px; height: 32px;
        spacing: 8px;
        for k in row : Rectangle {
            width: 38px; height: 32px;
            border-radius: Theme.radius-s;
            background: Theme.tile;
            border-width: 1px;
            border-color: Theme.stroke;

            TouchArea {
                clicked => {
                    if (root.passcode.character-count < 5) {
                        root.passcode = root.passcode + k;
                    }
                }
            }

            Text {
                text: k;
                color: Theme.text-primary;
                font-size: Theme.font-lg;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    Rectangle {
        x: 218px; y: 200px; width: 52px; height: 32px;
        border-radius: Theme.radius-s;
        background: Theme.accent;
        TouchArea { clicked => { root.confirm(root.passcode); } }
        Text {
            text: "\u{2713}";
            color: Theme.text-primary;
            font-size: Theme.font-xl;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component RegionLanguage inherits Rectangle {
    in-out property <string> region:   "Brasil";
    in-out property <string> language: "Português (Brasil)";
    callback continue-clicked();

    width: 320px;
    height: 240px;
    background: Theme.bg-0;

    Text {
        x: 0px; y: 22px; width: 100%; height: 22px;
        text: "Selecione sua Região";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: 42px; y: 62px; width: 236px; height: 38px;
        border-radius: Theme.radius-m;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;

        Rectangle {
            x: 12px; y: 8px; width: 28px; height: 22px;
            border-radius: 4px;
            background: #159447;
            Text {
                text: "BR";
                color: #FFE15A;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            x: 52px; y: 0px; width: 145px; height: 100%;
            text: root.region;
            color: Theme.text-primary;
            font-size: Theme.font-md;
            vertical-alignment: center;
        }
        Text {
            x: parent.width - 26px; y: 0px; width: 18px; height: 100%;
            text: "\u{203A}";
            color: Theme.text-primary;
            font-size: Theme.font-xl;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 0px; y: 122px; width: 100%; height: 20px;
        text: "Selecione seu Idioma";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: 42px; y: 158px; width: 236px; height: 38px;
        border-radius: Theme.radius-m;
        background: Theme.tile;
        border-width: 1px;
        border-color: Theme.stroke;
        Text {
            x: 14px; y: 0px; width: 185px; height: 100%;
            text: root.language;
            color: Theme.text-primary;
            font-size: Theme.font-md;
            vertical-alignment: center;
        }
        Text {
            x: parent.width - 26px; y: 0px; width: 18px; height: 100%;
            text: "\u{203A}";
            color: Theme.text-primary;
            font-size: Theme.font-xl;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 42px; y: 210px; width: 236px; height: 28px;
        border-radius: Theme.radius-m;
        background: Theme.accent;
        TouchArea { clicked => { root.continue-clicked(); } }
        Text {
            text: "Continuar";
            color: Theme.text-primary;
            font-size: Theme.font-md;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
