import { Theme } from "theme.slint";

export component PasscodeSetup inherits Rectangle {
    in-out property <string> passcode: "";
    callback confirm(string);

    width: 320px;
    height: 240px;
    background: Theme.bg-0;

    Text {
        x: 0px; y: 16px; width: 100%; height: 20px;
        text: "Definir Senha";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 42px; y: 40px; width: 236px; height: 28px;
        text: "Crie uma senha para proteger\nseu DC Assistant.";
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    HorizontalLayout {
        x: 102px; y: 78px; width: 116px; height: 12px;
        spacing: 12px;
        for i in 4: Rectangle {
            width: 12px; height: 12px;
            border-radius: 6px;
            background: i < root.passcode.character-count ? Theme.accent : #00000000;
            border-width: 1px;
            border-color: i < root.passcode.character-count ? Theme.accent-hi : Theme.text-muted;
        }
    }

    for row[index] in [[ "1","2","3","4","5" ], [ "6","7","8","9","0" ]] : HorizontalLayout {
        x: 40px; y: 108px + index * 42px; width: 240px; height: 34px;
        spacing: 10px;
        for k in row : Rectangle {
            width: 40px; height: 34px;
            border-radius: Theme.radius-s;
            background: Theme.panel-soft;
            border-width: 1px;
            border-color: Theme.stroke;
            TouchArea {
                clicked => {
                    if (root.passcode.character-count < 4) {
                        root.passcode = root.passcode + k;
                    }
                }
            }
            Text {
                text: k;
                color: Theme.text-primary;
                font-size: Theme.font-lg;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    Rectangle {
        x: 220px; y: 198px; width: 54px; height: 32px;
        border-radius: Theme.radius-s;
        background: Theme.accent;
        TouchArea { clicked => { root.confirm(root.passcode); } }
        Image {
            x: 18px; y: 9px; width: 18px; height: 14px;
            source: @image-url("assets/icons/chevron-right.svg");
            image-fit: contain;
        }
    }
}

export component RegionLanguage inherits Rectangle {
    in-out property <string> region: "Brasil";
    in-out property <string> language: "Português (Brasil)";
    callback continue-clicked();

    width: 320px;
    height: 240px;
    background: Theme.bg-0;

    Text {
        x: 0px; y: 18px; width: 100%; height: 20px;
        text: "Selecione sua Região";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: 30px; y: 52px; width: 260px; height: 36px;
        border-radius: Theme.radius-s;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke;

        Rectangle {
            x: 12px; y: 8px; width: 22px; height: 20px;
            border-radius: 4px;
            background: #009B3A;
            Text {
                x: 0px; y: -1px; width: 100%; height: 100%;
                text: "◆";
                color: #FFDF00;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle {
                x: 8px; y: 7px; width: 6px; height: 6px;
                border-radius: 3px;
                background: #002776;
            }
        }
        Text {
            x: 46px; y: 0px; width: 180px; height: 100%;
            text: root.region;
            color: Theme.text-primary;
            font-size: Theme.font-md;
            vertical-alignment: center;
        }
        Image {
            x: 236px; y: 11px; width: 14px; height: 14px;
            source: @image-url("assets/icons/chevron-right.svg");
            image-fit: contain;
            opacity: 0.8;
        }
    }

    Text {
        x: 0px; y: 100px; width: 100%; height: 20px;
        text: "Selecione seu Idioma";
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: 30px; y: 126px; width: 260px; height: 36px;
        border-radius: Theme.radius-s;
        background: Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke;
        Text {
            x: 14px; y: 0px; width: 210px; height: 100%;
            text: root.language;
            color: Theme.text-primary;
            font-size: Theme.font-md;
            vertical-alignment: center;
        }
        Image {
            x: 236px; y: 11px; width: 14px; height: 14px;
            source: @image-url("assets/icons/chevron-right.svg");
            image-fit: contain;
            opacity: 0.8;
        }
    }

    Rectangle {
        x: 30px; y: 182px; width: 260px; height: 38px;
        border-radius: Theme.radius-s;
        background: Theme.accent;
        TouchArea { clicked => { root.continue-clicked(); } }
        Text {
            text: "Continuar";
            color: Theme.text-primary;
            font-size: Theme.font-md;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
