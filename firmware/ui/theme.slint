// theme.slint - DC OS visual tokens for the 320x240 display.
export global Theme {
    out property <color> bg-0:          #050914;
    out property <color> bg-1:          #080D1C;
    out property <color> bg-2:          #0D1426;
    out property <color> panel:         #11192D;
    out property <color> panel-hi:      #18223A;
    out property <color> tile:          #1A2540;
    out property <color> tile-hi:       #23304F;
    out property <color> stroke:        #33415F;

    out property <color> text-primary:   #F6F8FF;
    out property <color> text-secondary: #C6CDE5;
    out property <color> text-muted:     #7E89AA;

    out property <color> accent:         #7727E8;
    out property <color> accent-hi:      #9B35FF;
    out property <color> accent-2:       #00D5FF;
    out property <color> accent-blue:    #2B67FF;
    out property <color> accent-pink:    #FF2FD2;
    out property <color> success:        #27D980;
    out property <color> warning:        #FFC145;
    out property <color> danger:         #FF4F6D;

    out property <length> radius-s:  6px;
    out property <length> radius-m:  8px;
    out property <length> radius-l:  16px;

    out property <length> font-xs: 9px;
    out property <length> font-sm: 11px;
    out property <length> font-md: 13px;
    out property <length> font-lg: 17px;
    out property <length> font-xl: 23px;
}
