export global Theme {
    // Neutral surfaces
    out property <color> bg-0:           #0B0C0E;
    out property <color> bg-1:           #111316;
    out property <color> bg-2:           #171A1F;
    out property <color> panel:          #15181D;
    out property <color> panel-soft:     #1B1F26;
    out property <color> panel-elevated: #242A32;
    out property <color> stroke:         #343B45;
    out property <color> stroke-soft:    #262C35;

    // Text
    out property <color> text-primary:   #F6F3ED;
    out property <color> text-secondary: #B8B2A8;
    out property <color> text-muted:     #777E86;
    out property <color> text-dim:       #4E555F;

    // Brand accents
    out property <color> accent:         #6FA8DC;
    out property <color> accent-hi:      #9BC7EA;
    out property <color> accent-deep:    #223F59;
    out property <color> accent-cyan:    #80CBC4;
    out property <color> accent-blue:    #5B8DEF;
    out property <color> accent-pink:    #D98282;
    out property <color> accent-violet:  #8E7CC3;

    // States
    out property <color> success:        #6FBF73;
    out property <color> warning:        #D7A86E;
    out property <color> danger:         #D66A61;

    // Radius
    out property <length> radius-xs: 4px;
    out property <length> radius-s:  7px;
    out property <length> radius-m:  10px;
    out property <length> radius-lg: 14px;
    out property <length> radius-xl: 18px;

    // Type
    out property <length> font-xs: 9px;
    out property <length> font-sm: 11px;
    out property <length> font-md: 13px;
    out property <length> font-lg: 15px;
    out property <length> font-xl: 22px;
}
