// theme.slint — Design tokens do DC OS (dark, cyan + violeta).
export global Theme {
    // Base surfaces
    out property <color> bg-0:          #05060B;
    out property <color> bg-1:          #0B0E1A;
    out property <color> bg-2:          #121628;
    out property <color> surface:       #1A1F35;
    out property <color> surface-hi:    #232945;

    // Text
    out property <color> text-primary:   #F2F5FF;
    out property <color> text-secondary: #9AA3C7;
    out property <color> text-muted:     #5F678B;

    // Brand accents (radial DC OS palette)
    out property <color> accent:         #7C4DFF;   // violet
    out property <color> accent-2:       #00E5FF;   // cyan
    out property <color> accent-pink:    #FF3DBE;
    out property <color> success:        #22E39A;
    out property <color> warning:        #FFB020;
    out property <color> danger:         #FF4D6D;

    // Radii & spacing
    out property <length> radius-s:  6px;
    out property <length> radius-m:  12px;
    out property <length> radius-l:  20px;

    // Typography
    out property <length> font-xs: 10px;
    out property <length> font-sm: 12px;
    out property <length> font-md: 14px;
    out property <length> font-lg: 18px;
    out property <length> font-xl: 24px;
}
