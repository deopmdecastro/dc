// theme.slint — tokens visuais refinados para o DC OS 320x240.
export global Theme {
    // Fundos
    out property <color> bg-0:           #090B16;
    out property <color> bg-1:           #0E1222;
    out property <color> bg-2:           #141A31;
    out property <color> panel:          #151A2C;
    out property <color> panel-soft:     #1A2035;
    out property <color> panel-elevated: #202742;
    out property <color> stroke:         #2A3150;
    out property <color> stroke-soft:    #202745;

    // Texto
    out property <color> text-primary:   #FFFFFF;
    out property <color> text-secondary: #B2B8D5;
    out property <color> text-muted:     #6D7499;
    out property <color> text-dim:       #4B537A;

    // Acentos neon
    out property <color> accent:         #6C2BFF;
    out property <color> accent-hi:      #9155FF;
    out property <color> accent-deep:    #35117F;
    out property <color> accent-cyan:    #1FD6FF;
    out property <color> accent-blue:    #3C6CFF;
    out property <color> accent-pink:    #F032FF;
    out property <color> accent-violet:  #5020C8;

    // Estados
    out property <color> success:        #23DA81;
    out property <color> warning:        #FFC54C;
    out property <color> danger:         #FF5774;

    // Radius
    out property <length> radius-xs: 4px;
    out property <length> radius-s:  7px;
    out property <length> radius-m:  10px;
    out property <length> radius-lg: 14px;
    out property <length> radius-xl: 18px;

    // Tipografia
    out property <length> font-xs: 9px;
    out property <length> font-sm: 11px;
    out property <length> font-md: 13px;
    out property <length> font-lg: 15px;
    out property <length> font-xl: 22px;
}
