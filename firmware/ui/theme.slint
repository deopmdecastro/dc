// theme.slint — tokens visuais refinados para o DC OS 320x240.
// Paleta moderna: azul profundo + cyan neon, sem tons arroxeados.
export global Theme {
    // Fundos
    out property <color> bg-0:           #070A12;
    out property <color> bg-1:           #0C111C;
    out property <color> bg-2:           #121828;
    out property <color> panel:          #141B2E;
    out property <color> panel-soft:     #1A2238;
    out property <color> panel-elevated: #222C48;
    out property <color> stroke:         #2D3A5C;
    out property <color> stroke-soft:    #1F2840;

    // Texto
    out property <color> text-primary:   #FFFFFF;
    out property <color> text-secondary: #A8B0CC;
    out property <color> text-muted:     #6A7299;
    out property <color> text-dim:       #4A527A;

    // Acentos neon (azul + cyan, sem roxo)
    out property <color> accent:         #2D7FF9;
    out property <color> accent-hi:      #4D9BFF;
    out property <color> accent-deep:    #0D3B8C;
    out property <color> accent-cyan:    #00D9FF;
    out property <color> accent-blue:    #3C6CFF;
    out property <color> accent-pink:    #FF4D8D;
    out property <color> accent-violet:  #4060D0;

    // Estados
    out property <color> success:        #22C55E;
    out property <color> warning:        #FFB020;
    out property <color> danger:         #FF4757;

    // Radius
    out property <length> radius-xs: 4px;
    out property <length> radius-s:  7px;
    out property <length> radius-m:  10px;
    out property <length> radius-lg: 14px;
    out property <length> radius-xl: 18px;

    // Tipografia
    out property <length> font-xs: 9px;
    out property <length> font-sm: 11px;
    out property <length> font-md: 13px;
    out property <length> font-lg: 15px;
    out property <length> font-xl: 22px;
}
