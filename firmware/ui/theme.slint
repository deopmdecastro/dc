// =====================================================
// DC OS — DESIGN SYSTEM / TEMA
// Otimizado para o display 320x240 (ESP32-S3, software renderer).
//
// Paleta "Midnight Cyan": fundos profundos azul-petroleo, superficies
// em camadas para dar profundidade sem sombras (o renderer embarcado
// nao tem blur), e um accent ciano-azul vibrante que se le bem mesmo
// num painel IPS pequeno.
// =====================================================

export global Theme {
    // -------------------------------------------------
    // Fundos (do mais profundo ao mais claro)
    // -------------------------------------------------
    out property <color> bg-0:           #0A0E14;   // fundo base do ecra
    out property <color> bg-1:           #0F141C;   // header / status bar
    out property <color> bg-2:           #161C26;   // trilhas de slider, poços

    // -------------------------------------------------
    // Superficies / paineis (cartoes, linhas, botoes)
    // -------------------------------------------------
    out property <color> panel:          #141A24;
    out property <color> panel-soft:     #1B2230;
    out property <color> panel-elevated: #26303F;

    // -------------------------------------------------
    // Contornos
    // -------------------------------------------------
    out property <color> stroke:         #303B4E;
    out property <color> stroke-soft:    #212A38;

    // -------------------------------------------------
    // Texto
    // -------------------------------------------------
    out property <color> text-primary:   #F1F6FC;
    out property <color> text-secondary: #9FB0C6;
    out property <color> text-muted:     #64748B;
    out property <color> text-dim:       #46536A;

    // -------------------------------------------------
    // Accent (ciano-azul) + variacoes
    // -------------------------------------------------
    out property <color> accent:         #38BDF8;   // principal
    out property <color> accent-hi:      #7DD3FC;   // realce / hover
    out property <color> accent-deep:    #075985;   // fundo ativo escuro
    out property <color> accent-cyan:    #2DD4BF;   // teal secundario
    out property <color> accent-blue:    #4F8DF7;   // azul barra de progresso
    out property <color> accent-pink:    #F472B6;
    out property <color> accent-violet:  #A78BFA;

    // -------------------------------------------------
    // Estados
    // -------------------------------------------------
    out property <color> success:        #4ADE80;
    out property <color> warning:        #FBBF24;
    out property <color> danger:         #FB7185;

    // -------------------------------------------------
    // Superficies tonais (accent com pouca opacidade, pre-mescladas
    // sobre bg para o renderer software: evita alpha em tempo real)
    // -------------------------------------------------
    out property <color> accent-tint:    #12283A;   // ~accent sobre bg-0
    out property <color> success-tint:   #123122;
    out property <color> danger-tint:    #331A24;

    // -------------------------------------------------
    // Raio de canto
    // -------------------------------------------------
    out property <length> radius-xs: 5px;
    out property <length> radius-s:  8px;
    out property <length> radius-m:  12px;
    out property <length> radius-lg: 16px;
    out property <length> radius-xl: 22px;

    // -------------------------------------------------
    // Espacamento (grelha de 4px)
    // -------------------------------------------------
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;

    // -------------------------------------------------
    // Tipografia
    // -------------------------------------------------
    out property <length> font-xs: 9px;
    out property <length> font-sm: 11px;
    out property <length> font-md: 13px;
    out property <length> font-lg: 16px;
    out property <length> font-xl: 22px;
}
