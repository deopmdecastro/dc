import { Theme } from "theme.slint";

component AlarmToggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    callback changed(bool);

    border-radius: Theme.radius-m;
    background: Theme.panel-soft;
    border-width: 1px;
    border-color: root.checked ? Theme.accent-deep : Theme.stroke-soft;
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.changed(root.checked);
        }
    }
    Rectangle {
        x: 12px; y: 8px; width: 26px; height: 26px;
        border-radius: 8px;
        background: root.checked ? Theme.accent-deep : Theme.bg-2;
        Image {
            x: 6px; y: 6px; width: 14px; height: 14px;
            source: @image-url("assets/icons/bell.svg"); image-fit: contain;
            colorize: root.checked ? Theme.accent-hi : Theme.text-secondary;
        }
    }
    Text {
        x: 48px; y: 0px; width: 150px; height: 100%;
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        vertical-alignment: center;
    }
    Rectangle {
        x: 220px; y: 8px; width: 46px; height: 24px;
        border-radius: 12px;
        background: root.checked ? Theme.accent : Theme.bg-2;
        border-width: 1px;
        border-color: root.checked ? Theme.accent-hi : Theme.stroke;
        Rectangle {
            x: root.checked ? 24px : 3px; y: 3px; width: 18px; height: 18px;
            border-radius: 9px;
            background: root.checked ? Theme.bg-0 : Theme.text-secondary;
            animate x { duration: 150ms; easing: ease-out; }
        }
    }
}

export component AlarmPanel inherits Rectangle {
    in-out property <bool> enabled: false;
    in-out property <int> hour: 7;
    in-out property <int> minute: 0;

    property <string> hour-label: root.hour < 10 ? "0" + root.hour : "" + root.hour;
    property <string> minute-label: root.minute < 10 ? "0" + root.minute : "" + root.minute;

    callback back();
    callback alarm-changed(bool, int, int);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // Header
    Rectangle { x: 0px; y: 0px; width: 320px; height: 34px; background: Theme.bg-1; Rectangle { x: 0px; y: 33px; width: 320px; height: 1px; background: Theme.stroke-soft; } }
    Rectangle {
        x: 6px; y: 4px; width: 28px; height: 26px;
        border-radius: Theme.radius-s;
        background: bk.pressed ? Theme.panel-elevated : #00000000;
        bk := TouchArea { clicked => { root.back(); } }
        Image { x: 7px; y: 6px; width: 14px; height: 14px; source: @image-url("assets/icons/chevron-left.svg"); image-fit: contain; colorize: Theme.accent; }
    }
    Text {
        x: 0px; y: 0px; width: 320px; height: 34px;
        text: "Alarme";
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Display da hora
    Rectangle {
        x: 24px; y: 44px; width: 272px; height: 64px;
        border-radius: Theme.radius-m;
        background: root.enabled ? Theme.accent-tint : Theme.panel-soft;
        border-width: 1px;
        border-color: root.enabled ? Theme.accent-deep : Theme.stroke-soft;
        animate background { duration: 150ms; }
        Text {
            x: 0px; y: 8px; width: 100%; height: 38px;
            text: root.hour-label + ":" + root.minute-label;
            color: root.enabled ? Theme.accent-hi : Theme.text-primary;
            font-size: 34px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            x: 0px; y: 46px; width: 100%; height: 12px;
            text: root.enabled ? "Alarme ativo" : "Desligado";
            color: root.enabled ? Theme.success : Theme.text-muted;
            font-size: Theme.font-xs;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }

    AlarmToggle {
        x: 24px; y: 116px; width: 272px; height: 40px;
        label: "Ativar alarme";
        checked <=> root.enabled;
        changed(on) => {
            root.enabled = on;
            root.alarm-changed(root.enabled, root.hour, root.minute);
        }
    }

    // Ajustes hora/minuto
    for item[index] in [
        { label: "H -", kind: 0, primary: false },
        { label: "H +", kind: 1, primary: true },
        { label: "M -", kind: 2, primary: false },
        { label: "M +", kind: 3, primary: true },
    ] : Rectangle {
        x: 24px + index * 70px; y: 164px; width: 62px; height: 42px;
        border-radius: Theme.radius-m;
        background: it.pressed ? Theme.accent-hi : (item.primary ? Theme.accent-deep : Theme.panel-elevated);
        border-width: 1px;
        border-color: item.primary ? Theme.accent : Theme.stroke;
        it := TouchArea {
            clicked => {
                if (item.kind == 0) { root.hour = root.hour == 0 ? 23 : root.hour - 1; }
                if (item.kind == 1) { root.hour = root.hour == 23 ? 0 : root.hour + 1; }
                if (item.kind == 2) { root.minute = root.minute == 0 ? 55 : root.minute - 5; }
                if (item.kind == 3) { root.minute = root.minute == 55 ? 0 : root.minute + 5; }
                root.alarm-changed(root.enabled, root.hour, root.minute);
            }
        }
        Text {
            text: item.label;
            color: item.primary ? Theme.accent-hi : Theme.text-primary;
            font-size: Theme.font-sm;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
