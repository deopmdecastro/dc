import { Theme } from "theme.slint";

component AlarmToggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    callback changed(bool);

    border-radius: Theme.radius-m;
    background: Theme.panel-soft;
    border-width: 1px;
    border-color: root.checked ? Theme.accent-deep : Theme.stroke-soft;
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.changed(root.checked);
        }
    }
    Rectangle {
        x: 12px; y: 8px; width: 26px; height: 26px;
        border-radius: 8px;
        background: root.checked ? Theme.accent-deep : Theme.bg-2;
        Image {
            x: 6px; y: 6px; width: 14px; height: 14px;
            source: @image-url("assets/icons/bell.svg"); image-fit: contain;
            colorize: root.checked ? Theme.accent-hi : Theme.text-secondary;
        }
    }
    Text {
        x: 48px; y: 0px; width: 150px; height: 100%;
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        vertical-alignment: center;
    }
    Rectangle {
        x: 220px; y: 8px; width: 46px; height: 24px;
        border-radius: 12px;
        background: root.checked ? Theme.accent : Theme.bg-2;
        border-width: 1px;
        border-color: root.checked ? Theme.accent-hi : Theme.stroke;
        Rectangle {
            x: root.checked ? 24px : 3px; y: 3px; width: 18px; height: 18px;
            border-radius: 9px;
            background: root.checked ? Theme.bg-0 : Theme.text-secondary;
            animate x { duration: 150ms; easing: ease-out; }
        }
    }
}

export component AlarmPanel inherits Rectangle {
    in-out property <bool> enabled: false;
    in-out property <int> hour: 7;
    in-out property <int> minute: 0;
    in-out property <int> day-mode: 0;
    in-out property <int> tone-index: 0;
    in property <int> language-index: 0;

    property <string> hour-label: root.hour < 10 ? "0" + root.hour : "" + root.hour;
    property <string> minute-label: root.minute < 10 ? "0" + root.minute : "" + root.minute;
    property <string> day-label:
        root.day-mode == 0 ? (root.language-index == 2 ? "Every day" : root.language-index == 3 ? "Tous les jours" : root.language-index == 4 ? "Todos los dias" : "Todos os dias") :
        root.day-mode == 1 ? (root.language-index == 2 ? "Weekdays" : root.language-index == 3 ? "Jours ouvrables" : root.language-index == 4 ? "Dias laborables" : "Dias uteis") :
        root.day-mode == 2 ? (root.language-index == 2 ? "Weekend" : root.language-index == 3 ? "Week-end" : root.language-index == 4 ? "Fin de semana" : "Fim de semana") :
        (root.language-index == 2 ? "Once" : root.language-index == 3 ? "Une fois" : root.language-index == 4 ? "Una vez" : "Uma vez");
    property <string> tone-label:
        root.tone-index == 0 ? (root.language-index == 2 ? "Soft" : root.language-index == 3 ? "Doux" : root.language-index == 4 ? "Suave" : "Suave") :
        root.tone-index == 1 ? (root.language-index == 2 ? "Digital" : root.language-index == 3 ? "Digital" : root.language-index == 4 ? "Digital" : "Digital") :
        (root.language-index == 2 ? "Pulse" : root.language-index == 3 ? "Impulsion" : root.language-index == 4 ? "Pulso" : "Pulso");
    property <string> title:
        root.language-index == 2 ? "Alarm" :
        root.language-index == 3 ? "Alarme" :
        root.language-index == 4 ? "Alarma" : "Alarme";

    callback back();
    callback alarm-changed(bool, int, int, int, int);
    callback test-tone(int);

    width: 320px;
    height: 216px;
    background: Theme.bg-0;

    // Header
    Rectangle { x: 0px; y: 0px; width: 320px; height: 34px; background: Theme.bg-1; Rectangle { x: 0px; y: 33px; width: 320px; height: 1px; background: Theme.stroke-soft; } }
    Rectangle {
        x: 0px; y: 0px; width: 40px; height: 34px;
        border-radius: Theme.radius-s;
        background: bk.pressed ? Theme.panel-elevated : #00000000;
        bk := TouchArea { clicked => { root.back(); } }
        Image { x: 13px; y: 10px; width: 14px; height: 14px; source: @image-url("assets/icons/chevron-left.svg"); image-fit: contain; colorize: Theme.accent; }
    }
    Text {
        x: 0px; y: 0px; width: 320px; height: 34px;
        text: root.title;
        color: Theme.text-primary;
        font-size: Theme.font-md;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Display da hora
    Rectangle {
        x: 18px; y: 42px; width: 284px; height: 54px;
        border-radius: Theme.radius-m;
        background: root.enabled ? Theme.accent-tint : Theme.panel-soft;
        border-width: 1px;
        border-color: root.enabled ? Theme.accent-deep : Theme.stroke-soft;
        animate background { duration: 150ms; }
        Text {
            x: 0px; y: 5px; width: 100%; height: 32px;
            text: root.hour-label + ":" + root.minute-label;
            color: root.enabled ? Theme.accent-hi : Theme.text-primary;
            font-size: 30px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            x: 0px; y: 38px; width: 100%; height: 12px;
            text: root.enabled ? (root.language-index == 2 ? "Alarm on" : root.language-index == 3 ? "Alarme actif" : root.language-index == 4 ? "Alarma activa" : "Alarme ativo") : (root.language-index == 2 ? "Off" : root.language-index == 3 ? "Desactive" : root.language-index == 4 ? "Apagada" : "Desligado");
            color: root.enabled ? Theme.success : Theme.text-muted;
            font-size: Theme.font-xs;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }

    AlarmToggle {
        x: 18px; y: 102px; width: 284px; height: 38px;
        label: root.language-index == 2 ? "Enable alarm" : root.language-index == 3 ? "Activer l'alarme" : root.language-index == 4 ? "Activar alarma" : "Ativar alarme";
        checked <=> root.enabled;
        changed(on) => {
            root.enabled = on;
            root.alarm-changed(root.enabled, root.hour, root.minute, root.day-mode, root.tone-index);
        }
    }

    // Ajustes hora/minuto
    for item[index] in [
        { label: "H -", kind: 0, primary: false },
        { label: "H +", kind: 1, primary: true },
        { label: "M -", kind: 2, primary: false },
        { label: "M +", kind: 3, primary: true },
    ] : Rectangle {
        x: 18px + index * 73px; y: 146px; width: 64px; height: 28px;
        border-radius: Theme.radius-m;
        background: it.pressed ? Theme.accent-hi : (item.primary ? Theme.accent-deep : Theme.panel-elevated);
        border-width: 1px;
        border-color: item.primary ? Theme.accent : Theme.stroke;
        it := TouchArea {
            clicked => {
                if (item.kind == 0) { root.hour = root.hour == 0 ? 23 : root.hour - 1; }
                if (item.kind == 1) { root.hour = root.hour == 23 ? 0 : root.hour + 1; }
                if (item.kind == 2) { root.minute = root.minute == 0 ? 55 : root.minute - 5; }
                if (item.kind == 3) { root.minute = root.minute == 55 ? 0 : root.minute + 5; }
                root.alarm-changed(root.enabled, root.hour, root.minute, root.day-mode, root.tone-index);
            }
        }
        Text {
            text: item.label;
            color: item.primary ? Theme.accent-hi : Theme.text-primary;
            font-size: Theme.font-sm;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 18px; y: 180px; width: 132px; height: 28px;
        border-radius: Theme.radius-s;
        background: days.pressed ? Theme.panel-elevated : Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        days := TouchArea {
            clicked => {
                root.day-mode = root.day-mode == 3 ? 0 : root.day-mode + 1;
                root.alarm-changed(root.enabled, root.hour, root.minute, root.day-mode, root.tone-index);
            }
        }
        Text { x: 8px; y: 3px; width: 116px; height: 10px; text: root.language-index == 2 ? "Days" : root.language-index == 3 ? "Jours" : root.language-index == 4 ? "Dias" : "Dias"; color: Theme.text-muted; font-size: 8px; }
        Text { x: 8px; y: 13px; width: 116px; height: 12px; text: root.day-label; color: Theme.text-primary; font-size: 9px; font-weight: 700; overflow: elide; }
    }

    Rectangle {
        x: 156px; y: 180px; width: 90px; height: 28px;
        border-radius: Theme.radius-s;
        background: tone.pressed ? Theme.panel-elevated : Theme.panel-soft;
        border-width: 1px;
        border-color: Theme.stroke-soft;
        tone := TouchArea {
            clicked => {
                root.tone-index = root.tone-index == 2 ? 0 : root.tone-index + 1;
                root.alarm-changed(root.enabled, root.hour, root.minute, root.day-mode, root.tone-index);
            }
        }
        Text { x: 7px; y: 3px; width: 74px; height: 10px; text: root.language-index == 2 ? "Tone" : root.language-index == 3 ? "Sonnerie" : root.language-index == 4 ? "Tono" : "Toque"; color: Theme.text-muted; font-size: 8px; }
        Text { x: 7px; y: 13px; width: 74px; height: 12px; text: root.tone-label; color: Theme.text-primary; font-size: 9px; font-weight: 700; overflow: elide; }
    }

    Rectangle {
        x: 252px; y: 180px; width: 50px; height: 28px;
        border-radius: Theme.radius-s;
        background: test.pressed ? Theme.accent-hi : Theme.accent-deep;
        border-width: 1px;
        border-color: Theme.accent;
        test := TouchArea { clicked => { root.test-tone(root.tone-index); } }
        Text { text: root.language-index == 2 ? "Test" : root.language-index == 3 ? "Tester" : root.language-index == 4 ? "Probar" : "Testar"; color: Theme.accent-hi; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    }
}
